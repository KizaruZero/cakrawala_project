<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_service_planning_odometer_reminders" model="ir.cron">
            <field name="name">Service Planning: odometer &amp; interval reminder emails</field>
            <field name="model_id" ref="x_service_planning.model_service_planning"/>
            <field name="state">code</field>
            <field name="code">model.cron_send_odometer_reminders()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall">2025-01-01 16:00:00</field>
            <field name="priority">5</field>
            <field name="active">True</field>
        </record>

        <!-- System Parameters for dev/prod email control -->
        <record id="param_service_planning_test_mode" model="ir.config_parameter">
            <field name="key">service_planning.reminder.test_mode</field>
            <field name="value">1</field>
        </record>
        <record id="param_service_planning_test_email" model="ir.config_parameter">
            <field name="key">service_planning.reminder.test_email</field>
            <field name="value">suryazulfikar22@gmail.com</field>
        </record>
    </data>
</odoo>
