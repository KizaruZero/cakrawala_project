<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="email_template_service_planning_reminder" model="mail.template">
            <field name="name">Service Planning Reminder</field>
            <field name="model_id" ref="x_service_planning.model_service_planning"/>
            <field name="subject">Reminder: Service Kendaraan {{ object.vehicle_id.name }}</field>
            <field name="email_from">{{ (object.vehicle_id.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="lang">{{ user.lang }}</field>
            <field name="auto_delete" eval="False"/>
            <field name="body_html" type="html">
                <div>
                    <p>Yth. <t t-out="object.vehicle_id.manager_id.name or 'Manager'"/>,</p>
                    <br/>
                    <p>Terdapat kendaraan armada yang memerlukan perhatian terkait jadwal Service Planning. Berikut adalah rincian informasinya:</p>
                    <br/>
                    <ul>
                        <li><strong>Kendaraan:</strong> <t t-out="ctx.get('current_vehicle').name if ctx.get('current_vehicle') else '-'"/></li>
                        <li><strong>No. Polisi:</strong> <t t-out="object.license_plate or '-'"/></li>
                        <li><strong>No. Aset:</strong> <t t-out="object.asset_number or '-'"/></li>
                    </ul>
                    <br/>
                    <div style="padding: 10px; border-left: 4px solid #2E75B6; background-color: #F2F7FC; margin-bottom: 15px;">
                        <p style="margin-top: 0; margin-bottom: 5px;"><strong>Item Service yang Membutuhkan Perhatian:</strong></p>
                        <p style="margin-top: 0; margin-bottom: 5px; font-weight: bold; font-size: 14px; color: #1F3864;">
                            <t t-out="ctx.get('reminder_line').service_planning_id.name if ctx.get('reminder_line') else '-'"/>
                        </p>
                        <p style="margin-top: 5px; margin-bottom: 0;"><strong>Alasan:</strong></p>
                        <ul style="margin-top: 5px; margin-bottom: 0;">
                            <t t-if="ctx.get('reminder_reasons')">
                                <t t-foreach="ctx.get('reminder_reasons')" t-as="reason">
                                    <li><t t-out="reason"/></li>
                                </t>
                            </t>
                        </ul>
                    </div>
                    <br/>
                    <p>Mohon agar dapat segera memeriksa di dalam sistem dan menindaklanjuti proses penjadwalan service untuk kendaraan terkait.</p>
                    <br/>
                    <div style="text-align: left; margin: 16px 0;">
                        <a t-attf-href="{{ object.get_base_url() }}/web#id={{ object.id }}&amp;model=service.planning&amp;view_type=form" 
                           style="background-color: #2E75B6; color: #ffffff; padding: 8px 16px; text-decoration: none; border-radius: 4px; display: inline-block;">
                            Buka Service Planning
                        </a>
                    </div>
                    <br/>
                    <p>Terima kasih,<br/><strong>System Automated Notification</strong></p>
                </div>
            </field>
        </record>

        <record id="notification_template_service_planning_km" model="x.notification.template">
            <field name="name">Service Planning Odometer/Interval Reminder</field>
            <field name="notification_scope">service_planning_km</field>
            <field name="model_id" ref="x_service_planning.model_service_planning"/>
            <field name="mail_template_id" ref="email_template_service_planning_reminder"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
