<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_lot_form_inherit_vehicle" model="ir.ui.view">
        <field name="name">stock.lot.form.inherit.vehicle</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='main_group']" position="after">
                <group string="Vehicle Information" name="vehicle_info">
                    <field name="initial_license_plate"/>
                    <field name="chassis_number"/>
                    <field name="engine_number"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
