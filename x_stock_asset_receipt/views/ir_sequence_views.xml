<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sequence_view_inherit_company_code" model="ir.ui.view">
        <field name="name">ir.sequence.form.inherit.company.code</field>
        <field name="model">ir.sequence</field>
        <field name="inherit_id" ref="base.sequence_view"/>
        <field name="arch" type="xml">
            <xpath expr="//span[contains(text(), 'ISO 8601')]/.." position="inside">
                <span colspan="2">Company Code: %%(company_code)s</span>
            </xpath>
        </field>
    </record>
</odoo>
