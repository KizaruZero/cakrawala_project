<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_vehicle_substatus_tree" model="ir.ui.view">
        <field name="name">vehicle.substatus.list</field>
        <field name="model">vehicle.substatus</field>
        <field name="arch" type="xml">
            <list string="Master Sub Status" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="is_disposal"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_vehicle_substatus_form" model="ir.ui.view">
        <field name="name">vehicle.substatus.form</field>
        <field name="model">vehicle.substatus</field>
        <field name="arch" type="xml">
            <form string="Master Sub Status">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="is_disposal"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_vehicle_substatus_search" model="ir.ui.view">
        <field name="name">vehicle.substatus.search</field>
        <field name="model">vehicle.substatus</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <separator/>
                <filter string="Disposal-flagged" name="is_disposal" domain="[('is_disposal', '=', True)]"/>
            </search>
        </field>
    </record>

    <record id="action_vehicle_substatus" model="ir.actions.act_window">
        <field name="name">Master Sub Status</field>
        <field name="res_model">vehicle.substatus</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a fleet sub-status
            </p>
            <p>
                Goods receipt <strong>Rental type</strong> (Short-term / Long-term) is linked to the two default rows by system id;
                you can rename those rows but avoid deleting them. Mark <strong>Is disposal</strong> for statuses that qualify vehicles for disposal bidding.
            </p>
        </field>
    </record>

    <menuitem
        id="menu_vehicle_substatus"
        name="Master Sub Status"
        parent="fleet.fleet_configuration"
        action="action_vehicle_substatus"
        sequence="25"
        groups="fleet.fleet_group_manager"
    />
</odoo>
