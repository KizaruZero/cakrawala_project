<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_vehicle_substatus_tree" model="ir.ui.view">
        <field name="name">vehicle.substatus.list</field>
        <field name="model">vehicle.substatus</field>
        <field name="arch" type="xml">
            <list string="Master Sub Status" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="state_id"/>
                <field name="is_disposal"/>
                <field name="is_rental_type"/>
                <field name="is_replacement_car"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_vehicle_substatus_form" model="ir.ui.view">
        <field name="name">vehicle.substatus.form</field>
        <field name="model">vehicle.substatus</field>
        <field name="arch" type="xml">
            <form string="Master Sub Status">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="state_id"/>
                            <field name="is_disposal"/>
                            <field name="is_rental_type"/>
                            <field name="is_replacement_car"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_vehicle_substatus_search" model="ir.ui.view">
        <field name="name">vehicle.substatus.search</field>
        <field name="model">vehicle.substatus</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="state_id"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <separator/>
                <filter string="Disposal-flagged" name="is_disposal" domain="[('is_disposal', '=', True)]"/>
                <filter string="Fleet Sub-status" name="is_rental_type" domain="[('is_rental_type', '=', True)]"/>
                <filter string="Replacement Car" name="is_replacement_car" domain="[('is_replacement_car', '=', True)]"/>
                <group>
                    <filter string="Parent Status" name="group_state" context="{'group_by': 'state_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_vehicle_substatus" model="ir.actions.act_window">
        <field name="name">Master Sub Status</field>
        <field name="res_model">vehicle.substatus</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a fleet sub-status
            </p>
            <p>
                Mark <strong>Is fleet sub-status</strong> to make a sub-status selectable as <strong>Fleet Sub-status</strong> on a Goods Receipt;
                the value picked there becomes the vehicle Fleet Sub-Status on asset registration.
                Mark <strong>Is disposal</strong> for statuses that qualify vehicles for disposal bidding.
                Mark <strong>Is Replacement Car</strong> for the sub-status of units available as replacement car.
            </p>
        </field>
    </record>

    <menuitem id="menu_fleet_master" name="Master" parent="fleet.fleet_configuration" sequence="50"/>

    <record id="fleet.fleet_menu_config_activity_type" model="ir.ui.menu">
        <field name="sequence">5</field>
    </record>

    <menuitem
        id="menu_vehicle_substatus"
        name="Sub Status"
        parent="menu_fleet_master"
        action="action_vehicle_substatus"
        sequence="10"
        groups="fleet.fleet_group_manager"
    />
</odoo>
