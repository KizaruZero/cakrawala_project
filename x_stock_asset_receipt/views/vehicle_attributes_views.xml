<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_vehicle_color_tree" model="ir.ui.view">
        <field name="name">vehicle.color.list</field>
        <field name="model">vehicle.color</field>
        <field name="arch" type="xml">
            <list string="Vehicle Color" editable="bottom">
                <field name="name"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="action_vehicle_color" model="ir.actions.act_window">
        <field name="name">Vehicle Colors</field>
        <field name="res_model">vehicle.color</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new vehicle color
            </p>
        </field>
    </record>

    <record id="view_vehicle_year_tree" model="ir.ui.view">
        <field name="name">vehicle.year.list</field>
        <field name="model">vehicle.year</field>
        <field name="arch" type="xml">
            <list string="Vehicle Year" editable="bottom">
                <field name="name"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="action_vehicle_year" model="ir.actions.act_window">
        <field name="name">Vehicle Years</field>
        <field name="res_model">vehicle.year</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new vehicle year
            </p>
        </field>
    </record>

    <menuitem id="menu_vehicle_color" 
              name="Colors" 
              parent="fleet.fleet_configuration" 
              action="action_vehicle_color" 
              sequence="20"/>

    <menuitem id="menu_vehicle_year" 
              name="Years" 
              parent="fleet.fleet_configuration" 
              action="action_vehicle_year" 
              sequence="21"/>
</odoo>
