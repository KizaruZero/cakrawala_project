<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fleet_vehicle_form_inherit_asset" model="ir.ui.view">
        <field name="name">fleet.vehicle.form.inherit.asset</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_form"/>
        <field name="arch" type="xml">
        
            <xpath expr="//group[field[@name='driver_id']]" position="attributes">
                <attribute name="string">General Information</attribute>
            </xpath>

            <xpath expr="//field[@name='driver_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='mobility_card']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='future_driver_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='next_assignation_date']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//group[field[@name='driver_id']]" position="inside">
                <field name="fleet_sub_status_id"/>
                <field name="asset_type" invisible="1"/>
                <field name="asset_number" readonly="1"/>
                <field name="unit_classification"/>
                <field name="assignment_date" string="Assignment Date"/>
                <field name="initial_license_plate" readonly="1"/>
                <field name="company_id" readonly="1" force_save="1"/>
                <field name="fleet_number_locked" invisible="1"/>
                <field name="lot_id" readonly="fleet_number_locked"
                       string="Serial Number (Stock Lot)"
                       options="{'no_create': True}"/>
                <field name="fleet_number_pending" invisible="not fleet_number_pending"
                       widget="boolean" readonly="1"/>
            </xpath>

            <xpath expr="//group[field[@name='category_id']]" position="inside">
                <field name="chassis_number" string="Chassis Number"/>
                <field name="engine_number"/>
            </xpath>
            
            <xpath expr="//field[@name='vin_sn']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            
            <xpath expr="//field[@name='category_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='order_date']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

        </field>
    </record>

    <record id="view_fleet_vehicle_search_inherit_fleet_number" model="ir.ui.view">
        <field name="name">fleet.vehicle.search.inherit.fleet.number</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="asset_number" string="Fleet Number"/>
                <filter name="fleet_number_pending" string="Fleet Number Not Linked"
                        domain="[('fleet_number_pending', '=', True)]"/>
            </xpath>
        </field>
    </record>
</odoo>

