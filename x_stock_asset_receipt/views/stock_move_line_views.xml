<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_move_line_operation_tree_inherit_vehicle" model="ir.ui.view">
        <field name="name">stock.move.line.operations.list.inherit.vehicle</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_operation_tree"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='tracking']" position="after">
                <field name="is_vehicle" column_invisible="1"/>
                <field name="fleet_brand_id" column_invisible="1"/>
                <field name="analytic_account_domain_ids" column_invisible="1"/>
            </xpath>

            <xpath expr="//field[@name='lot_id']" position="attributes">
                <attribute name="string">Fleet Number</attribute>
                <attribute name="readonly">parent.is_fleet_source_locked</attribute>
            </xpath>
            <xpath expr="//field[@name='quant_id']" position="attributes">
                <attribute name="readonly">parent.is_fleet_source_locked</attribute>
            </xpath>
            <xpath expr="//field[@name='lot_name']" position="attributes">
                <attribute name="string">Fleet Number</attribute>
            </xpath>

            <xpath expr="//field[@name='lot_id']" position="after">
                <field name="initial_license_plate"
                       string="Initial License Plate"
                       readonly="parent.picking_code != 'incoming'"
                       optional="show"/>
                <field name="chassis_number"
                       string="Chassis Number"
                       readonly="parent.picking_code != 'incoming'"
                       optional="show"/>
                <field name="engine_number"
                       string="Engine Number"
                       readonly="parent.picking_code != 'incoming'"
                       optional="show"/>
                <field name="vehicle_model_id"
                       string="Model"
                       readonly="parent.picking_code != 'incoming'"
                       domain="[('brand_id', '=', fleet_brand_id)] if fleet_brand_id else []"
                       optional="show"/>
                <field name="vehicle_year_id"
                       string="Tahun"
                       readonly="parent.picking_code != 'incoming'"
                       optional="show"/>
                <field name="vehicle_color_id"
                       string="Warna"
                       readonly="parent.picking_code != 'incoming'"
                       optional="show"/>
                <field name="analytic_account_id"
                       string="Analytic Account"
                       readonly="parent.picking_code != 'incoming' or parent.is_po_fleet_receipt"
                       domain="[('id', 'in', analytic_account_domain_ids)] if is_vehicle else []"
                       column_invisible="parent.is_po_fleet_receipt and parent.state != 'done'"
                       optional="show"/>
            </xpath>

            <!-- Quantity editable on PO fleet receipts and on outgoing transfers before completion -->
            <xpath expr="//field[@name='quantity']" position="attributes">
                <attribute name="readonly">(parent.picking_code == 'incoming' and not parent.is_po_fleet_receipt) or parent.state in ['done', 'cancel']</attribute>
            </xpath>
            <xpath expr="//field[@name='quantity']" position="before">
                <button name="action_generate_serial_number_line"
                        string="Generate"
                        type="object"
                        class="btn-link"
                        icon="fa-plus-square"
                        invisible="tracking != 'serial' or lot_id or parent.state in ['done', 'cancel']"/>
            </xpath>

        </field>
    </record>

    <record id="view_stock_move_line_detailed_operation_tree_inherit_source_lock" model="ir.ui.view">
        <field name="name">stock.move.line.detailed.operations.list.inherit.source.lock</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_detailed_operation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='quant_id']" position="before">
                <field name="is_fleet_source_locked" column_invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='quant_id']" position="attributes">
                <attribute name="readonly">(state in ('done', 'cancel') and is_locked) or is_fleet_source_locked</attribute>
            </xpath>
            <xpath expr="//field[@name='lot_id']" position="attributes">
                <attribute name="readonly">(state in ('done', 'cancel') and is_locked) or is_fleet_source_locked</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_picking_form_inherit_source_lock" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.source.lock</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='move_ids']//list//field[@name='lot_ids']" position="before">
                <field name="is_fleet_source_locked" column_invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='move_ids']//list//field[@name='lot_ids']" position="attributes">
                <attribute name="readonly">is_fleet_source_locked</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_stock_move_operations_inherit_asset" model="ir.ui.view">
        <field name="name">stock.move.operations.form.inherit.asset</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_stock_move_operations"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='picking_code']" position="after">
                <field name="is_po_fleet_receipt" invisible="1"/>
                <field name="is_fleet_source_locked" invisible="1"/>
            </xpath>
            <xpath expr="//widget[@name='generate_serials']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//widget[@name='generate_serials']" position="after">
                <button name="action_mass_generate_fn" string="Mass Generate FN" type="object" class="btn-primary" invisible="state in ['done', 'cancel']"/>
            </xpath>
            <xpath expr="//widget[@name='import_lots']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="stock_move_line_view_search_inherit_license_plate" model="ir.ui.view">
        <field name="name">stock.move.line.search.inherit.license.plate</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.stock_move_line_view_search"/>
        <field name="arch" type="xml">
            <field name="lot_id" position="after">
                <field name="initial_license_plate"/>
            </field>
            <group name="groupby" position="inside">
                <filter string="Initial License Plate" name="by_initial_license_plate"
                        context="{'group_by': 'initial_license_plate'}"/>
            </group>
        </field>
    </record>
</odoo>
