<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Inherit: stock.view_stock_move_line_operation_tree
        Tampil di popup "Detailed Operations" saat user klik "Details" per baris produk
        Tambah: Initial License Plate, Chassis Number, Engine Number, tombol Generate SN per baris
    -->
    <record id="view_stock_move_line_operation_tree_inherit_vehicle" model="ir.ui.view">
        <field name="name">stock.move.line.operations.list.inherit.vehicle</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_operation_tree"/>
        <field name="arch" type="xml">

            <!-- Tambah field is_vehicle sebagai invisible helper -->
            <xpath expr="//field[@name='tracking']" position="after">
                <field name="is_vehicle" column_invisible="1"/>
            </xpath>

            <!-- Tambah kolom kendaraan setelah kolom lot_id -->
            <xpath expr="//field[@name='lot_id']" position="after">
                <field name="initial_license_plate"
                       string="Initial License Plate"
                       column_invisible="not parent.picking_code == 'incoming'"
                       optional="show"/>
                <field name="chassis_number"
                       string="Chassis Number"
                       column_invisible="not parent.picking_code == 'incoming'"
                       optional="show"/>
                <field name="engine_number"
                       string="Engine Number"
                       column_invisible="not parent.picking_code == 'incoming'"
                       optional="show"/>
                <field name="vehicle_year_id"
                       string="Tahun"
                       column_invisible="not parent.picking_code == 'incoming'"
                       optional="show"/>
                <field name="vehicle_color_id"
                       string="Warna"
                       column_invisible="not parent.picking_code == 'incoming'"
                       optional="show"/>
            </xpath>

            <!-- Tambah tombol Generate SN per baris, setelah quantity -->
            <xpath expr="//field[@name='quantity']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>
            <xpath expr="//field[@name='quantity']" position="before">
                <button name="action_generate_serial_number_line"
                        string="Generate SN"
                        type="object"
                        class="btn-link"
                        icon="fa-plus-square"
                        invisible="tracking != 'serial' or lot_id or parent.state in ['done', 'cancel']"/>
            </xpath>

        </field>
    </record>
</odoo>
