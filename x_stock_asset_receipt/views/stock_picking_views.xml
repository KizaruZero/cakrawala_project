<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_inherit_asset" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.asset</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">

            <!-- Rental Type di header form -->
            <xpath expr="//field[@name='origin']" position="after">
                <field name="rental_type"/>
            </xpath>

            <!-- 
                Tambah field kendaraan (READ-ONLY) ke tabel move_ids
                Ini hanya tampilan ringkasan dari move_line pertama
            -->
            <xpath expr="//field[@name='move_ids']//field[@name='product_id']" position="after">
                <field name="is_replace" optional="show"/>
                <field name="initial_license_plate" optional="show" readonly="1" widget="text"/>
                <field name="chassis_number" optional="show" readonly="1" widget="text"/>
                <field name="engine_number" optional="show" readonly="1" widget="text"/>
            </xpath>

            <!-- Center align Demand and Quantity fields -->
            <xpath expr="//field[@name='move_ids']//field[@name='product_uom_qty']" position="attributes">
                <attribute name="class">text-center align-middle v-align-middle</attribute>
            </xpath>
            <xpath expr="//field[@name='move_ids']//field[@name='quantity']" position="attributes">
                <attribute name="class">text-center align-middle v-align-middle</attribute>
            </xpath>

            <!-- Register Asset Detail Button di header, visible setelah GR Done -->
            <xpath expr="//header" position="inside">
                <button name="action_register_asset_detail"
                        string="Register Asset Detail"
                        type="object"
                        class="oe_highlight"
                        invisible="state != 'done' or picking_type_code != 'incoming'"/>
            </xpath>

            <!-- Tampilkan kolom lot_ids -->
            <xpath expr="//field[@name='move_ids']//field[@name='lot_ids']" position="attributes">
                <attribute name="optional">show</attribute>
                <attribute name="invisible">has_tracking == 'none'</attribute>
            </xpath>

        </field>
    </record>
</odoo>