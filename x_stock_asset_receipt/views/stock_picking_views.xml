<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_inherit_asset" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.asset</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='origin']" position="after">
                <field name="is_bastk_linked" invisible="1"/>
                <field name="rental_type_id"
                       options="{'no_create': True, 'no_open': True}"
                       invisible="not has_vehicle_product or is_bastk_linked"
                       required="has_vehicle_product and picking_type_code == 'incoming' and not is_bastk_linked"/>
                <field name="is_asset_registered" invisible="1"/>
                <field name="has_vehicle_product" invisible="1"/>
            </xpath>

            <xpath expr="//field[@name='move_ids']//field[@name='product_id']" position="after">
                <field name="is_replace" column_invisible="1"/>
                <field name="display_vehicle_year" readonly="1" string="Tahun"/>
                <field name="display_vehicle_color" readonly="1" string="Warna"/>
                <field name="display_license_plate" readonly="1" string="Initial License Plate"/>
                <field name="display_chassis_number" readonly="1" string="Chassis Number"/>
                <field name="display_engine_number" readonly="1" string="Engine Number"/>

            </xpath>

            <xpath expr="//field[@name='move_ids']//field[@name='product_uom_qty']" position="attributes">
                <attribute name="class">text-center align-middle v-align-middle</attribute>
            </xpath>
            <xpath expr="//field[@name='move_ids']//field[@name='quantity']" position="attributes">
                <attribute name="class">text-center align-middle v-align-middle</attribute>
            </xpath>

            <xpath expr="//header" position="inside">
                <field name="is_from_sales_order" invisible="1"/>
                <button name="action_register_asset_detail"
                        string="Register Fleet Detail"
                        type="object"
                        class="oe_highlight"
                        invisible="state != 'done' or picking_type_code != 'incoming' or is_asset_registered or not has_vehicle_product or is_from_sales_order"/>
                <button name="action_mass_generate_fn"
                        string="Mass Generate FN"
                        type="object"
                        class="btn-secondary"
                        invisible="state not in ['assigned', 'draft'] or picking_type_code != 'incoming' or not has_vehicle_product"/>
            </xpath>

            <xpath expr="//field[@name='move_ids']//field[@name='lot_ids']" position="attributes">
                <attribute name="optional">show</attribute>
                <attribute name="invisible">has_tracking == 'none'</attribute>
                <attribute name="string">Fleet Number</attribute>
            </xpath>

        </field>
    </record>

    <!-- Contextual Action Menu (Cog / Settings ⚙️ icon) -->
    <record id="action_server_export_fn_excel" model="ir.actions.server">
        <field name="name">Export Excel FN</field>
        <field name="model_id" ref="stock.model_stock_picking"/>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_view_types">form</field>
        <field name="state">code</field>
        <field name="code">
action = record.action_export_fn_excel()
        </field>
    </record>

    <record id="action_server_import_fn_excel" model="ir.actions.server">
        <field name="name">Import Excel FN</field>
        <field name="model_id" ref="stock.model_stock_picking"/>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_view_types">form</field>
        <field name="state">code</field>
        <field name="code">
action = record.action_open_import_fn_wizard()
        </field>
    </record>
</odoo>