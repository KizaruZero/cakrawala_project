<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Add standard states for Fleet -->
        <record id="fleet_state_leased" model="fleet.vehicle.state">
            <field name="name">Leased</field>
            <field name="sequence">10</field>
        </record>
        
        <record id="fleet_state_non_leased" model="fleet.vehicle.state">
            <field name="name">Non-Leased</field>
            <field name="sequence">20</field>
        </record>
        
        <record id="fleet_state_inactive" model="fleet.vehicle.state">
            <field name="name">Inactive</field>
            <field name="sequence">30</field>
        </record>

        <!-- Cleanup unwanted states -->
        <function model="fleet.vehicle.state" name="search">
            <value eval="[('name', 'in', ['New Request', 'To Order', 'Registered', 'Downgraded'])]"/>
        </function>
        <function model="fleet.vehicle.state" name="unlink">
            <value model="fleet.vehicle.state" eval="obj().search([('name', 'in', ['New Request', 'To Order', 'Registered', 'Downgraded'])]).ids"/>
        </function>
    </data>
</odoo>
