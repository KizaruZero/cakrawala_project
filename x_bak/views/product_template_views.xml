<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_product_template_form_inherit_bak" model="ir.ui.view">
        <field name="name">product.template.form.inherit.bak</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='name']" position="after">
                <field name="is_on_risk"
                       widget="boolean_toggle"
                       string="On Risk (Insurance)"
                       help="Aktifkan jika produk ini adalah produk On Risk untuk BAK. Hanya 1 produk yang boleh aktif."/>
            </xpath>
        </field>
    </record>

    <record id="view_product_template_list_inherit_bak" model="ir.ui.view">
        <field name="name">product.template.list.inherit.bak</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="is_on_risk" string="On Risk" optional="show"/>
            </xpath>
        </field>
    </record>

</odoo>
