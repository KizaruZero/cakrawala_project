<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fleet_spk_form_inherit_bak" model="ir.ui.view">
        <field name="name">fleet.spk.form.inherit.bak</field>
        <field name="model">fleet.spk</field>
        <field name="inherit_id" ref="x_spk.fleet_spk_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='reference_ticket_number']" position="after">
                <field name="bak_reference_id" readonly="state != 'new'"/>
            </xpath>
        </field>
    </record>
</odoo>
