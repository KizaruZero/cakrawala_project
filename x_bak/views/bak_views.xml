<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_bak" model="ir.actions.act_window">
        <field name="name">BAK</field>
        <field name="res_model">bak</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="bak_menu_root" name="BAK" parent="fleet.menu_root" sequence="110"/>
    <menuitem id="bak_menu_operations" name="Operations" parent="bak_menu_root" sequence="10"/>
    <menuitem id="bak_menu_bak" name="BAK" action="action_bak" parent="bak_menu_operations" sequence="1"/>

    <menuitem id="bak_menu_fleet" name="Fleet" parent="bak_menu_operations" sequence="2"/>
    <menuitem id="bak_menu_vehicle" name="Vehicles" action="fleet.fleet_vehicle_action" parent="bak_menu_fleet" sequence="1"/>

    <record id="view_bak_list" model="ir.ui.view">
        <field name="name">bak.list</field>
        <field name="model">bak</field>
        <field name="arch" type="xml">
            <list string="Berita Acara Kejadian" default_order="id desc">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="vehicle_model_id"/>
                <field name="vehicle_id"/>
                <field name="pic_client_name" optional="show"/>
                <field name="pic_client_phone" optional="show"/>
                <field name="state" widget="badge"
                    decoration-info="state == 'draft'"
                    decoration-warning="state == 'confirm'"
                    decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>

    <record id="view_bak_form" model="ir.ui.view">
        <field name="name">bak.form</field>
        <field name="model">bak</field>
        <field name="arch" type="xml">
            <form string="Berita Acara Kejadian">
                <field name="active" invisible="1"/>
                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirm,done,close"
                           options="{'clickable': false}"/>

                    <button name="action_confirm"
                            type="object"
                            string="Confirm"
                            class="btn-primary"
                            invisible="state != 'draft'"/>

                    <button name="action_create_invoice"
                            type="object"
                            string="Create Invoice"
                            class="btn-primary"
                            invisible="state != 'confirm'"
                            groups="x_bak.group_create_invoice_bak"/>

                    <button name="action_close"
                            type="object"
                            string="Close"
                            class="btn-danger"
                            invisible="state != 'confirm'"
                            groups="x_bak.group_create_invoice_bak"/>

                    <button name="action_create_spk"
                            type="object"
                            string="Create SPK"
                            invisible="state != 'confirm'"/>

                    <button name="%(x_bak.action_report_bak)d"
                            type="action"
                            string="Print Out"
                            class="btn-secondary"
                            icon="fa-print"/>
                </header>

                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_spk"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-wrench">
                            <field name="spk_count" widget="statinfo" string="SPK"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="bak_category_id" string="BAK Category"
                                   readonly="state in ('confirm', 'done', 'close')"/>
                            <field name="partner_id"
                                   readonly="state in ('confirm', 'done', 'close')"/>
                            <field name="pic_client_name"
                                   readonly="state in ('confirm', 'done', 'close')"/>
                            <field name="pic_client_phone"
                                   readonly="state in ('confirm', 'done', 'close')"/>
                            <field name="driver_name"
                                   readonly="state in ('confirm', 'done', 'close')"/>
                            <field name="address"
                                   readonly="state in ('confirm', 'done', 'close')"/>
                            <field name="phone"
                                   readonly="state in ('confirm', 'done', 'close')"/>
                            <field name="currency_id"
                                   readonly="state in ('confirm', 'done', 'close')"/>
                            <field name="cost" widget="monetary" options="{'currency_field': 'currency_id'}"
                                   readonly="state in ('confirm', 'done', 'close')"/>
                        </group>
                        <group>
                            <field name="vehicle_model_id"/>
                            <field name="vehicle_id"
                                   readonly="state in ('confirm', 'done', 'close')"/>
                            <field name="year"/>
                            <field name="last_odometer" widget="integer"
                                   readonly="state in ('confirm', 'done', 'close')"/>
                            <field name="ticket_number" invisible="1" readonly="1"/>
                            <field name="invoice_id" readonly="1"/>
                            <field name="repair_cost_estimate"
                                   widget="monetary"
                                   options="{'currency_field': 'currency_id'}"
                                   readonly="state in ('confirm', 'done', 'close')"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Detail" name="detail">
                            <field name="incident_line_ids" mode="list" string="Tanggal Kejadian"
                                   readonly="state in ('confirm', 'done', 'close')">
                                <list editable="bottom"
                                      create="state == 'draft'"
                                      delete="state == 'draft'">
                                    <field name="incident_date"/>
                                    <field name="location"/>
                                    <field name="chronology"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Enter internal notes here..."
                                   readonly="state in ('confirm', 'done', 'close')"/>
                        </page>
                    </notebook>

                    <group>
                        <field name="damage_line_ids"
                               mode="list"
                               nolabel="1"
                               colspan="2"
                               readonly="state in ('confirm', 'done', 'close')">
                            <list editable="bottom"
                                  create="state == 'draft'"
                                  delete="state == 'draft'">
                                <field name="damage"/>
                                <field name="attachment" filename="attachment_name" widget="binary"/>
                                <field name="attachment_name" column_invisible="True"/>
                            </list>
                        </field>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_move_form_inherit_bak" model="ir.ui.view">
        <field name="name">account.move.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_reference']" position="after">
                <field name="bak_id"/>
            </xpath>
        </field>
    </record>

</odoo>
