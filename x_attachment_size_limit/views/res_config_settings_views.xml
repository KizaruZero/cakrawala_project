<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_attachment_size_limit" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.attachment.size.limit</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <block name="integration" position="before">
                <block title="Attachment" name="attachment_size_limit_container">
                    <setting id="attachment_max_size_mb"
                             help="File yang lebih besar dari batas ini akan ditolak saat diupload. User perlu me-refresh halaman agar batas baru berlaku di browser.">
                        <field name="attachment_max_size_mb"/>
                        <span class="ms-1">MB</span>
                    </setting>
                </block>
            </block>
        </field>
    </record>
</odoo>
