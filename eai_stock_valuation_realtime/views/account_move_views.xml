<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_eai_rt" model="ir.ui.view">
        <field name="name">account.move.form.eai.rt</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <group name="misc_group" position="inside">
                <field name="eai_rt_stock_move_id" invisible="not eai_rt_stock_move_id"/>
            </group>
        </field>
    </record>

    <record id="view_move_line_tree_eai_rt" model="ir.ui.view">
        <field name="name">account.move.line.list.eai.rt</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_tree"/>
        <field name="arch" type="xml">
            <field name="product_id" position="after">
                <field name="eai_rt_origin_ref" optional="hide"/>
                <field name="eai_rt_role" optional="hide"/>
                <field name="eai_rt_warehouse_id" optional="hide"/>
            </field>
        </field>
    </record>
</odoo>
