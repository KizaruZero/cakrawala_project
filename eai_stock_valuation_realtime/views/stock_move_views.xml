<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_eai_rt" model="ir.ui.view">
        <field name="name">stock.picking.form.eai.rt</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_eai_rt_view_entries" type="object" class="oe_stat_button"
                        icon="fa-book" invisible="not eai_rt_account_move_count"
                        groups="account.group_account_readonly">
                    <field name="eai_rt_account_move_count" widget="statinfo" string="Jurnal Valuasi"/>
                </button>
            </div>
        </field>
    </record>

    <record id="view_move_form_eai_rt" model="ir.ui.view">
        <field name="name">stock.move.form.eai.rt</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_move_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_eai_rt_view_entries" type="object" class="oe_stat_button"
                        icon="fa-book" invisible="not eai_rt_account_move_count"
                        groups="account.group_account_readonly">
                    <field name="eai_rt_account_move_count" widget="statinfo" string="Jurnal Valuasi"/>
                </button>
            </div>
        </field>
    </record>
</odoo>
