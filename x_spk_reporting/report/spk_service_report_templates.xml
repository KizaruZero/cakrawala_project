<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="paperformat_spk_service_report_landscape" model="report.paperformat">
    <field name="name">SPK Service Report Landscape</field>
    <field name="default" eval="False"/>
    <field name="format">A4</field>
    <field name="orientation">Landscape</field>
    <field name="margin_top">10</field>
    <field name="margin_bottom">8</field>
    <field name="margin_left">8</field>
    <field name="margin_right">8</field>
    <field name="header_line" eval="False"/>
    <field name="header_spacing">6</field>
    <field name="dpi">90</field>
  </record>

  <template id="report_spk_service_report_document">
    <t t-call="web.html_container">
      <t t-set="company" t-value="docs and docs[0].env.company"/>
      <t t-set="o" t-value="docs[:1]"/>
      <t t-set="doc" t-value="docs[:1]"/>
      <t t-set="groups" t-value="docs._get_print_groups()"/>
      <t t-set="totals" t-value="docs._get_print_totals()"/>
      <div class="page" style="font-family: Arial, Helvetica, sans-serif; color: #1e293b; margin: 0; padding: 0;">
          <style>
            .report-header-table {
              width: 100%;
              border-collapse: collapse;
              margin-bottom: 12px;
              border-bottom: 2px solid #1e3a8a;
              padding-bottom: 8px;
            }
            .report-header-table td {
              border: none;
              padding: 0;
              vertical-align: top;
            }
            .company-title {
              font-size: 13px;
              font-weight: bold;
              color: #0f172a;
              margin-bottom: 2px;
            }
            .company-address {
              font-size: 8px;
              color: #475569;
              line-height: 1.35;
            }
            .report-title-main {
              font-size: 16px;
              font-weight: bold;
              color: #1e3a8a;
              letter-spacing: 0.5px;
              text-align: right;
              line-height: 1.2;
            }
            .report-subtitle {
              font-size: 8px;
              color: #64748b;
              text-align: right;
              margin-top: 4px;
            }
            table.spk-service-report {
              width: 100%;
              border-collapse: collapse;
              table-layout: fixed;
              margin: 0;
              padding: 0;
              font-size: 8px;
              line-height: 1.25;
            }
            table.spk-service-report th,
            table.spk-service-report td {
              border: 1px solid #cbd5e1;
              padding: 4px 4px;
              vertical-align: middle;
              word-wrap: break-word;
              overflow-wrap: break-word;
            }
            table.spk-service-report thead th {
              font-weight: 600;
              text-align: center;
              white-space: normal;
            }
            table.spk-service-report thead tr.header-cat th {
              font-size: 8px;
              font-weight: bold;
              padding: 4px;
              color: #ffffff;
            }
            table.spk-service-report thead tr.header-cols th {
              background-color: #f8fafc;
              color: #334155;
              font-size: 7.5px;
              padding: 4px 2px;
            }
            table.spk-service-report thead tr.header-cols th.col-highlight {
              background-color: #e0e7ff;
              color: #1e40af;
              font-weight: bold;
            }
            table.spk-service-report tbody td {
              font-size: 8px;
              color: #1e293b;
            }
            table.spk-service-report tbody td.col-highlight {
              background-color: #f8faff;
              color: #1e40af;
              font-weight: 600;
            }
            table.spk-service-report tfoot tr td {
              background-color: #f1f5f9;
              font-weight: bold;
              border-top: 2px solid #475569;
              border-bottom: 2px solid #475569;
              font-size: 8px;
              padding: 4px 2px;
            }
            table.spk-service-report tfoot tr td.col-highlight {
              background-color: #e0e7ff;
              color: #1e40af;
            }
            table.spk-service-report .text-right {
              text-align: right;
            }
            table.spk-service-report .text-center {
              text-align: center;
            }
            table.spk-service-report .text-left {
              text-align: left;
            }
            table.spk-service-report .spk-num {
              font-weight: 600;
              color: #0f172a;
            }
            table.spk-service-report .vendor-txt {
              color: #64748b;
              font-size: 7.5px;
            }
            table.spk-service-report .plate-txt {
              font-weight: 600;
              color: #0f172a;
            }
            table.spk-service-report .vehicle-txt {
              color: #64748b;
              font-size: 7.5px;
            }
          </style>

          <!-- Clean Corporate Header -->
          <table class="report-header-table">
            <tr>
              <td style="width: 55%;">
                <img t-if="company and company.logo" t-att-src="image_data_uri(company.logo)" style="max-height: 42px; max-width: 150px; margin-bottom: 4px;" alt="Logo"/>
                <div class="company-title" t-esc="company.name or ''"/>
                <div class="company-address">
                  <t t-if="company.street"><t t-esc="company.street"/>, </t>
                  <t t-if="company.street2"><t t-esc="company.street2"/>, </t>
                  <t t-if="company.city"><t t-esc="company.city"/> </t>
                  <t t-if="company.zip"><t t-esc="company.zip"/></t>
                  <t t-if="company.phone"><br/>Telp: <t t-esc="company.phone"/></t>
                  <t t-if="company.email"> | Email: <t t-esc="company.email"/></t>
                </div>
              </td>
              <td style="width: 45%;">
                <div class="report-title-main">LAPORAN SPK SERVICE</div>
                <div class="report-subtitle">
                  Tanggal Cetak: <span t-esc="time.strftime('%d/%m/%Y %H:%M')"/>
                </div>
              </td>
            </tr>
          </table>

          <!-- Main Table with Grouped Headers -->
          <table class="spk-service-report">
            <thead>
              <tr class="header-cat">
                <th colspan="5" style="background-color: #1e293b;">INFORMASI SPK &amp; KENDARAAN</th>
                <th colspan="7" style="background-color: #1e3a8a;">RINGKASAN TOTAL BIAYA (RP.)</th>
                <th colspan="4" style="background-color: #334155;">RINCIAN BARIS ITEM / JASA</th>
              </tr>
              <tr class="header-cols">
                <th style="width: 5%;">Tgl SPK</th>
                <th style="width: 9.5%;">No SPK &amp; Bengkel</th>
                <th style="width: 9%;">Kendaraan</th>
                <th style="width: 3.5%;">KM</th>
                <th style="width: 8%;">Keterangan</th>
                <th style="width: 6.5%;" class="text-right">Sparepart</th>
                <th style="width: 6.5%;" class="text-right">Jasa</th>
                <th style="width: 7.5%;" class="text-right col-highlight">Total Keseluruhan</th>
                <th style="width: 6%;" class="text-right">Own Risk</th>
                <th style="width: 5%;" class="text-right">PPN</th>
                <th style="width: 6.5%;" class="text-right">Total SPK</th>
                <th style="width: 6%;" class="text-right">Invoice</th>
                <th style="width: 9%;">Nama Produk / Jasa</th>
                <th style="width: 3%;" class="text-right">Qty</th>
                <th style="width: 4.5%;" class="text-right">Harga Satuan</th>
                <th style="width: 4.5%;" class="text-right">Jumlah</th>
              </tr>
            </thead>
            <tbody>
              <t t-foreach="groups" t-as="group">
                <t t-set="spk" t-value="group['record']"/>
                <tr t-foreach="group['lines']" t-as="line">
                  <td t-if="line_index == 0" t-att-rowspan="group['rowspan']" class="text-center">
                    <span t-esc="docs._format_report_date(spk.spk_date)"/>
                  </td>
                  <td t-if="line_index == 0" t-att-rowspan="group['rowspan']">
                    <div class="spk-num" t-esc="spk.spk_number or '-'"/>
                    <div class="vendor-txt" t-esc="spk.vendor_name or '-'"/>
                  </td>
                  <td t-if="line_index == 0" t-att-rowspan="group['rowspan']">
                    <div class="plate-txt" t-esc="spk.license_plate or '-'"/>
                    <div class="vehicle-txt" t-if="spk.vehicle_id" t-esc="spk.vehicle_id.model_id.name if spk.vehicle_id.model_id else spk.vehicle_id.name"/>
                  </td>
                  <td t-if="line_index == 0" t-att-rowspan="group['rowspan']" class="text-center">
                    <span t-esc="docs._format_report_number(spk.odometer)"/>
                  </td>
                  <td t-if="line_index == 0" t-att-rowspan="group['rowspan']">
                    <span style="color: #475569;" t-esc="spk.description or '-'"/>
                  </td>
                  <td t-if="line_index == 0" t-att-rowspan="group['rowspan']" class="text-right">
                    <span t-esc="docs._format_report_number(group['sparepart_total'])"/>
                  </td>
                  <td t-if="line_index == 0" t-att-rowspan="group['rowspan']" class="text-right">
                    <span t-esc="docs._format_report_number(group['service_total'])"/>
                  </td>
                  <td t-if="line_index == 0" t-att-rowspan="group['rowspan']" class="text-right col-highlight">
                    <span t-esc="docs._format_report_number(group['total_keseluruhan'])"/>
                  </td>
                  <td t-if="line_index == 0" t-att-rowspan="group['rowspan']" class="text-right">
                    <span t-esc="docs._format_report_number(group['on_risk_total'])"/>
                  </td>
                  <td t-if="line_index == 0" t-att-rowspan="group['rowspan']" class="text-right">
                    <span t-esc="docs._format_report_number(group['ppn_total'])"/>
                  </td>
                  <td t-if="line_index == 0" t-att-rowspan="group['rowspan']" class="text-right">
                    <span t-esc="docs._format_report_number(group['grand_total'])"/>
                  </td>
                  <td t-if="line_index == 0" t-att-rowspan="group['rowspan']" class="text-right">
                    <div t-esc="docs._format_report_number(spk.total_invoice_amount)"/>
                    <div t-if="spk.paid_date" style="font-size: 7px; color: #15803d; font-weight: 600;">
                      Lunas: <span t-esc="docs._format_report_date(spk.paid_date)"/>
                    </div>
                  </td>
                  <td>
                    <span t-esc="line.product_id.display_name if line.product_id else (line.product_name or '-')"/>
                  </td>
                  <td class="text-right">
                    <span t-esc="docs._format_report_number(line.quantity)"/>
                  </td>
                  <td class="text-right">
                    <span t-esc="docs._format_report_number(line.unit_price)"/>
                  </td>
                  <td class="text-right">
                    <span t-esc="docs._format_report_number(line.total)"/>
                  </td>
                </tr>
              </t>
            </tbody>
            <tfoot>
              <tr>
                <td colspan="5" class="text-right">TOTAL:</td>
                <td class="text-right"><strong t-esc="docs._format_report_number(totals['sparepart_total'])"/></td>
                <td class="text-right"><strong t-esc="docs._format_report_number(totals['service_total'])"/></td>
                <td class="text-right col-highlight"><strong t-esc="docs._format_report_number(totals['total_keseluruhan'])"/></td>
                <td class="text-right"><strong t-esc="docs._format_report_number(totals['on_risk_total'])"/></td>
                <td class="text-right"><strong t-esc="docs._format_report_number(totals['ppn_total'])"/></td>
                <td class="text-right"><strong t-esc="docs._format_report_number(totals['grand_total'])"/></td>
                <td class="text-right"><strong t-esc="docs._format_report_number(totals['total_invoice'])"/></td>
                <td/>
                <td class="text-right"><strong t-esc="docs._format_report_number(totals['quantity'])"/></td>
                <td/>
                <td class="text-right"><strong t-esc="docs._format_report_number(totals['line_amount'])"/></td>
              </tr>
            </tfoot>
          </table>
        </div>
    </t>
  </template>

  <record id="action_report_spk_service_report" model="ir.actions.report">
    <field name="name">SPK Service Report</field>
    <field name="model">spk.service.report.line</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">x_spk_reporting.report_spk_service_report_document</field>
    <field name="report_file">x_spk_reporting.report_spk_service_report_document</field>
    <field name="paperformat_id" ref="paperformat_spk_service_report_landscape"/>
    <field name="print_report_name">'SPK Service Report'</field>
    <field name="binding_model_id" ref="model_spk_service_report_line"/>
    <field name="binding_type">report</field>
  </record>
</odoo>
