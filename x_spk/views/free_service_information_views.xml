<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <!-- Master Data Free Service Item Views -->
    <record id="free_service_item_view_tree" model="ir.ui.view">
      <field name="name">free.service.item.tree</field>
      <field name="model">free.service.item</field>
      <field name="arch" type="xml">
        <list>
          <field name="name"/>
          <field name="product_id"/>
          <field name="duration"/>
          <field name="unit_of_time"/>
          <field name="description"/>
        </list>
      </field>
    </record>

    <record id="free_service_item_view_form" model="ir.ui.view">
      <field name="name">free.service.item.form</field>
      <field name="model">free.service.item</field>
      <field name="arch" type="xml">
        <form string="Free Service Item">
          <sheet>
            <group>
              <group>
                <field name="name"/>
                <field name="product_id"/>
              </group>
              <group>
                <label for="duration" string="Default Duration"/>
                <div class="o_row">
                  <field name="duration" class="oe_inline"/>
                  <field name="unit_of_time" class="oe_inline"/>
                </div>
              </group>
            </group>
            <group>
              <field name="description"/>
            </group>
          </sheet>
        </form>
      </field>
    </record>

    <record id="free_service_item_action" model="ir.actions.act_window">
      <field name="name">Free Service Items</field>
      <field name="res_model">free.service.item</field>
      <field name="view_mode">list,form</field>
    </record>

    <!-- Vehicle Free Service Tab Inherit -->
    <record id="fleet_vehicle_form_free_service_inherit" model="ir.ui.view">
      <field name="name">fleet.vehicle.form.free.service.inherit</field>
      <field name="model">fleet.vehicle</field>
      <field name="inherit_id" ref="fleet.fleet_vehicle_view_form"/>
      <field name="arch" type="xml">
        <xpath expr="//form/sheet/notebook" position="inside">
          <page string="Free Service Information" name="free_service_information">
            <field name="free_service_ids">
              <list editable="bottom">
                <field name="free_service_item_id"/>
                <field name="product_id"/>
                <field name="description"/>
                <field name="valid_from"/>
                <field name="duration" string="Duration"/>
                <field name="unit_of_time" string="Unit of Time"/>
                <field name="valid_until" readonly="1"/>
              </list>
            </field>
          </page>
        </xpath>
      </field>
    </record>

    <!-- SPK Free Service Tab Inherit -->
    <record id="fleet_spk_form_free_service_inherit" model="ir.ui.view">
      <field name="name">fleet.spk.form.free.service.inherit</field>
      <field name="model">fleet.spk</field>
      <field name="inherit_id" ref="x_spk.fleet_spk_form"/>
      <field name="arch" type="xml">
        <xpath expr="//form/sheet/notebook" position="inside">
          <page string="Free Service Information" name="spk_free_service_information">
            <field name="free_service_info_ids" readonly="1">
              <list create="false" edit="false" delete="false">
                <field name="free_service_item_id"/>
                <field name="product_id"/>
                <field name="description"/>
                <field name="valid_from"/>
                <field name="duration" string="Duration"/>
                <field name="unit_of_time" string="Unit of Time"/>
                <field name="valid_until"/>
              </list>
            </field>
          </page>
        </xpath>
      </field>
    </record>
  </data>
</odoo>
