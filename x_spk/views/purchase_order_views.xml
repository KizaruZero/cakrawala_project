<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_fleet_spk" model="ir.ui.view">
        <field name="name">purchase.order.form.fleet.spk</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field name="fleet_spk_id" readonly="1" invisible="not fleet_spk_id"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/list//field[@name='product_id']" position="after">
                <field name="fleet_spk_id"
                       string="SPK Ref"
                       optional="show"
                       readonly="1"
                       column_invisible="not parent.fleet_spk_id"/>
            </xpath>
        </field>
    </record>
</odoo>
