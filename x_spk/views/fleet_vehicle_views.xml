<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <record id="fleet_vehicle_form_inherit" model="ir.ui.view">
      <field name="name">fleet.vehicle.form.inherit</field>
      <field name="model">fleet.vehicle</field>
      <field name="inherit_id" ref="fleet.fleet_vehicle_view_form"/>
      <field name="arch" type="xml">
        <xpath expr="//div[@name='button_box']" position="inside">
          <button name="%(fleet_spk_action)d" type="action" class="oe_stat_button" icon="fa-wrench" context="{'search_default_vehicle_id': id, 'default_vehicle_id': id}">
            <field name="spk_count" widget="statinfo" string="SPK"/>
          </button>
        </xpath>
         <xpath expr="//field[@name='tag_ids']" position="attributes">
          <attribute name="invisible">1</attribute>
        </xpath>
        <xpath expr="//field[@name='transmission']" position="attributes">
          <attribute name="invisible">1</attribute>
        </xpath>
        <xpath expr="//field[@name='trailer_hook']" position="attributes">
          <attribute name="invisible">1</attribute>
        </xpath>
        <xpath expr="//label[@for='power']" position="attributes">
          <attribute name="invisible">1</attribute>
        </xpath>
        <xpath expr="//field[@name='power']/.." position="attributes">
          <attribute name="invisible">1</attribute>
        </xpath>
        <xpath expr="//label[@for='horsepower']" position="attributes">
          <attribute name="invisible">1</attribute>
        </xpath>
        <xpath expr="//field[@name='horsepower']/.." position="attributes">
          <attribute name="invisible">1</attribute>
        </xpath>
        <xpath expr="//field[@name='co2_standard']" position="attributes">
          <attribute name="invisible">1</attribute>
        </xpath>
        <xpath expr="//field[@name='model_year']" position="after">
          <field name="construction_year"/>
        </xpath>
        <xpath expr="//group[@name='group_model']" position="inside">
          <field name="drive_train_category_id" string="Vehicle Drive Train Category"/>
        </xpath>
        <xpath expr="//field[@name='fuel_type']" position="before">
          <field name="cc"/>
          <field name="engine_category_id"/>
        </xpath>
        <xpath expr="//field[@name='fuel_type']" position="after">
          <field name="transmission_id" string="Transmission"/>
          <field name="construction_year"/>
        </xpath>
        <xpath expr="//page[@name='page_model']/group[1]" position="after">
          <group string="Additional Specs">
            <group>
              <field name="motor_number"/>
              <field name="cc"/>
              <field name="engine_category_id"/>
              <field name="drive_train_category_id"/>
            </group>
            <group>
              <field name="construction_year"/>
              <field name="gps"/>
              <field name="spare_key"/>
              <field name="spare_key_location"/>
            </group>
          </group>
        </xpath>
        <xpath expr="//form/sheet/notebook" position="inside">
          <page string="Tyre History" name="tyre_history">
            <separator string="Tyre History"/>
            <field name="tyre_history_ids" readonly="1">
              <list>
                <field name="product_description"/>
                <field name="spk_number"/>
                <field name="date"/>
                <field name="old_production_number"/>
                <field name="new_production_number"/>
                <field name="notes"/>
              </list>
            </field>
            <separator string="Tyre Reference"/>
            <field name="tyre_reference_ids">
              <list editable="bottom">
                <field name="product_tmpl_id"/>
                <field name="initial_production_number"/>
                <field name="notes"/>
              </list>
            </field>
          </page>
          <page string="ACCU History" name="aki_history">
            <separator string="ACCU History"/>
            <field name="aki_history_ids" readonly="1">
              <list>
                <field name="product_description"/>
                <field name="spk_number"/>
                <field name="date"/>
                <field name="old_AKI_code" string="Old ACCU Code"/>
                <field name="new_AKI_code" string="New ACCU Code"/>
                <field name="notes"/>
              </list>
            </field>
            <separator string="ACCU Reference"/>
            <field name="aki_reference_ids">
              <list editable="bottom">
                <field name="product_tmpl_id"/>
                <field name="initial_aki_code"/>
                <field name="notes"/>
              </list>
            </field>
          </page>
          <page string="Current Tyres &amp; ACCU" name="current_tyre_aki" invisible="1">
            <separator string="Current Tyres"/>
            <field name="tyre_ids">
              <list editable="bottom">
                <field name="production_number"/>
                <field name="product_description"/>
                <field name="product_id"/>
                <field name="date"/>
                <field name="notes"/>
              </list>
            </field>
            <separator string="Current ACCUs"/>
            <field name="aki_ids">
              <list editable="bottom">
                <field name="aki_code"/>
                <field name="product_description"/>
                <field name="product_id"/>
                <field name="date"/>
                <field name="notes"/>
              </list>
            </field>
          </page>
        </xpath>
      </field>
    </record>
  </data>
</odoo>