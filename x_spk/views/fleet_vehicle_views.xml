<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <record id="fleet_vehicle_form_inherit" model="ir.ui.view">
      <field name="name">fleet.vehicle.form.inherit</field>
      <field name="model">fleet.vehicle</field>
      <field name="inherit_id" ref="fleet.fleet_vehicle_view_form"/>
      <field name="arch" type="xml">
        <xpath expr="//div[@name='button_box']" position="inside">
          <button name="%(fleet_spk_action)d" type="action" class="oe_stat_button" icon="fa-wrench" context="{'search_default_vehicle_id': id, 'default_vehicle_id': id}">
            <field name="spk_count" widget="statinfo" string="SPK"/>
          </button>
        </xpath>
         <xpath expr="//field[@name='tag_ids']" position="attributes">
          <attribute name="invisible">1</attribute>
        </xpath>
        <xpath expr="//field[@name='transmission']" position="attributes">
          <attribute name="invisible">1</attribute>
        </xpath>
        <xpath expr="//field[@name='trailer_hook']" position="attributes">
          <attribute name="invisible">1</attribute>
        </xpath>
        <xpath expr="//label[@for='power']" position="attributes">
          <attribute name="invisible">1</attribute>
        </xpath>
        <xpath expr="//field[@name='power']/.." position="attributes">
          <attribute name="invisible">1</attribute>
        </xpath>
        <xpath expr="//label[@for='horsepower']" position="attributes">
          <attribute name="invisible">1</attribute>
        </xpath>
        <xpath expr="//field[@name='horsepower']/.." position="attributes">
          <attribute name="invisible">1</attribute>
        </xpath>
        <xpath expr="//field[@name='co2_standard']" position="attributes">
          <attribute name="invisible">1</attribute>
        </xpath>
        <xpath expr="//field[@name='model_year']" position="after">
          <field name="construction_year"/>
        </xpath>
        <xpath expr="//group[@name='group_model']" position="inside">
          <field name="drive_train_category_id" string="Vehicle Drive Train Category"/>
        </xpath>
        <xpath expr="//field[@name='fuel_type']" position="before">
          <field name="cc"/>
          <field name="engine_category_id"/>
        </xpath>
        <xpath expr="//field[@name='fuel_type']" position="after">
          <field name="transmission_id" string="Transmission"/>
        </xpath>
        <xpath expr="//page[@name='page_model']/group[1]" position="after">
          <group string="Additional Specs">
            <group>
              <field name="gps"/>
              <field name="spare_key"/>
              <field name="spare_key_location"/>
            </group>
            <group/>
          </group>
        </xpath>
        <xpath expr="//form/sheet/notebook" position="inside">
          <page string="Tyre History" name="tyre_history">
            <separator string="Tyre History"/>
            <field name="tyre_history_ids" readonly="1">
              <list>
                <field name="product_description"/>
                <field name="spk_number"/>
                <field name="date"/>
                <field name="old_production_number"/>
                <field name="new_production_number"/>
                <field name="notes"/>
              </list>
            </field>
            <separator string="Tyre Reference"/>
            <field name="tyre_reference_ids">
              <list editable="bottom">
                <field name="product_tmpl_id"/>
                <field name="initial_production_number"/>
                <field name="notes"/>
              </list>
            </field>
          </page>
          <page string="ACCU History" name="aki_history">
            <separator string="ACCU History"/>
            <field name="aki_history_ids" readonly="1">
              <list>
                <field name="product_description"/>
                <field name="spk_number"/>
                <field name="date"/>
                <field name="old_AKI_code" string="Old ACCU Code"/>
                <field name="new_AKI_code" string="New ACCU Code"/>
                <field name="notes"/>
              </list>
            </field>
            <separator string="ACCU Reference"/>
            <field name="aki_reference_ids">
              <list editable="bottom">
                <field name="product_tmpl_id"/>
                <field name="initial_aki_code"/>
                <field name="notes"/>
              </list>
            </field>
          </page>
          <page string="Current Tyres &amp; ACCU" name="current_tyre_aki" invisible="1">
            <separator string="Current Tyres"/>
            <field name="tyre_ids">
              <list editable="bottom">
                <field name="production_number"/>
                <field name="product_description"/>
                <field name="product_id"/>
                <field name="date"/>
                <field name="notes"/>
              </list>
            </field>
            <separator string="Current ACCUs"/>
            <field name="aki_ids">
              <list editable="bottom">
                <field name="aki_code"/>
                <field name="product_description"/>
                <field name="product_id"/>
                <field name="date"/>
                <field name="notes"/>
              </list>
            </field>
          </page>
        </xpath>
      </field>
    </record>

    <!-- Final layout of the vehicle form. High priority so it runs after the
         extensions from x_stock_asset_receipt, x_fleet_document, x_bastk_management
         and x_replacement_car, whose fields it reorders. Mandatory fields are
         enforced here (not on the model) so vehicles created from receipts keep working. -->
    <record id="fleet_vehicle_form_layout" model="ir.ui.view">
      <field name="name">fleet.vehicle.form.layout</field>
      <field name="model">fleet.vehicle</field>
      <field name="inherit_id" ref="fleet.fleet_vehicle_view_form"/>
      <field name="priority">99</field>
      <field name="arch" type="xml">
        <!-- General Information: Fleet Number on top -->
        <xpath expr="//field[@name='asset_type_id']" position="before">
          <field name="asset_number" position="move"/>
          <field name="fleet_sub_status_id" position="move"/>
          <field name="sub_type_id" position="move"/>
        </xpath>
        <xpath expr="//field[@name='asset_number']" position="attributes">
          <attribute name="string">Fleet Number</attribute>
        </xpath>
        <xpath expr="//field[@name='fleet_sub_status_id']" position="attributes">
          <attribute name="required">1</attribute>
        </xpath>
        <xpath expr="//field[@name='asset_type_id']" position="attributes">
          <attribute name="required">1</attribute>
        </xpath>
        <xpath expr="//group[field[@name='driver_id']]/field[@name='company_id'][1]" position="attributes">
          <attribute name="invisible">1</attribute>
        </xpath>
        <xpath expr="//field[@name='unit_classification']" position="attributes">
          <attribute name="invisible">1</attribute>
        </xpath>
        <xpath expr="//field[@name='assignment_date']" position="attributes">
          <attribute name="invisible">1</attribute>
        </xpath>

        <!-- Vehicle -->
        <xpath expr="//field[@name='acquisition_date']" position="attributes">
          <attribute name="required">1</attribute>
        </xpath>
        <xpath expr="//field[@name='write_off_date']" position="attributes">
          <attribute name="invisible">1</attribute>
        </xpath>
        <xpath expr="//field[@name='manager_id']" position="attributes">
          <attribute name="invisible">1</attribute>
        </xpath>
        <xpath expr="//field[@name='location']" position="attributes">
          <attribute name="invisible">1</attribute>
        </xpath>
        <xpath expr="//label[@for='plan_to_change_car']" position="attributes">
          <attribute name="invisible">1</attribute>
        </xpath>
        <xpath expr="//field[@name='plan_to_change_car']" position="attributes">
          <attribute name="invisible">1</attribute>
        </xpath>
        <xpath expr="//label[@for='plan_to_change_bike']" position="attributes">
          <attribute name="invisible">1</attribute>
        </xpath>
        <xpath expr="//field[@name='plan_to_change_bike']" position="attributes">
          <attribute name="invisible">1</attribute>
        </xpath>
        <xpath expr="//field[@name='chassis_number']" position="attributes">
          <attribute name="required">1</attribute>
        </xpath>
        <xpath expr="//field[@name='engine_number']" position="attributes">
          <attribute name="required">1</attribute>
        </xpath>
        <xpath expr="//field[@name='engine_number']" position="after">
          <field name="motor_number"/>
        </xpath>

        <!-- Tabs -->
        <xpath expr="//page[@name='note']" position="after">
          <page name="license_plate_history" position="move"/>
        </xpath>
        <xpath expr="//page[@name='page_tax_info']" position="attributes">
          <attribute name="invisible">1</attribute>
        </xpath>
        <xpath expr="//field[@name='model_year']" position="attributes">
          <attribute name="required">1</attribute>
        </xpath>
        <xpath expr="//field[@name='doors']" position="attributes">
          <attribute name="invisible">1</attribute>
        </xpath>
        <xpath expr="//field[@name='color']" position="attributes">
          <attribute name="required">1</attribute>
        </xpath>
        <xpath expr="//field[@name='fuel_type']" position="attributes">
          <attribute name="required">1</attribute>
        </xpath>
        <xpath expr="//label[@for='co2']" position="attributes">
          <attribute name="invisible">1</attribute>
        </xpath>
        <xpath expr="//field[@name='co2']/.." position="attributes">
          <attribute name="invisible">1</attribute>
        </xpath>
      </field>
    </record>
  </data>
</odoo>