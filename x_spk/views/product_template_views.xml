<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <!-- Product Template Form Extension -->
    <record id="product_template_form_inherit_x_spk" model="ir.ui.view">
      <field name="name">product.template.form.inherit.x_spk</field>
      <field name="model">product.template</field>
      <field name="inherit_id" ref="product.product_template_form_view"/>
      <field name="arch" type="xml">
        <xpath expr="//page[@name='general_information']//group/group[1]" position="inside">
          <separator string="SPK"/>
          <field name="is_tyre"/>
          <field name="is_aki"/>
          <field name="is_on_risk"/>
          <field name="spk_category"/>
          <field name="type" invisible="1"/>
          <field name="kode_sparepart" invisible="type == 'service'"/>
          <field name="kategori_pekerjaan_id" invisible="type != 'service'"/>
          <field name="kategori_sparepart_id" invisible="type == 'service'"/>
        </xpath>
      </field>
    </record>

    <!-- Product Template Search View Extension -->
    <record id="product_template_search_inherit_x_spk" model="ir.ui.view">
      <field name="name">product.template.search.inherit.x_spk</field>
      <field name="model">product.template</field>
      <field name="inherit_id" ref="product.product_template_search_view"/>
      <field name="arch" type="xml">
        <xpath expr="//search" position="inside">

          <filter name="is_tyre" string="Tyre" domain="[('is_tyre', '=', True)]"/>

          <filter name="is_aki" string="ACCU (Battery)" domain="[('is_aki', '=', True)]"/>

          <filter name="is_on_risk" string="Own Risk" domain="[('is_on_risk', '=', True)]"/>

          <separator/>

          <filter name="group_by_spk_category" string="Group by SPK Category" context="{'group_by':'spk_category'}"/>

          <filter name="group_by_is_tyre" string="Group by Tyre Flag" context="{'group_by':'is_tyre'}"/>

          <filter name="group_by_is_aki" string="Group by ACCU Flag" context="{'group_by':'is_aki'}"/>

        </xpath>
      </field>
    </record>
  </data>
</odoo>
