<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_spk_invoice" model="ir.ui.view">
        <field name="name">account.move.form.inherit.spk.invoice</field>
        <field name="model">account.move</field>
        <field name="priority">100</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <field name="fleet_spk_id" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']//list//field[@name='product_id']" position="attributes">
                <attribute name="readonly">parent.fleet_spk_id</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']//list//field[@name='name']" position="after">
                <field name="item_type" column_invisible="parent.move_type not in ('in_invoice', 'in_refund') and not parent.fleet_spk_id" readonly="1" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
