<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fleet_spk_form_inherit_invoice" model="ir.ui.view">
        <field name="name">fleet.spk.form.inherit.invoice</field>
        <field name="model">fleet.spk</field>
        <field name="inherit_id" ref="x_spk.fleet_spk_form"/>
        <field name="arch" type="xml">
            <!-- Create Invoice button, visible from approved onwards -->
            <xpath expr="//button[@name='action_print_out']" position="before">
                <button name="action_create_invoice"
                        string="Create Invoice"
                        type="object"
                        class="oe_highlight"
                        invisible="state not in ['approved', 'done', 'received', 'close']"
                        groups="x_spk_invoice.group_create_invoice_spk"/>
            </xpath>

            <!-- Invoice reference field below vendor/customer -->
            <xpath expr="//field[@name='reference_ticket_number']" position="after">
                <field name="invoice_reference" readonly="1" force_save="1"/>
            </xpath>

            <!-- Smart button for invoices -->
            <xpath expr="//sheet/group[1]" position="before">
                <div class="oe_button_box" name="button_box">
                    <button name="%(account.action_move_in_invoice_type)d"
                            type="action"
                            class="oe_stat_button"
                            icon="fa-pencil-square-o"
                            context="{'search_default_fleet_spk_id': id, 'default_fleet_spk_id': id, 'default_move_type': 'in_invoice'}">
                        <div class="o_stat_info">
                            <span class="o_stat_text">Invoices</span>
                        </div>
                    </button>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
