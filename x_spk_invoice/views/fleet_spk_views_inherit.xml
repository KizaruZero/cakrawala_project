<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fleet_spk_form_inherit_invoice" model="ir.ui.view">
        <field name="name">fleet.spk.form.inherit.invoice</field>
        <field name="model">fleet.spk</field>
        <field name="inherit_id" ref="x_spk.fleet_spk_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_print_out']" position="before">
                <button name="action_create_invoice"
                        string="Create Invoice"
                        type="object"
                        class="oe_highlight"
                        invisible="state != 'approved' or not maintenance_is_on_risk"
                        groups="x_spk_invoice.group_create_invoice_spk"/>
            </xpath>

            <xpath expr="//field[@name='reference_ticket_number']" position="after">
                <field name="invoice_reference" readonly="1" force_save="1"/>
            </xpath>

            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_invoices"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-pencil-square-o">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Invoices</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
