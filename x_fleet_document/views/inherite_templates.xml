<odoo>
    <record id="view_fleet_contract_form_inherit_product" model="ir.ui.view">
        <field name="name">fleet.contract.form.inherit.product</field>
        <field name="model">fleet.vehicle.log.contract</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_log_contract_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@class='oe_title']" position="before">
                <div class="oe_button_box" name="button_box">
                    <button name="action_view_vendor_bills"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-pencil-square-o">
                        <div class="o_field_widget o_stat_info">
                            <span class="o_stat_value">
                                <field name="vendor_bill_count"/>
                            </span>
                            <span class="o_stat_text">Vendor Bills</span>
                        </div>
                    </button>
                </div>
            </xpath>
            <xpath expr="//group[field[@name='vehicle_id']]" position="after">

                <group>
                    <field name="vendor_id"/>
                </group>

                <notebook>
                    <page string="Products">
                        <field name="line_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="selected" column_invisible="True"/>
                                <field name="product_id"/>
                                <field name="estimated_price"/>
                                <field name="analytic_account_id"/>
                            </list>
                        </field>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>
    <record id="fleet_vehicle_view_kanban_inherit_document" model="ir.ui.view">
        <field name="name">fleet.vehicle.kanban.rename.contract</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//a[contains(., 'Contract(s)')]" position="replace">
                <a t-if="record.contract_count.raw_value&gt;0"
               type="object"
               name="return_action_to_open"
               href="#"
               context="{'xml_id':'fleet_vehicle_log_contract_action'}">
                    <field name="contract_count"/>
                Document(s)
                    <span t-if="record.contract_renewal_due_soon.raw_value and !record.contract_renewal_overdue.raw_value"
                      class="fa fa-exclamation-triangle text-warning"/>
                    <span t-if="record.contract_renewal_overdue.raw_value"
                      class="fa fa-exclamation-triangle text-danger"/>
                </a>
            </xpath>
        </field>
    </record>
    <record id="view_vehicle_form_inherit" model="ir.ui.view">
        <field name="name">vehicle.form.inherit.custom</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[field[@name='contract_count']]/field[@name='contract_count']" position="attributes">
                <attribute name="string">Documents</attribute>
            </xpath>
            <xpath expr="//field[@name='license_plate']" position="attributes">
                <attribute name="readonly">1</attribute>
                <attribute name="force_save">1</attribute>
            </xpath>
           
        </field>
    </record>
    <record id="view_contract_list_inherit" model="ir.ui.view">
        <field name="name">fleet.contract.list.inherit.add.type</field>
        <field name="model">fleet.vehicle.log.contract</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_log_contract_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="/*" position="inside">
                <header>
                    <button name="action_create_vendor_bill_multi"
                            type="object"
                            string="Create Vendor Bill"
                            class="btn-primary" />
                </header>
            </xpath>
            <xpath expr="//field[@name='name']" position="after">
                <field name="cost_subtype_id" string="Type"/>
            </xpath>
        </field>
    </record>
    <record id="fleet.fleet_vehicle_log_contract_action" model="ir.actions.act_window">
        <field name="name">Documents</field>
    </record>
    <record id="view_contract_form_inherit_rename_label" model="ir.ui.view">
        <field name="name">fleet.contract.form.rename.label</field>
        <field name="model">fleet.vehicle.log.contract</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_log_contract_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='start_date']" position="attributes">
                <attribute name="string">Document Start Date</attribute>
            </xpath>
            <xpath expr="//field[@name='expiration_date']" position="attributes">
                <attribute name="string">Document Expiration Date</attribute>
            </xpath>
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="vin_number"/>
                <field name="license_plate" readonly="state == 'open'"/>
            </xpath>
            <xpath expr="//field[@name='service_ids']" position="after">
                <field name="company_id"/>
                <field name="bpkb_location"/>
            </xpath>
            <xpath expr="//field[@name='service_ids']" position="replace"/>
            <xpath expr="//field[@name='cost_subtype_id']" position="attributes">
                <attribute name="domain">[('is_license_plate', '=', True)]</attribute>
            </xpath>
        </field>
    </record>
    <record id="view_contract_list_inherit_rename_label" model="ir.ui.view">
        <field name="name">fleet.contract.list.rename.label</field>
        <field name="model">fleet.vehicle.log.contract</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_log_contract_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='start_date']" position="attributes">
                <attribute name="string">Document Start Date</attribute>
            </xpath>
            <xpath expr="//field[@name='expiration_date']" position="attributes">
                <attribute name="string">Document Expiration Date</attribute>
            </xpath>
        </field>
    </record>
    <record id="analytic_account_form_inherit_custom" model="ir.ui.view">
        <field name="name">analytic.account.form.inherit.custom</field>
        <field name="model">account.analytic.account</field>
        <field name="inherit_id" ref="analytic.view_account_analytic_account_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="before">
                <field name="asset_number"/>
                <field name="license_plate"/>
            </xpath>
            <xpath expr="//field[@name='plan_id']" position="after">
                <field name="company_id"/>
            </xpath>
        </field>
    </record>
    <record id="fleet_contract_form_inherit_buttons" model="ir.ui.view">
        <field name="name">fleet.contract.form.inherit.buttons</field>
        <field name="model">fleet.vehicle.log.contract</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_log_contract_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="attributes">
                <attribute name="options">{'clickable': True}</attribute>
            </xpath>
            <xpath expr="//header" position="inside">

                <button name="action_set_running"
                    type="object"
                    string="Set to Running"
                    class="btn-primary"
                    invisible="state != 'futur'"/>

                <button name="action_create_vendor_bill"
                    type="object"
                    string="Create Vendor Bill"
                    class="btn-primary"
                    invisible="state != 'open'"/>

                <button name="action_open_change_license_plate_wizard"
                    type="object"
                    string="Change license plate"
                    class="btn-secondary"
                    invisible="state != 'open' or not cost_subtype_id.is_license_plate"/>

            </xpath>
        </field>
    </record>

    <record id="view_fleet_contract_confirm_wizard_form" model="ir.ui.view">
        <field name="name">fleet.contract.confirm.wizard.form</field>
        <field name="model">fleet.contract.confirm.wizard</field>
        <field name="arch" type="xml">
            <form string="Confirmation">
                <group>
                    <div class="o_form_label">
                        Are you sure you want to set this document to Running?
                    </div>
                </group>
                <footer>
                    <button name="action_confirm"
                        type="object"
                        string="Confirm"
                        class="btn-primary"/>
                    <button string="Cancel"
                        special="cancel"
                        class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_fleet_contract_change_plate_wizard_form" model="ir.ui.view">
        <field name="name">fleet.contract.change.plate.wizard.form</field>
        <field name="model">fleet.contract.change.plate.wizard</field>
        <field name="arch" type="xml">
            <form string="Change license plate">
                <group>
                    <field name="contract_id" invisible="1"/>
                    <field name="current_license_plate"/>
                    <field name="new_license_plate" placeholder="e.g. B 1234 ABC"/>
                </group>
                <p class="text-muted">
                    Confirming will update this running document, refresh the document name,
                    create or update the analytic account for the new plate (and link it on the vehicle),
                    and post a note on the chatter. Cancel leaves everything unchanged.
                </p>
                <footer>
                    <button name="action_confirm"
                        type="object"
                        string="Confirm"
                        class="btn-primary"/>
                    <button string="Cancel"
                        special="cancel"
                        class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="fleet_service_type_tree_inherit" model="ir.ui.view">
        <field name="name">fleet.service.type.tree.inherit.license.plate</field>
        <field name="model">fleet.service.type</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_service_types_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="is_license_plate"/>
            </xpath>
        </field>
    </record>
    <data noupdate="0">
        <record id="fleet.fleet_vehicle_log_contract_menu" model="ir.ui.menu">
            <field name="name">Documents</field>
        </record>
    </data>

    <record id="view_fleet_vehicle_form_inherit_custom" model="ir.ui.view">
        <field name="name">fleet.vehicle.form.inherit.custom</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="x_stock_asset_receipt.view_fleet_vehicle_form_inherit_asset"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='asset_number']" position="after">
                <field name="analytic_account_name"
                    widget="badge"
                    readonly="1"/>
            </xpath>
        </field>
    </record>

    <record id="view_fleet_vehicle_search_inherit_extra_fields" model="ir.ui.view">
        <field name="name">fleet.vehicle.search.inherit.extra.fields</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_search"/>
        <field name="arch" type="xml">
            <!-- Add search fields after the existing 'name' field in the search view -->
            <xpath expr="//search" position="inside">
                <field name="asset_number" string="Asset Number"/>
                <field name="chassis_number" string="Chassis Number"/>
                <field name="engine_number" string="Engine Number"/>
            </xpath>
        </field>
    </record>

    <record id="view_fleet_vehicle_form_inherit_sub_type" model="ir.ui.view">
        <field name="name">fleet.vehicle.form.inherit.sub.type</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="x_stock_asset_receipt.view_fleet_vehicle_form_inherit_asset"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='fleet_sub_status_id']" position="before">
                <field name="sub_type" string="Sub Type"/>
            </xpath>
        </field>
    </record>

</odoo>