<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_fleet_vehicle_sub_type_list" model="ir.ui.view">
        <field name="name">fleet.vehicle.sub.type.list</field>
        <field name="model">fleet.vehicle.sub.type</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_fleet_vehicle_sub_type_form" model="ir.ui.view">
        <field name="name">fleet.vehicle.sub.type.form</field>
        <field name="model">fleet.vehicle.sub.type</field>
        <field name="arch" type="xml">
            <form string="Sub-Type">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active" widget="boolean_toggle"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_fleet_vehicle_sub_type" model="ir.actions.act_window">
        <field name="name">Vehicle Sub-Type</field>
        <field name="res_model">fleet.vehicle.sub.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_fleet_vehicle_sub_type"
              name="Master Sub Type"
              parent="fleet.fleet_configuration"
              action="action_fleet_vehicle_sub_type"
              sequence="35"/>
</odoo>
