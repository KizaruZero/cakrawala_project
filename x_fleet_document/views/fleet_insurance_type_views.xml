<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_fleet_insurance_type_list" model="ir.ui.view">
        <field name="name">fleet.insurance.type.list</field>
        <field name="model">fleet.insurance.type</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_fleet_insurance_type_form" model="ir.ui.view">
        <field name="name">fleet.insurance.type.form</field>
        <field name="model">fleet.insurance.type</field>
        <field name="arch" type="xml">
            <form string="Tipe Asuransi">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active" widget="boolean_toggle"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_fleet_insurance_type" model="ir.actions.act_window">
        <field name="name">Tipe Asuransi</field>
        <field name="res_model">fleet.insurance.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_fleet_insurance_type"
              name="Tipe Asuransi"
              parent="x_stock_asset_receipt.menu_fleet_master"
              action="action_fleet_insurance_type"
              sequence="31"/>
</odoo>
