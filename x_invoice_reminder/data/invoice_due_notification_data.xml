<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="notification_template_invoice_due" model="x.notification.template">
            <field name="name">Invoice Due Date Reminder</field>
            <field name="notification_scope">invoice_due</field>
            <field name="code">INVOICE_DUE</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="mail_template_id" ref="mail_template_invoice_due_reminder"/>
            <field name="active" eval="True"/>
        </record>

        <record id="notification_reminder_line_invoice_due_14" model="x.notification.reminder.line">
            <field name="template_id" ref="notification_template_invoice_due"/>
            <field name="days_before_end">14</field>
        </record>
        <record id="notification_reminder_line_invoice_due_7" model="x.notification.reminder.line">
            <field name="template_id" ref="notification_template_invoice_due"/>
            <field name="days_before_end">7</field>
        </record>
        <record id="notification_reminder_line_invoice_due_3" model="x.notification.reminder.line">
            <field name="template_id" ref="notification_template_invoice_due"/>
            <field name="days_before_end">3</field>
        </record>
    </data>
</odoo>
