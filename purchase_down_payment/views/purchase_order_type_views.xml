<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_type_master_form_inherit" model="ir.ui.view">
        <field name="name">purchase.order.type.master.form.inherit</field>
        <field name="model">purchase.order.type.master</field>
        <field name="inherit_id" ref="x_purchase_order_approval.purchase_order_type_master_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_id']" position="after">
                <field name="is_leasing"/>
            </xpath>
        </field>
    </record>

    <record id="purchase_order_type_master_tree_inherit" model="ir.ui.view">
        <field name="name">purchase.order.type.master.tree.inherit</field>
        <field name="model">purchase.order.type.master</field>
        <field name="inherit_id" ref="x_purchase_order_approval.purchase_order_type_master_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="before">
                <field name="is_leasing"/>
            </xpath>
        </field>
    </record>
</odoo>
