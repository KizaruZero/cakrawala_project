<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_inherit_biaya_tdp" model="ir.ui.view">
        <field name="name">product.template.form.inherit.biaya.tdp</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group_general']" position="inside">
                <field name="is_biaya_tdp"/>
            </xpath>
        </field>
    </record>

    <record id="product_template_search_view_inherit_biaya_tdp" model="ir.ui.view">
        <field name="name">product.template.search.inherit.biaya.tdp</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='filter_to_purchase']" position="after">
                <filter string="Biaya Biaya TDP" name="filter_biaya_tdp" domain="[('is_biaya_tdp', '=', True)]"/>
            </xpath>
        </field>
    </record>
</odoo>
