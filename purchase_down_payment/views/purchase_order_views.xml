<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--   Inherited the Purchase Order form view to add a new button -->
    <record id="purchase_order_form" model="ir.ui.view">
        <field name="name">
            purchase.order.view.form.inherit.purchase.down.payment
        </field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='button_cancel']"
                   position="before">
                <button name="%(purchase_down_payment.purchase_order_advance_payment_action)d"
                        string="Create Bill"
                        invisible="state not in ('purchase', 'done') or invoice_status == 'invoiced'"
                        type="action" data-hotkey="w" class="oe_highlight"/>
            </xpath>
            <xpath expr="//field[@name='partner_ref']" position="after">
                <field name="is_leasing" invisible="1"/>
                <field name="leasing_partner_id" invisible="not is_leasing" required="is_leasing"/>
            </xpath>
            <xpath expr="//page[@name='purchase_delivery_invoice']" position="after">
                <page string="Leasing Information" name="leasing_information" invisible="not is_leasing">
                    <group>
                        <group>
                            <field name="amount_total" string="Harga OTR" readonly="1"/>
                            <field name="down_payment_amount" string="DP" readonly="1"/>
                            <field name="leasing_debt" readonly="1"/>
                        </group>
                        <group>
                            <field name="first_installment" readonly="state in ['cancel', 'done', 'purchase']"/>
                            <field name="leasing_debt_balance" readonly="1"/>
                            <field name="admin_fee" readonly="state in ['cancel', 'done', 'purchase']"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Inherit x_purchase_order_approval view to position down_payment_amount under source_document -->
    <record id="purchase_order_form_inherit_approval_dp" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.approval.dp</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="x_purchase_order_approval.form_employee_purchase_requisition_custom_approval"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='source_document']" position="after">
                <field name="down_payment_amount" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
