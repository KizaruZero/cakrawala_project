<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- View for the Line model -->
    <record id="purchase_order_advance_payment_line_view_list" model="ir.ui.view">
        <field name="name">purchase.order.advance.payment.line.view.list</field>
        <field name="model">purchase.order.advance.payment.line</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="product_id"/>
                <field name="description"/>
                <field name="quantity"/>
                <field name="product_uom_id" groups="uom.group_uom"/>
                <field name="price_unit"/>
                <field name="tax_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <!-- Main Wizard View -->
    <record id="purchase_order_advance_payment_view_form" model="ir.ui.view">
        <field name="name">purchase.order.advance.payment.view.form</field>
        <field name="model">purchase.order.advance.payment</field>
        <field name="arch" type="xml">
            <form string="Purchase Order Advance Bill">
                <p class="oe_grey">
                    Bills will be created in draft so that you can review them before validation.
                </p>
                <sheet>
                    <group>
                        <field name="advance_payment_method" widget="radio"/>
                        <field name="has_down_payments" invisible="1"/>
                    </group>
                    
                    <group invisible="advance_payment_method not in ('fixed','percentage')">
                        <label for="amount" string="Down Payment Amount"/>
                        <div id="payment_method_details" class="o_row">
                            <field name="currency_id" invisible="1"/>
                            <field name="fixed_amount" invisible="advance_payment_method != 'fixed'" required="advance_payment_method == 'fixed'"/>
                            <field name="amount" invisible="advance_payment_method != 'percentage'" required="advance_payment_method == 'percentage'"/>
                            <span invisible="advance_payment_method != 'percentage'">%</span>
                        </div>
                        <field name="product_id" required="advance_payment_method in ('fixed','percentage')"/>
                    </group>

                    <separator string="Extra Lines" invisible="advance_payment_method == 'delivered'"/>
                    <field name="payment_line_ids" 
                           invisible="advance_payment_method == 'delivered'"
                           nolabel="1"
                           context="{'tree_view_ref': 'purchase_down_payment.purchase_order_advance_payment_line_view_list'}"/>
                </sheet>
                <footer>
                    <button name="action_create_advance_bill" string="Create and View Bill" type="object" context="{'open_invoices': True}" class="btn-primary" data-hotkey="q"/>
                    <button name="action_create_advance_bill" string="Create Bill" type="object" data-hotkey="w"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="purchase_order_advance_payment_action" model="ir.actions.act_window">
        <field name="name">Create Bill</field>
        <field name="res_model">purchase.order.advance.payment</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="purchase.model_purchase_order"/>
        <field name="binding_view_types">list</field>
    </record>
</odoo>
