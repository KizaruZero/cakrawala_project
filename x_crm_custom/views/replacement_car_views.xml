<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_replacement_car_form_inherit_crm" model="ir.ui.view">
        <field name="name">replacement.car.form.inherit.crm</field>
        <field name="model">replacement.car</field>
        <field name="inherit_id" ref="x_replacement_car.view_replacement_car_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="CRM Reference" invisible="not crm_lead_id">
                    <group>
                        <field name="crm_lead_id" readonly="state != 'draft'"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
