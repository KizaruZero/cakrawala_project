<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_lead_view_form_custom" model="ir.ui.view">
        <field name="name">crm.lead.form.custom</field>
        <field name="model">crm.lead</field>
        <field name="priority">99</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="required">1</attribute>
            </xpath>
            <xpath expr="//h2" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//page[@name='internal_notes']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//page[@name='lead']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Make statusbar non-clickable and add Next Stage button -->
            <xpath expr="//header" position="inside">
                <button name="action_create_rpc" string="Create RPC" type="object" class="btn-primary" invisible="stage_name != 'Offering' or has_rpc == True"/>
                <button name="action_next_stage" string="Next Stage" type="object" class="btn-primary" invisible="stage_name == 'Cold Leads'"/>
            </xpath>
            <xpath expr="//field[@name='stage_id']" position="attributes">
                <attribute name="options">{'fold_field': 'fold', 'clickable': False}</attribute>
            </xpath>

            <!-- Smart Button RPC -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" type="object" name="action_view_rpc_documents" icon="fa-list-ul" invisible="rpc_count == 0">
                    <field name="rpc_count" widget="statinfo" string="RPC"/>
                </button>
            </xpath>

            <!-- Hide Standard Buttons -->
            <xpath expr="//button[@name='action_set_won_rainbowman']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//button[@name='%(crm.crm_lead_lost_action)d']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//button[@name='action_schedule_meeting']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <!-- Sale CRM Buttons -->
            <xpath expr="//button[@name='action_sale_quotations_new']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//button[@name='action_rental_quotations_new']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//group[@name='lead_partner']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//group[@name='opportunity_partner']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//group[@name='lead_info']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//group[@name='lead_partner']/.." position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//group[@name='lead_partner']/.." position="after">
                <field name="stage_name" invisible="1"/>
                <field name="active" invisible="1"/>
                
                <group name="custom_main_layout">
                    <group name="custom_left_column">
                        <field name="is_new_customer" readonly="stage_name == 'Cold Leads'"/>
                        
                        <field name="partner_id" string="Existing Customer" invisible="is_new_customer == True" required="is_new_customer == False" readonly="stage_name == 'Cold Leads'"/>
                        <field name="street" string="Address" invisible="is_new_customer == True" readonly="1"/>
                        
                        <field name="new_customer_name" invisible="is_new_customer == False" required="is_new_customer == True" readonly="stage_name == 'Cold Leads'"/>
                        <field name="new_customer_address" invisible="is_new_customer == False" readonly="stage_name == 'Cold Leads'"/>
                        
                        <field name="user_id" string="Marketing" required="1" readonly="stage_name == 'Cold Leads'"/>
                        <field name="contact_name" required="1" readonly="stage_name == 'Cold Leads'"/>
                        <field name="job_position" required="1" readonly="stage_name == 'Cold Leads'"/>
                        <field name="email_from" required="1" readonly="stage_name == 'Cold Leads'"/>
                        <field name="phone" required="1" readonly="stage_name == 'Cold Leads'"/>
                    </group>
                    
                    <group name="custom_right_column">
                        <field name="client_type_id" required="1" readonly="stage_name == 'Cold Leads'"/>
                        <field name="tujuan_id" required="1" readonly="stage_name == 'Cold Leads'"/>
                        <field name="jenis_transaksi_id" required="1" readonly="stage_name == 'Cold Leads'"/>
                        <field name="custom_source_id" string="Sumber" required="1" readonly="stage_name == 'Cold Leads'"/>
                        <field name="current_population_id" readonly="stage_name == 'Cold Leads'" placeholder="Pilih Current Population"/>
                        <field name="existing_fleet" readonly="stage_name == 'Cold Leads'"/>
                        <field name="has_rpc" invisible="1"/>
                    </group>
                </group>
            </xpath>

            <xpath expr="//notebook" position="inside">
                
                <page string="Offering" name="page_offering" invisible="stage_name not in ['Offering', 'Negotiation', 'Deal', 'Delivery', 'Cold Leads']">
                    <group>
                        <group string="Vehicle Details" name="group_vehicle_details">
                            <field name="jenis_kendaraan_id" required="stage_name in ['Offering', 'Negotiation', 'Deal', 'Delivery']" readonly="stage_name != 'Offering'"/>
                            <field name="vehicle_condition" required="stage_name in ['Offering', 'Negotiation', 'Deal', 'Delivery']" readonly="stage_name != 'Offering'"/>
                            <field name="quantity" required="stage_name in ['Offering', 'Negotiation', 'Deal', 'Delivery']" readonly="stage_name != 'Offering'"/>
                            <field name="sumber_daya_id" required="stage_name in ['Offering', 'Negotiation', 'Deal', 'Delivery']" readonly="stage_name != 'Offering'"/>
                            <field name="penggunaan_kendaraan_id" required="stage_name in ['Offering', 'Negotiation', 'Deal', 'Delivery']" readonly="stage_name != 'Offering'"/>
                            <field name="pemakaian" required="stage_name in ['Offering', 'Negotiation', 'Deal', 'Delivery']" readonly="stage_name != 'Offering'"/>
                        </group>
                        <group string="" name="group_vehicle_details_right">
                            <field name="merek_id" required="stage_name in ['Offering', 'Negotiation', 'Deal', 'Delivery']" readonly="stage_name != 'Offering'"/>
                            <field name="tipe_kendaraan_id" required="stage_name in ['Offering', 'Negotiation', 'Deal', 'Delivery']" readonly="stage_name != 'Offering'"/>
                            <field name="tahun" required="stage_name in ['Offering', 'Negotiation', 'Deal', 'Delivery']" readonly="1"/>
                            <field name="state_id" required="stage_name in ['Offering', 'Negotiation', 'Deal', 'Delivery']" readonly="stage_name != 'Offering'"/>
                            <field name="city_id" required="stage_name in ['Offering', 'Negotiation', 'Deal', 'Delivery']" readonly="stage_name != 'Offering'"/>
                        </group>
                    </group>
                    <group>
                        <group string="Commercial &amp; Logistic" name="group_commercial_logistic">
                            <field name="sewa_per_bulan" required="stage_name in ['Offering', 'Negotiation', 'Deal', 'Delivery']" readonly="stage_name != 'Offering'"/>
                            <field name="harga_otr" required="stage_name in ['Offering', 'Negotiation', 'Deal', 'Delivery']" readonly="stage_name != 'Offering'"/>
                            <field name="rental_type_id" required="stage_name in ['Offering', 'Negotiation', 'Deal', 'Delivery']" readonly="stage_name != 'Offering'" options="{'no_create': True}"/>
                            <field name="masa_sewa" required="stage_name in ['Offering', 'Negotiation', 'Deal', 'Delivery']" readonly="stage_name != 'Offering'"/>
                            <field name="masa_sewa_buffer" invisible="1"/>
                            <field name="offering_notes" readonly="stage_name != 'Offering'"/>
                        </group>
                        <group string="" name="group_commercial_logistic_right">
                            <field name="total_forecast" readonly="1"/>
                            <field name="usage_location_id" required="stage_name in ['Offering', 'Negotiation', 'Deal', 'Delivery']" readonly="stage_name != 'Offering'"/>
                            <field name="estimated_delivery" required="stage_name in ['Offering', 'Negotiation', 'Deal', 'Delivery']" readonly="stage_name != 'Offering'" options="{'numeric': True}"/>
                        </group>
                    </group>
                </page>

                <page string="Negotiation" name="page_negotiation" invisible="stage_name not in ['Negotiation', 'Deal', 'Delivery', 'Cold Leads']">
                    <group>
                        <group>
                            <field name="sq_number" readonly="1"/>
                            <field name="initial_rpc" readonly="1"/>
                        </group>
                    </group>
                </page>

                <page string="Deal" name="page_deal" invisible="stage_name not in ['Deal', 'Delivery', 'Cold Leads']">
                    <group>
                        <group string="Sales Order &amp; Procurement" name="group_so_procurement">
                            <field name="so_number" required="stage_name in ['Deal', 'Delivery']" readonly="stage_name != 'Deal'"/>
                            <field name="pr_number" required="stage_name in ['Deal', 'Delivery']" readonly="stage_name != 'Deal'"/>
                            <field name="po_number" required="stage_name in ['Deal', 'Delivery']" readonly="stage_name != 'Deal'"/>
                        </group>
                        <group string="Contract and Insurance" name="group_contract_insurance">
                            <field name="contract_number" required="stage_name in ['Deal', 'Delivery']" readonly="stage_name != 'Deal'"/>
                            <field name="insurance_clause" required="stage_name in ['Deal', 'Delivery']" readonly="stage_name != 'Deal'"/>
                        </group>
                    </group>
                </page>

                <page string="Delivery" name="page_delivery" invisible="stage_name not in ['Delivery', 'Cold Leads']">
                    <group>
                        <group>
                            <field name="do_number" required="stage_name == 'Delivery'" readonly="stage_name != 'Delivery'"/>
                            <field name="delivery_category" required="stage_name == 'Delivery'" readonly="stage_name != 'Delivery'"/>
                            <field name="bastk_number" required="stage_name == 'Delivery'" readonly="stage_name != 'Delivery'"/>
                        </group>
                    </group>
                </page>

            </xpath>
        </field>
    </record>

    <record id="utm_campaign_view_form_inherit_custom" model="ir.ui.view">
        <field name="name">utm.campaign.view.form.inherit.custom</field>
        <field name="model">utm.campaign</field>
        <field name="inherit_id" ref="utm.utm_campaign_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <field name="campaign_stage_name" invisible="1"/>
                <field name="active" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
