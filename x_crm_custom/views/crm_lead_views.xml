<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_lead_view_form_custom" model="ir.ui.view">
        <field name="name">crm.lead.form.custom</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">

            <!-- Inject New Customer logic before partner group -->
            <xpath expr="//group[@name='lead_partner']" position="before">
                <group name="new_customer_logic" colspan="2">
                    <field name="is_new_customer"/>
                    <field name="new_customer_name" invisible="is_new_customer == False"/>
                    <field name="new_customer_address" invisible="is_new_customer == False"/>
                </group>
            </xpath>

            <!-- Hide existing partner_id if it's a new customer -->
            <xpath expr="//group[@name='lead_partner']" position="attributes">
                <attribute name="invisible">type == 'opportunity' or is_new_customer == True</attribute>
            </xpath>
            <xpath expr="//group[@name='opportunity_partner']" position="attributes">
                <attribute name="invisible">type == 'lead' or is_new_customer == True</attribute>
            </xpath>

            <!-- Change user_id string to Marketing -->
            <!-- Use parentheses to correctly index nodes across the entire document -->
            <xpath expr="(//field[@name='user_id'])[1]" position="attributes">
                <attribute name="string">Marketing</attribute>
            </xpath>
            <xpath expr="(//field[@name='user_id'])[2]" position="attributes">
                <attribute name="string">Marketing</attribute>
            </xpath>

            <!-- Add custom header fields -->
            <xpath expr="//group[@name='lead_partner']" position="after">
                <group name="custom_header_fields">
                    <field name="client_type_id"/>
                    <field name="tujuan_id"/>
                    <field name="jenis_transaksi_id"/>
                    <field name="custom_source_id"/>
                    <field name="current_population"/>
                    <field name="existing_fleet"/>
                </group>
            </xpath>

            <!-- Add Notebooks for Offering, Negotiation, Deal, Delivery -->
            <xpath expr="//notebook" position="inside">
                
                <page string="Offering" name="page_offering">
                    <group>
                        <group string="Vehicle Details" name="group_vehicle_details">
                            <field name="jenis_kendaraan_id"/>
                            <field name="sumber_daya_id"/>
                            <field name="penggunaan_kendaraan_id"/>
                            <field name="pemakaian"/>
                            <field name="merek_id"/>
                            <field name="tahun"/>
                            <field name="state_id"/>
                            <field name="city_id"/>
                            <field name="vehicle_condition"/>
                            <field name="quantity"/>
                            <field name="tipe_kendaraan"/>
                        </group>
                        <group string="Commercial &amp; Logistic" name="group_commercial_logistic">
                            <field name="rental_type_id"/>
                            <field name="usage_location_id"/>
                            <field name="sewa_per_bulan"/>
                            <field name="harga_otr"/>
                            <field name="masa_sewa"/>
                            <field name="masa_sewa_buffer"/>
                            <field name="total_forecast"/>
                            <field name="estimated_delivery"/>
                            <field name="offering_notes"/>
                        </group>
                    </group>
                </page>

                <page string="Negotiation" name="page_negotiation">
                    <group>
                        <group>
                            <field name="sq_number"/>
                            <field name="initial_rpc"/>
                            <field name="revised_rpc"/>
                        </group>
                    </group>
                </page>

                <page string="Deal" name="page_deal">
                    <group>
                        <group string="Sales Order &amp; Procurement" name="group_so_procurement">
                            <field name="so_number"/>
                            <field name="pr_number"/>
                            <field name="po_number"/>
                        </group>
                        <group string="Contract and Insurance" name="group_contract_insurance">
                            <field name="contract_number"/>
                            <field name="insurance_clause"/>
                        </group>
                    </group>
                </page>

                <page string="Delivery" name="page_delivery">
                    <group>
                        <group>
                            <field name="do_number"/>
                            <field name="delivery_category"/>
                            <field name="bastk_number"/>
                        </group>
                    </group>
                </page>

            </xpath>

        </field>
    </record>
</odoo>
