<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_lead_view_form_custom" model="ir.ui.view">
        <field name="name">crm.lead.form.custom</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="required">1</attribute>
            </xpath>
            <xpath expr="//h2" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//page[@name='internal_notes']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//page[@name='lead']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//group[@name='lead_partner']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//group[@name='opportunity_partner']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//group[@name='lead_info']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//group[@name='lead_partner']/.." position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//group[@name='lead_partner']/.." position="after">
                <group name="custom_main_layout">
                    <group name="custom_left_column">
                        <field name="is_new_customer"/>
                        
                        <field name="partner_id" string="Existing Customer" invisible="is_new_customer == True" required="is_new_customer == False"/>
                        <field name="street" string="Address" invisible="is_new_customer == True" readonly="1"/>
                        
                        <field name="new_customer_name" invisible="is_new_customer == False" required="is_new_customer == True"/>
                        <field name="new_customer_address" invisible="is_new_customer == False"/>
                        
                        <field name="user_id" string="Marketing" required="1"/>
                        <field name="contact_name" required="1"/>
                        <field name="job_position" required="1"/>
                        <field name="email_from" required="1"/>
                        <field name="phone" required="1"/>
                    </group>
                    
                    <group name="custom_right_column">
                        <field name="client_type_id" required="1"/>
                        <field name="tujuan_id" required="1"/>
                        <field name="jenis_transaksi_id" required="1"/>
                        <field name="custom_source_id" required="1"/>
                        <field name="current_population"/>
                        <field name="existing_fleet"/>
                    </group>
                </group>
            </xpath>

            <xpath expr="//notebook" position="inside">
                
                <page string="Offering" name="page_offering">
                    <group>
                        <group string="Vehicle Details" name="group_vehicle_details">
                            <field name="jenis_kendaraan_id" required="1"/>
                            <field name="vehicle_condition" required="1"/>
                            <field name="quantity" required="1"/>
                            <field name="sumber_daya_id" required="1"/>
                            <field name="penggunaan_kendaraan_id" required="1"/>
                            <field name="pemakaian" required="1"/>
                        </group>
                        <group string="" name="group_vehicle_details_right">
                            <field name="merek_id" required="1"/>
                            <field name="tipe_kendaraan" required="1"/>
                            <field name="tahun" required="1"/>
                            <field name="state_id" required="1"/>
                            <field name="city_id" required="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Commercial &amp; Logistic" name="group_commercial_logistic">
                            <field name="sewa_per_bulan" required="1"/>
                            <field name="harga_otr" required="1"/>
                            <field name="rental_type_id" required="1"/>
                            <field name="masa_sewa" required="1"/>
                            <field name="masa_sewa_buffer" required="1"/>
                            <field name="offering_notes"/>
                        </group>
                        <group string="" name="group_commercial_logistic_right">
                            <field name="total_forecast"/>
                            <field name="usage_location_id" required="1"/>
                            <field name="estimated_delivery" required="1"/>
                        </group>
                    </group>
                </page>

                <page string="Negotiation" name="page_negotiation">
                    <group>
                        <group>
                            <field name="sq_number"/>
                            <field name="initial_rpc"/>
                            <field name="revised_rpc"/>
                        </group>
                    </group>
                </page>

                <page string="Deal" name="page_deal">
                    <group>
                        <group string="Sales Order &amp; Procurement" name="group_so_procurement">
                            <field name="so_number"/>
                            <field name="pr_number"/>
                            <field name="po_number"/>
                        </group>
                        <group string="Contract and Insurance" name="group_contract_insurance">
                            <field name="contract_number"/>
                            <field name="insurance_clause"/>
                        </group>
                    </group>
                </page>

                <page string="Delivery" name="page_delivery">
                    <group>
                        <group>
                            <field name="do_number"/>
                            <field name="delivery_category"/>
                            <field name="bastk_number"/>
                        </group>
                    </group>
                </page>

            </xpath>

        </field>
    </record>
</odoo>
