<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="helpdesk_ticket_view_form_inherit_x_enhance" model="ir.ui.view">
    <field name="name">helpdesk.ticket.form.inherit.x.enhance</field>
    <field name="model">helpdesk.ticket</field>
    <field name="inherit_id" ref="helpdesk.helpdesk_ticket_view_form"/>
    <field name="arch" type="xml">
      <xpath expr="//form/header/field[@name='stage_id']" position="before">
        <field name="can_create_bak_or_spk" invisible="1"/>
        <button name="action_create_bak" string="Create BAK" type="object" class="btn-primary" invisible="not ticket_category_is_accident or not can_create_bak_or_spk or bak_reference_id" />
        <button name="action_create_spk" string="Create SPK" type="object" class="btn-primary" invisible="not ticket_category_id or ticket_category_is_accident or not can_create_bak_or_spk or spk_reference_id" />
      </xpath>
      <xpath expr="//field[@name='priority']" position="before">
        <label for="ticket_ref" string="Ticket Number"/>
        <div class="o_row">
          <field name="ticket_ref" readonly="1" nolabel="1" class="oe_inline"/>
        </div>
        <field name="ticketing_category_id" invisible="1"/>
        <field name="ticket_category_id" options="{'no_create_edit': True}" readonly="bak_reference_id or spk_reference_id"/>
        <field name="ticket_category_is_accident" invisible="1"/>
        <field name="pic_id" options="{'no_create_edit': True}"/>
        <field name="phone"/>
      </xpath>
      <xpath expr="//field[@name='email_cc']" position="after">
        <field name="is_vehicle_mandatory" invisible="1"/>
        <field name="vehicle_id" options="{'no_create_edit': True}" required="is_vehicle_mandatory"/>
        <field name="vehicle_license_plate" readonly="1" invisible="not vehicle_id"/>
        <field name="vehicle_color" readonly="1" invisible="not vehicle_id"/>
        <field name="vehicle_year" readonly="1" invisible="not vehicle_id"/>
        <field name="vehicle_vin_sn" readonly="1" invisible="not vehicle_id"/>
        <field name="unit_location"/>
        <field name="odometer" widget="integer"/>
      </xpath>
      <xpath expr="//notebook/page[last()]" position="after">
        <page string="Others Information" name="others_information">
          <group>
            <field name="bak_reference_id" readonly="1" options="{'no_create_edit': True}" invisible="not ticket_category_is_accident"/>
            <field name="spk_reference_id" readonly="1" options="{'no_create_edit': True}" invisible="not ticket_category_id or ticket_category_is_accident"/>
          </group>
        </page>
      </xpath>
      <xpath expr="//field[@name='user_id']" position="attributes">
        <attribute name="invisible">1</attribute>
      </xpath>
      <xpath expr="//field[@name='user_id']" position="after">
        <field name="employee_id"/>
      </xpath>
    </field>
  </record>

  <record id="helpdesk_ticket_view_tree_inherit_x_enhance" model="ir.ui.view">
    <field name="name">helpdesk.ticket.list.inherit.x.enhance</field>
    <field name="model">helpdesk.ticket</field>
    <field name="inherit_id" ref="helpdesk.helpdesk_tickets_view_tree"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='ticket_ref']" position="after">

        <field name="ticket_category_id" optional="show"/>
        <field name="vehicle_id" optional="show"/>
      </xpath>
      <xpath expr="//field[@name='user_id']" position="attributes">
        <attribute name="invisible">1</attribute>
      </xpath>
      <xpath expr="//field[@name='user_id']" position="after">
        <field name="employee_id" optional="show"/>
      </xpath>
    </field>
  </record>

  <record id="helpdesk_ticket_view_search_inherit_x_enhance" model="ir.ui.view">
    <field name="name">helpdesk.ticket.search.inherit.x.enhance</field>
    <field name="model">helpdesk.ticket</field>
    <field name="inherit_id" ref="helpdesk.helpdesk_tickets_view_search"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='tag_ids']" position="after">
        <field name="ticketing_category_id"/>
        <field name="ticket_category_id"/>
        <field name="vehicle_id"/>
      </xpath>
    </field>
  </record>
</odoo>
