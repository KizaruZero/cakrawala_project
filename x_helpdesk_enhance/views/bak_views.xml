<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_bak_form_inherit_helpdesk_enhance" model="ir.ui.view">
    <field name="name">bak.form.inherit.helpdesk.enhance</field>
    <field name="model">bak</field>
    <field name="inherit_id" ref="x_bak.view_bak_form"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='ticket_number']" position="after">
        <field name="helpdesk_ticket_id" readonly="1" options="{'no_create_edit': True}"/>
      </xpath>
    </field>
  </record>
</odoo>