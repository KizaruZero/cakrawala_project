<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_bak_form_inherit_helpdesk_enhance" model="ir.ui.view">
    <field name="name">bak.form.inherit.helpdesk.enhance</field>
    <field name="model">bak</field>
    <field name="inherit_id" ref="x_bak.view_bak_form"/>
    <field name="arch" type="xml">
      <xpath expr="//header" position="inside">
        <field name="has_helpdesk_rc" invisible="1"/>
        <field name="replacement_car_count" invisible="1"/>
        <button name="action_create_rc"
                string="Create RC"
                type="object"
                class="btn-primary"
                invisible="state not in ('confirm', 'done') or has_helpdesk_rc or replacement_car_count &gt; 0"/>
      </xpath>
      <xpath expr="//div[@name='button_box']" position="inside">
        <button class="oe_stat_button" type="object" name="action_view_replacement_car" icon="fa-car" invisible="replacement_car_count == 0">
          <field name="replacement_car_count" widget="statinfo" string="Replacement Car"/>
        </button>
      </xpath>
      <xpath expr="//field[@name='invoice_id']" position="after">
        <field name="helpdesk_ticket_id"
               readonly="1"
               invisible="not helpdesk_ticket_id"
               options="{'no_create_edit': True, 'no_open': False}"/>
      </xpath>
      <xpath expr="//field[@name='partner_id']" position="replace">
        <field name="partner_id" readonly="state != 'draft' or helpdesk_ticket_id" force_save="1"/>
      </xpath>
      <xpath expr="//field[@name='vehicle_id']" position="replace">
        <field name="vehicle_id" required="not helpdesk_ticket_id" readonly="state != 'draft' or helpdesk_ticket_id" force_save="1"/>
      </xpath>
    </field>
  </record>
</odoo>