<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="helpdesk_ticket_category_view_list" model="ir.ui.view">
    <field name="name">helpdesk.ticket.category.list</field>
    <field name="model">helpdesk.ticket.category</field>
    <field name="arch" type="xml">
      <list editable="bottom">
        <field name="sequence" widget="handle"/>
        <field name="name"/>
        <field name="is_accident"/>
        <field name="is_rc"/>
        <field name="active"/>
      </list>
    </field>
  </record>

  <record id="helpdesk_ticket_category_view_form" model="ir.ui.view">
    <field name="name">helpdesk.ticket.category.form</field>
    <field name="model">helpdesk.ticket.category</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <field name="name"/>
            <field name="sequence"/>
            <field name="is_accident"/>
            <field name="is_rc"/>
            <field name="active"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="helpdesk_ticket_category_action" model="ir.actions.act_window">
    <field name="name">Kategori Keluhan</field>
    <field name="res_model">helpdesk.ticket.category</field>
    <field name="view_mode">list,form</field>
  </record>

  <menuitem id="helpdesk_ticket_category_menu" name="Kategori Keluhan" parent="helpdesk.helpdesk_menu_config" action="helpdesk_ticket_category_action" sequence="25" groups="helpdesk.group_helpdesk_manager" />
</odoo>
