<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_rpc_roles" model="ir.ui.view">
        <field name="name">res.users.form.rpc.roles</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="(//page[@name='access_rights']//field[@name='group_ids'])[1]"
                   position="before">
                <group string="Rental Profit Calculation" invisible="share">
                    <field name="rpc_role_ids"
                           widget="many2many_tags"
                           options="{'no_create': True, 'no_create_edit': True}"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
