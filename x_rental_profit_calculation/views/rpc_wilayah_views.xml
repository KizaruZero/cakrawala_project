<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- WILAYAH -->
    <record id="view_rpc_wilayah_list" model="ir.ui.view">
        <field name="name">rpc.wilayah.list</field>
        <field name="model">rpc.wilayah</field>
        <field name="arch" type="xml">
            <list string="Wilayah" editable="top">
                <field name="name"/>
                <field name="code"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_rpc_wilayah_form" model="ir.ui.view">
        <field name="name">rpc.wilayah.form</field>
        <field name="model">rpc.wilayah</field>
        <field name="arch" type="xml">
            <form string="Wilayah">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="active"/>
                    </group>
                    <field name="provinsi_ids">
                        <list>
                            <field name="name"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_rpc_wilayah" model="ir.actions.act_window">
        <field name="name">Wilayah</field>
        <field name="res_model">rpc.wilayah</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
