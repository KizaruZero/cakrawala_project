<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rpc_kota_list" model="ir.ui.view">
        <field name="name">rpc.kota.list</field>
        <field name="model">rpc.kota</field>
        <field name="arch" type="xml">
            <list string="Kota" editable="top">
                <field name="provinsi_id"/>
                <field name="name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_rpc_kota_form" model="ir.ui.view">
        <field name="name">rpc.kota.form</field>
        <field name="model">rpc.kota</field>
        <field name="arch" type="xml">
            <form string="Kota">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="provinsi_id" options="{'no_create': True}"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_rpc_kota" model="ir.actions.act_window">
        <field name="name">Kota</field>
        <field name="res_model">rpc.kota</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
