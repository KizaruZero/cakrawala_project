<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rpc_finance_line_type_list" model="ir.ui.view">
        <field name="name">rpc.finance.line.type.list</field>
        <field name="model">rpc.finance.line.type</field>
        <field name="arch" type="xml">
            <list string="Finance Cashflow Type" editable="top">
                <field name="sequence" widget="handle"/>
                <field name="table_type"/>
                <field name="name"/>
                <field name="code"/>
                <field name="formula_batas_atas" optional="show"/>
                <field name="formula_batas_bawah" optional="show"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_rpc_finance_line_type_form" model="ir.ui.view">
        <field name="name">rpc.finance.line.type.form</field>
        <field name="model">rpc.finance.line.type</field>
        <field name="arch" type="xml">
            <form string="Finance Cashflow Type">
                <sheet>
                    <group>
                        <group>
                            <field name="table_type"/>
                            <field name="name"/>
                            <field name="code"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Formula">
                        <field name="formula_batas_atas"/>
                        <field name="formula_batas_bawah"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_rpc_finance_line_type_search" model="ir.ui.view">
        <field name="name">rpc.finance.line.type.search</field>
        <field name="model">rpc.finance.line.type</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="table_type"/>
                <group name="group_by">
                    <filter name="groupby_table_type" string="Group"
                            context="{'group_by': 'table_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_rpc_finance_line_type" model="ir.actions.act_window">
        <field name="name">Finance Cashflow Type</field>
        <field name="res_model">rpc.finance.line.type</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_rpc_finance_line_type_search"/>
        <field name="context">{'search_default_groupby_table_type': 1}</field>
    </record>
</odoo>
