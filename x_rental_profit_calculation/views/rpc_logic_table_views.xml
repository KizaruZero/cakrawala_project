<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rpc_logic_table_list" model="ir.ui.view">
        <field name="name">logic.table.list</field>
        <field name="model">logic.table</field>
        <field name="arch" type="xml">
            <list string="Logic Table" create="0" edit="0" delete="0">
                <field name="sequence" column_invisible="1"/>
                <field name="year_index" column_invisible="1"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="document_id" optional="hide"/>
                <field name="hierarchy_id"/>
                <field name="cost_group_code_id"/>
                <field name="cost_group_name_id"/>
                <field name="payment_schedule_id"/>
                <field name="formula" optional="hide"/>
                <field name="tahun"/>
                <field name="variable" optional="hide"/>
                <field name="masa_sewa" optional="hide"/>
                <field name="masa_kredit" optional="hide"/>
                <field name="harga_per_unit_year_batas_atas" optional="hide"/>
                <field name="harga_per_unit_year_batas_bawah" optional="hide"/>
                <field name="akumulasi_per_unit_batas_atas" optional="hide"/>
                <field name="akumulasi_per_unit_batas_bawah" optional="hide"/>
                <field name="qty_unit"/>
                <field name="total_year_batas_atas"/>
                <field name="total_year_batas_bawah"/>
                <field name="akumulasi_total_batas_atas" optional="hide"/>
                <field name="akumulasi_total_batas_bawah" optional="hide"/>
                <field name="gapping_pct" widget="percentage"/>
                <field name="gapping_total_year_batas_atas"/>
                <field name="gapping_total_year_batas_bawah"/>
                <field name="akumulasi_gapping_total_batas_atas" optional="hide"/>
                <field name="akumulasi_gapping_total_batas_bawah" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_rpc_logic_table_search" model="ir.ui.view">
        <field name="name">logic.table.search</field>
        <field name="model">logic.table</field>
        <field name="arch" type="xml">
            <search string="Cari Logic Table">
                <field name="document_id"/>
                <field name="hierarchy_id"/>
                <field name="cost_group_code_id"/>
                <field name="cost_group_name_id"/>
                <field name="payment_schedule_id"/>
                <field name="tahun"/>
                <field name="formula"/>
                <field name="variable"/>
                <group name="group_by">
                    <filter name="groupby_hierarchy"
                            string="Hierarchy"
                            context="{'group_by': 'hierarchy_id'}"/>
                    <filter name="groupby_cost_group_code"
                            string="Cost Group Code"
                            context="{'group_by': 'cost_group_code_id'}"/>
                    <filter name="groupby_cost_group_name"
                            string="Cost Group Name"
                            context="{'group_by': 'cost_group_name_id'}"/>
                    <filter name="groupby_payment_schedule"
                            string="Jadwal Pembayaran"
                            context="{'group_by': 'payment_schedule_id'}"/>
                    <filter name="groupby_tahun"
                            string="Tahun"
                            context="{'group_by': 'tahun'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_rpc_logic_table" model="ir.actions.act_window">
        <field name="name">Logic Table</field>
        <field name="res_model">logic.table</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_rpc_logic_table_list"/>
        <field name="search_view_id" ref="view_rpc_logic_table_search"/>
        <field name="context">{'create': False, 'edit': False, 'delete': False}</field>
    </record>
</odoo>
