<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rpc_hok_component_list" model="ir.ui.view">
        <field name="name">rpc.hok.component.list</field>
        <field name="model">rpc.hok.component</field>
        <field name="arch" type="xml">
            <list string="Master Komponen HOK" editable="bottom"
                  create="0" delete="0">
                <field name="sequence" widget="handle"/>
                <field name="code" readonly="1"/>
                <field name="excel_code" readonly="1" invisible="1"/>
                <field name="name"/>
                <field name="category" readonly="1"/>
                <field name="value_format" readonly="1"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_rpc_hok_component_form" model="ir.ui.view">
        <field name="name">rpc.hok.component.form</field>
        <field name="model">rpc.hok.component</field>
        <field name="arch" type="xml">
            <form string="Komponen HOK" create="0" delete="0">
                <sheet>
                    <widget name="web_ribbon" text="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <group>
                        <field name="active" invisible="1"/>
                        <field name="name"/>
                        <field name="code" readonly="1"/>
                        <field name="excel_code" readonly="1"/>
                        <field name="category" readonly="1"/>
                        <field name="value_format" readonly="1"/>
                        <field name="sequence"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_rpc_hok_component_search" model="ir.ui.view">
        <field name="name">rpc.hok.component.search</field>
        <field name="model">rpc.hok.component</field>
        <field name="arch" type="xml">
            <search string="Cari Komponen HOK">
                <field name="name"/>
                <field name="code"/>
                <filter name="parameter" string="Parameter" domain="[('category', '=', 'parameter')]"/>
                <filter name="cost" string="Cost Base" domain="[('category', '=', 'cost')]"/>
                <filter name="result" string="Hasil" domain="[('category', '=', 'result')]"/>
                <separator/>
                <filter name="inactive" string="Diarsipkan" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_rpc_hok_component" model="ir.actions.act_window">
        <field name="name">Komponen HOK</field>
        <field name="res_model">rpc.hok.component</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_rpc_hok_component_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Master nama komponen HOK</p>
            <p>Nama dapat diubah tanpa memengaruhi kode dan rumus perhitungan.</p>
        </field>
    </record>
</odoo>
