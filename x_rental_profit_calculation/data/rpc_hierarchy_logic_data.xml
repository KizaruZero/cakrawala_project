        <record id="cost_group_code_ft01" model="rpc.hierarchy.logic.cost.group.code"><field name="name">FT01</field><field name="sequence">80</field></record>
        <record id="cost_group_code_ft02" model="rpc.hierarchy.logic.cost.group.code"><field name="name">FT02</field><field name="sequence">90</field></record>
