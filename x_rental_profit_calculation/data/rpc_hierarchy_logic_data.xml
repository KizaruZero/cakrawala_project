        </record>
        <record id="hierarchy_logic_line_mk03" model="rpc.hierarchy.logic">
            <field name="sequence">140</field><field name="hierarchy_id" ref="hierarchy_logic_marketing_komisi"/><field name="cost_group_code_id" ref="cost_group_code_mk03"/><field name="cost_group_name_id" ref="cost_group_name_komisi_proyek"/><field name="payment_schedule_id" ref="payment_schedule_di_depan_lumpsum"/>
