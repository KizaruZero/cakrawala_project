        </record>
        <record id="hierarchy_logic_line_ft04" model="rpc.hierarchy.logic">
            <field name="sequence">110</field><field name="hierarchy_id" ref="hierarchy_logic_fitur"/><field name="cost_group_code_id" ref="cost_group_code_ft04"/><field name="cost_group_name_id" ref="cost_group_name_asuransi_jiwa"/><field name="payment_schedule_id" ref="payment_schedule_60_hari_tiap_tahun"/>
