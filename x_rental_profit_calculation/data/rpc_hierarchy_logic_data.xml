        <record id="cost_group_code_mk03" model="rpc.hierarchy.logic.cost.group.code"><field name="name">MK03</field><field name="sequence">140</field></record>
        <record id="cost_group_code_mk04" model="rpc.hierarchy.logic.cost.group.code"><field name="name">MK04</field><field name="sequence">150</field></record>

        <!-- Cost Group Name -->
