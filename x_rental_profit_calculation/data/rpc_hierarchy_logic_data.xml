            <field name="sequence">10</field><field name="hierarchy_id" ref="hierarchy_logic_finansial"/><field name="cost_group_code_id" ref="cost_group_code_f01"/><field name="cost_group_name_id" ref="cost_group_name_total_down_payment"/><field name="payment_schedule_id" ref="payment_schedule_di_depan"/><field name="formula">ambil dari field down_payment_amount</field>
        </record>
        <record id="hierarchy_logic_line_f02" model="rpc.hierarchy.logic">
            <field name="sequence">20</field><field name="hierarchy_id" ref="hierarchy_logic_finansial"/><field name="cost_group_code_id" ref="cost_group_code_f02"/><field name="cost_group_name_id" ref="cost_group_name_selisih_sewa_angsuran"/><field name="payment_schedule_id" ref="payment_schedule_tiap_bulan"/>
