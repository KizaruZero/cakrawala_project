<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="rpc_approval_stage_submitted" model="rpc.approval.stage">
        <field name="name">Submitted</field>
        <field name="sequence">1</field>
        <field name="state">submitted</field>
        <field name="user_ids" eval="[Command.link(ref('base.user_admin'))]"/>
    </record>

    <record id="rpc_approval_stage_procurement_done" model="rpc.approval.stage">
        <field name="name">Procurement Done</field>
        <field name="sequence">2</field>
        <field name="state">procurement_done</field>
        <field name="user_ids" eval="[Command.link(ref('base.user_admin'))]"/>
    </record>

    <record id="rpc_approval_stage_operation_done" model="rpc.approval.stage">
        <field name="name">Operation Done</field>
        <field name="sequence">3</field>
        <field name="state">operation_done</field>
        <field name="user_ids" eval="[Command.link(ref('base.user_admin'))]"/>
    </record>

    <record id="rpc_approval_stage_finance_done" model="rpc.approval.stage">
        <field name="name">Finance Done</field>
        <field name="sequence">4</field>
        <field name="state">finance_done</field>
        <field name="user_ids" eval="[Command.link(ref('base.user_admin'))]"/>
    </record>

    <record id="rpc_approval_stage_approved" model="rpc.approval.stage">
        <field name="name">Approved</field>
        <field name="sequence">5</field>
        <field name="state">approved</field>
        <field name="user_ids" eval="[Command.link(ref('base.user_admin'))]"/>
    </record>
</odoo>
