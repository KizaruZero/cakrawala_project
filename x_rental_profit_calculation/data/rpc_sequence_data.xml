<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sequence RPC: RPC/YYYY/MM-NNNNN -->
        <record id="seq_rpc_document" model="ir.sequence">
            <field name="name">RPC Document Number</field>
            <field name="code">rpc.document</field>
            <field name="prefix">RPC/%(year)s/%(month)s-</field>
            <field name="suffix"></field>
            <field name="padding">5</field>
            <field name="number_increment">1</field>
            <field name="number_next">1</field>
            <field name="use_date_range">True</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
