<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rpc_document_revise_wizard_form" model="ir.ui.view">
        <field name="name">rpc.document.revise.wizard.form</field>
        <field name="model">rpc.document.revise.wizard</field>
        <field name="arch" type="xml">
            <form string="Revise RPC">
                <group>
                    <field name="document_id"/>
                    <field name="source_state"/>
                    <field name="revise_reason"
                           placeholder="Jelaskan alasan dokumen dikembalikan ke Draft..."/>
                </group>
                <footer>
                    <button name="action_confirm_revise"
                            string="Revise"
                            type="object"
                            class="btn-primary"/>
                    <button string="Batal"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
