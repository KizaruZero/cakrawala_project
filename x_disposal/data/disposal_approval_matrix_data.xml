<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="0">

    <!-- Default Approval Matrix -->
    <record id="disposal_approval_matrix_default" model="disposal.approval.matrix">
      <field name="name">Disposal Approval Matrix</field>
      <field name="is_default">True</field>
      <field name="active">True</field>
    </record>

    <!-- Approval Line: Admin approver for amount >= 0 -->
    <record id="disposal_approval_matrix_line_admin" model="disposal.approval.matrix.line">
      <field name="matrix_id" ref="disposal_approval_matrix_default"/>
      <field name="sequence">1</field>
      <field name="starting_amount">0</field>
      <field name="approver_id" ref="base.user_admin"/>
      <field name="active">True</field>
    </record>

  </data>
</odoo>
