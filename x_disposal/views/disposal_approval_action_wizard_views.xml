<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <record id="view_disposal_approval_action_wizard" model="ir.ui.view">
      <field name="name">disposal.approval.action.wizard.form</field>
      <field name="model">disposal.approval.action.wizard</field>
      <field name="arch" type="xml">
        <form string="Bidding Approval Action">
          <group>
            <field name="action_type"/>
            <field name="bidding_id" invisible="1"/>
            <field name="approval_tracking_id" invisible="1"/>
            <field name="remarks"/>
            <field name="attachment_ids"/>
          </group>
          <footer>
            <button string="Confirm" type="object" name="action_confirm" class="btn-primary"/>
            <button string="Cancel" class="btn-secondary" special="cancel"/>
          </footer>
        </form>
      </field>
    </record>
  </data>
</odoo>
