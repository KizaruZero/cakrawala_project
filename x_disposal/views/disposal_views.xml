<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="action_disposal_bidding" model="ir.actions.act_window">
    <field name="name">Disposal Biddings</field>
    <field name="res_model">disposal.bidding</field>
    <field name="view_mode">list,form</field>
    <field name="help">Manage Disposal Biddings</field>
    <field name="binding_model_id" ref="model_disposal_bidding"/>
  </record>

  <record id="view_disposal_bidding_list" model="ir.ui.view">
    <field name="name">disposal.bidding.list</field>
    <field name="model">disposal.bidding</field>
    <field name="arch" type="xml">
      <list string="Disposal Biddings">
        <field name="name"/>
        <field name="vehicle_id"/>
        <field name="open_price"/>
        <field name="start_date"/>
        <field name="end_date"/>
        <field name="state"/>
      </list>
    </field>
  </record>

  <record id="view_disposal_bidding_form" model="ir.ui.view">
    <field name="name">disposal.bidding.form</field>
    <field name="model">disposal.bidding</field>
    <field name="arch" type="xml">
      <form string="Disposal Bidding">
        <header>
          <field name="state" widget="statusbar" statusbar_visible="draft,waiting_approval,approved"/>
          <button name="action_submit_for_approval" type="object" string="Submit for Approval" invisible="state != 'draft'" class="btn-primary"/>
          <button name="action_open_accept_wizard" type="object" string="Approve" invisible="state != 'waiting_approval' or not can_current_user_approve"/>
          <button name="action_open_reject_wizard" type="object" string="Reject" invisible="state != 'waiting_approval' or not can_current_user_approve"/>
          <button name="action_reset_to_draft" type="object" string="Reset to Draft" invisible="state != 'rejected'"/>
        </header>
        <sheet>
          <group>
            <group>
              <field name="name" readonly="1"/>
              <field name="vehicle_id" readonly="state in ['approved']"/>
              <field name="asset_number" readonly="1"/>
              <field name="license_plate" readonly="1"/>
            </group>
            <group>
              <field name="start_date" readonly="state in ['approved']"/>
              <field name="end_date" readonly="state in ['approved']"/>
              <field name="open_price" readonly="state in ['approved']"/>
              <field name="currency_id" readonly="state in ['approved']"/>
              <field name="sales_price" readonly="1"/>
              <field name="potential_winner" readonly="1"/>
            </group>
          </group>

          <notebook>
            <page string="Bidding List">
              <field name="bidding_line_ids" readonly="state in ['approved']">
                <list editable="bottom">
                  <field name="partner_id"/>
                  <field name="pic_name"/>
                  <field name="bidding_price"/>
                  <field name="notes"/>
                  <field name="attachment" filename="attachment_filename" widget="binary"/>
                </list>
              </field>
            </page>
            <page string="Matrix Approval">
              <field name="approval_tracking_ids" readonly="1">
                <list>
                  <field name="sequence"/>
                  <field name="approver_id"/>
                  <field name="delegate_id"/>
                  <field name="delegate_valid_from"/>
                  <field name="delegate_valid_to"/>
                  <field name="state"/>
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

</odoo>
