<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>

    <record id="disposal_approval_matrix_list" model="ir.ui.view">
      <field name="name">disposal.approval.matrix.list</field>
      <field name="model">disposal.approval.matrix</field>
      <field name="arch" type="xml">
        <list>
          <field name="name"/>
          <field name="is_default"/>
          <field name="active"/>
        </list>
      </field>
    </record>

    <record id="disposal_approval_matrix_form" model="ir.ui.view">
      <field name="name">disposal.approval.matrix.form</field>
      <field name="model">disposal.approval.matrix</field>
      <field name="arch" type="xml">
        <form>
          <sheet>
            <div class="oe_title">
              <h1>
                <field name="name" readonly="1"/>
              </h1>
            </div>
            <group>
              <field name="name"/>
              <field name="active"/>
              <field name="is_default"/>
            </group>

            <separator string="Approval Sequence"/>
            <field name="approval_line_ids">
              <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="sequence" string="No." readonly="1"/>
                <field name="approver_id" required="1"/>
                <field name="delegate_id"/>
                <field name="delegate_valid_from"/>
                <field name="delegate_valid_to"/>
                <field name="starting_amount"/>
                <field name="active"/>
              </list>
            </field>
          </sheet>
        </form>
      </field>
    </record>

    <record id="disposal_approval_matrix_action" model="ir.actions.act_window">
      <field name="name">Approval Matrix</field>
      <field name="res_model">disposal.approval.matrix</field>
      <field name="view_mode">list,form</field>
    </record>

  </data>
</odoo>
