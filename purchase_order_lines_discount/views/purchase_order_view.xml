<odoo>
    <record id="view_move_form" model="ir.ui.view">
        <field name="name">purchase.order.form.discount</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='tax_ids']" position="after">
                <field name="fixed_discount" optional="show"/>
            </xpath>
        </field>
    </record>
    <record id="view_account_move_form_fixed_discount" model="ir.ui.view">
        <field name="name">account.move.form.fixed.discount</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='discount']" position="after">
                <field name="fixed_discount" optional="show" />
                <field name="fixed_discount_type" column_invisible="True" />
                <field name="other_cost_deduction" optional="show"
                       column_invisible="parent.move_type not in ('in_invoice', 'in_refund', 'in_receipt')"
                       readonly="parent.state != 'draft'"/>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/form//field[@name='price_unit']" position="after">
                <field name="other_cost_deduction"
                       invisible="parent.move_type not in ('in_invoice', 'in_refund', 'in_receipt')"
                       readonly="parent.state != 'draft'"/>
            </xpath>
        </field>
    </record>
</odoo>
