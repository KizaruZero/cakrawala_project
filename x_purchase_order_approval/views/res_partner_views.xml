<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_partner_form_inherit_purchase_order_approval" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.purchase.order.approval</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="priority">70</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='category_id']" position="after">
                <!-- supplier_rank dipakai sebagai penanda Vendor Master, jadi field
                     wajib di bawah ini hanya aktif untuk vendor. -->
                <field name="supplier_rank" invisible="1"/>
                <!-- Dicomment sementara -->
                <!-- <field name="purchase_contact_person" required="supplier_rank &gt; 0"/> -->
                <field name="purchase_contact_person"/>
            </xpath>

            <!-- Dicomment sementara -->
            <!-- <xpath expr="//field[@name='vat']" position="attributes">
                <attribute name="required">supplier_rank &gt; 0</attribute>
            </xpath> -->

            <!-- Alamat dan telepon: xpath berikut kena node pertama, yaitu field
                 di form partner utama, bukan sub-form kontak di dalam child_ids. -->
            <!-- Dicomment sementara -->
            <!-- <xpath expr="//field[@name='street']" position="attributes">
                <attribute name="required">supplier_rank &gt; 0</attribute>
            </xpath> -->

            <!-- Dicomment sementara -->
            <!-- <xpath expr="//field[@name='phone']" position="attributes">
                <attribute name="required">supplier_rank &gt; 0</attribute>
            </xpath> -->
        </field>
    </record>
</odoo>
