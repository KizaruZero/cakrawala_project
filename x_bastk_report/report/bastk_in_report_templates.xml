<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="report_bastk_in_template">
    <t t-call="web.html_container">
        <t t-foreach="docs" t-as="doc">
            <t t-call="web.basic_layout">
                <style>
                    .page { font-family: Arial, sans-serif; font-size: 9.5px; color: #000; }
                    .bt { width: 100%; border-collapse: collapse; margin-bottom: 8px; font-size: 9px; }
                    .bt td, .bt th { border: 1px solid #000; padding: 3px 5px !important; vertical-align: middle; }
                    .bt thead th { background-color: #E8E8E8; color: #000; font-weight: bold; text-align: center; padding: 4px 5px !important; }
                    .lbl { background-color: #F0F0F0 !important; color: #000; font-weight: bold; }
                    .sec-title { background-color: #E8E8E8; color: #000; padding: 3.5px 6px; font-size: 9.5px; font-weight: bold; margin: 0; display: block; border: 1px solid #000; border-bottom: none; }
                    .checklist-tbl { width: 100%; border-collapse: collapse; font-size: 8.5px; margin-top: 0; margin-bottom: 6px; }
                    .checklist-tbl td, .checklist-tbl th { border: 1px solid #000; padding: 2px 4px !important; vertical-align: middle; line-height: 1.2; }
                    .checklist-tbl thead th { background-color: #F5F5F5; color: #000; font-weight: bold; text-align: center; padding: 2.5px 4px !important; font-size: 8px; border: 1px solid #000; }
                    .checklist-tbl thead th.category-header { background-color: #E8E8E8; color: #000; padding: 3.5px 6px !important; font-size: 9px; font-weight: bold; text-align: left !important; border: 1px solid #000; }
                    .checklist-tbl tr { page-break-inside: avoid; }
                    .checklist-tbl thead { display: table-header-group; }
                    .checklist-tbl tbody { display: table-row-group; }
                    .info-tbl td, .info-tbl th { padding: 3px 5px !important; font-size: 8.5px; }
                    .info-tbl .lbl { font-size: 8.5px; }
                    .col-left { width: 49.5%; float: left; }
                    .col-right { width: 49.5%; float: right; }
                    .clearfix { clear: both; }
                </style>

                <div class="page">

                    <table border="0" cellspacing="0" cellpadding="0" style="width: 100%; border-collapse: collapse; margin-bottom: 6px;">
                        <tr>
                            <td style="width: 50%; vertical-align: top; padding-right: 5px;">
                                <table style="width: 100%; border-collapse: collapse;">
                                    <tr>
                                        <td t-if="doc.env.company.logo" style="width: 32%; vertical-align: top; padding-right: 8px;">
                                            <img t-att-src="image_data_uri(doc.env.company.logo)" style="max-height: 65px; max-width: 130px; display: block;" alt="Logo"/>
                                        </td>
                                        <td style="vertical-align: top;">
                                            <div style="font-size: 12px; font-weight: bold; color: #000; line-height: 1.25;">
                                                <t t-esc="doc.env.company.name"/>
                                            </div>
                                            <div style="font-size: 8.5px; color: #222; line-height: 1.35; margin-top: 2px;">
                                                <t t-if="doc.env.company.street"><t t-esc="doc.env.company.street"/><br/></t>
                                                <t t-if="doc.env.company.street2"><t t-esc="doc.env.company.street2"/><br/></t>
                                                <t t-if="doc.env.company.city"><t t-esc="doc.env.company.city"/></t>
                                                <t t-if="doc.env.company.country_id"><t t-esc="' ' + doc.env.company.country_id.name"/></t>
                                                <t t-if="doc.env.company.phone"><br/>Tel: <t t-esc="doc.env.company.phone"/></t>
                                                <t t-if="doc.env.company.email"><br/>Email: <t t-esc="doc.env.company.email"/></t>
                                            </div>
                                        </td>
                                    </tr>
                                </table>
                            </td>

                            <td style="width: 50%; text-align: right; vertical-align: top; padding-left: 5px;">
                                <div style="font-size: 18px; font-weight: bold; color: #000; letter-spacing: 0.5px; line-height: 1.2;">
                                    BASTK IN
                                </div>
                                <div style="font-size: 9px; color: #000; line-height: 1.45; margin-top: 2px;">
                                    <t t-esc="doc.name or '-'"/><br/>
                                    <t t-esc="doc.bastk_type_id.name if doc.bastk_type_id else '-'"/> - <span t-field="doc.end_date" t-options='{"widget": "date"}'/>
                                </div>
                            </td>
                        </tr>
                    </table>

                    <div style="border-bottom: 1.5px solid #000; margin-bottom: 8px;"></div>

                    <table border="0" cellspacing="0" cellpadding="0" style="width:100%; border-collapse:collapse; margin-bottom:8px;">
                        <tr>
                            <td style="width:50%; vertical-align:top; padding-right:5px;">
                                <div class="sec-title">Informasi Pelanggan &amp; Pengemudi</div>
                                <table class="bt info-tbl" style="margin-top:0;">
                                    <tbody>
                                        <tr><td class="lbl" style="width:38%;">Partner</td><td><t t-esc="doc.partner_id.name if doc.partner_id else '-'"/></td></tr>
                                        <tr><td class="lbl">PIC Partner</td><td><t t-esc="doc.pic_masuk or '-'"/></td></tr>
                                        <tr><td class="lbl">Phone Number</td><td><t t-esc="doc.call_number_masuk or '-'"/></td></tr>
                                        <tr><td class="lbl">Username</td><td><t t-esc="doc.driver_name or '-'"/></td></tr>
                                        <tr><td class="lbl">Address</td><td><t t-esc="doc.address_text or '-'"/></td></tr>
                                    </tbody>
                                </table>
                            </td>
                            <td style="width:50%; vertical-align:top; padding-left:5px;">
                                <div class="sec-title">Informasi Kendaraan</div>
                                <table class="bt info-tbl" style="margin-top:0;">
                                    <tbody>
                                        <tr>
                                            <td class="lbl" style="width:25%;">Vehicle</td>
                                            <td colspan="3">
                                                <t t-esc="doc.vehicle_id.name if doc.vehicle_id else '-'"/>
                                                <t t-if="doc.unit_type"><t t-esc="' (' + doc.unit_type.name + ')'"/></t>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="lbl" style="width:25%;">License Plate</td>
                                            <td style="width:25%;"><t t-esc="doc.license_plate or '-'"/></td>
                                            <td class="lbl" style="width:25%;">Asset Number</td>
                                            <td style="width:25%;"><t t-esc="doc.asset_number or '-'"/></td>
                                        </tr>
                                        <tr>
                                            <td class="lbl">Color</td>
                                            <td colspan="3"><t t-esc="doc.color or '-'"/></td>
                                        </tr>
                                        <tr>
                                            <td class="lbl">Model Year</td>
                                            <td><t t-esc="doc.model_year or '-'"/></td>
                                            <td class="lbl">Engine Number</td>
                                            <td><t t-esc="doc.engine_number or '-'"/></td>
                                        </tr>
                                        <tr>
                                            <td class="lbl">VIN Number</td>
                                            <td colspan="3"><t t-esc="doc.vin_number or '-'"/></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </td>
                        </tr>
                    </table>

                    <t t-set="lines" t-value="doc.line_masuk_ids.filtered(lambda l: not l.display_type)"/>
                    <t t-set="cats" t-value="lines.mapped('item_type_id').sorted(lambda c: c.sequence)"/>
                    <t t-set="untyped_lines" t-value="lines.filtered(lambda l: not l.item_type_id)"/>
                    <t t-set="letters" t-value="['A', 'B', 'C', 'D', 'E', 'F', 'G', 'H', 'I', 'J', 'K', 'L']"/>
                    <t t-set="untyped_title" t-value="(letters[len(cats)] + '. ' if len(cats) &lt; len(letters) else '') + ('LAIN-LAIN' if cats else 'CHECKLIST ITEM')"/>
                    <t t-set="group_count" t-value="len(cats) + (1 if untyped_lines else 0)"/>
                    <t t-set="left_count" t-value="(group_count + 1) // 2"/>

                    <div class="col-left">
                        <t t-if="lines">
                            <t t-foreach="cats" t-as="cat">
                                <t t-if="cat_index &lt; left_count" t-call="x_bastk_report.bastk_checklist_group">
                                    <t t-set="group_title" t-value="(letters[cat_index] + '. ' if cat_index &lt; len(letters) else '') + cat.name.upper()"/>
                                    <t t-set="group_lines" t-value="lines.filtered(lambda l: l.item_type_id == cat)"/>
                                </t>
                            </t>
                            <t t-if="untyped_lines and len(cats) &lt; left_count" t-call="x_bastk_report.bastk_checklist_group">
                                <t t-set="group_title" t-value="untyped_title"/>
                                <t t-set="group_lines" t-value="untyped_lines"/>
                            </t>
                        </t>
                        <t t-else="">
                            <table class="checklist-tbl">
                                <tbody>
                                    <tr><td style="text-align:center; color:#555; padding:8px !important;">Tidak ada data checklist.</td></tr>
                                </tbody>
                            </table>
                        </t>

                        <t t-if="doc.remarks_masuk">
                            <div style="border: 1px solid #000; margin-top: 4px; margin-bottom: 6px; page-break-inside: avoid;">
                                <div style="background-color: #EFEFEF; color: #000; font-weight: bold; font-size: 8.5px; padding: 2px 4px; border-bottom: 1px solid #000;">
                                    CATATAN / REMARKS
                                </div>
                                <div style="padding: 4px 6px; font-size: 8.5px; line-height: 1.3;">
                                    <t t-esc="doc.remarks_masuk"/>
                                </div>
                            </div>
                        </t>
                    </div>

                    <div class="col-right">

                        <t t-foreach="cats" t-as="cat">
                            <t t-if="cat_index &gt;= left_count" t-call="x_bastk_report.bastk_checklist_group">
                                <t t-set="group_title" t-value="(letters[cat_index] + '. ' if cat_index &lt; len(letters) else '') + cat.name.upper()"/>
                                <t t-set="group_lines" t-value="lines.filtered(lambda l: l.item_type_id == cat)"/>
                            </t>
                        </t>
                        <t t-if="untyped_lines and len(cats) &gt;= left_count" t-call="x_bastk_report.bastk_checklist_group">
                            <t t-set="group_title" t-value="untyped_title"/>
                            <t t-set="group_lines" t-value="untyped_lines"/>
                        </t>

                        <div style="border: 1px solid #000; margin-bottom: 8px; page-break-inside: avoid;">
                            <div style="background-color: #EFEFEF; color: #000; font-weight: bold; font-size: 9px; padding: 3px 6px; border-bottom: 1px solid #000;">
                                Confirm Photo / Attachment
                            </div>
                            <div style="padding: 4px;">
                                <t t-set="img_attachments_masuk" t-value="doc.attachment_masuk_ids.filtered(lambda a: a.mimetype and a.mimetype.startswith('image/'))"/>
                                <t t-set="non_img_masuk" t-value="doc.attachment_masuk_ids.filtered(lambda a: not (a.mimetype and a.mimetype.startswith('image/')))"/>

                                <t t-if="img_attachments_masuk or non_img_masuk">
                                    <t t-if="img_attachments_masuk">
                                        <div style="width: 100%; text-align: center;">
                                            <t t-foreach="img_attachments_masuk" t-as="att">
                                                <div style="display: inline-block; vertical-align: top; margin: 2px; text-align: center; border: 1px solid #ccc; padding: 2px; box-sizing: border-box; max-width: 95%;">
                                                    <img t-if="att.datas" t-att-src="image_data_uri(att.datas)" style="max-width: 100%; max-height: 120px; display: block; margin: auto;"/>
                                                    <img t-elif="att.id" t-att-src="'/web/image/%s' % att.id" style="max-width: 100%; max-height: 120px; display: block; margin: auto;"/>
                                                    <p style="font-size: 8px; margin: 2px 0 0 0; color: #333; word-break: break-all; line-height: 1.1;"><t t-esc="att.name"/></p>
                                                </div>
                                            </t>
                                        </div>
                                    </t>
                                    <t t-if="non_img_masuk">
                                        <div style="font-size: 8.5px; color: #000; font-weight: bold; margin-top: 4px;">File Lampiran Dokumen:</div>
                                        <ul style="font-size: 8px; margin: 2px 0; padding-left: 15px; color: #000;">
                                            <t t-foreach="non_img_masuk" t-as="att_file">
                                                <li><t t-esc="att_file.name"/></li>
                                            </t>
                                        </ul>
                                    </t>
                                </t>
                                <t t-else="">
                                    <div style="text-align: center; color: #777; font-size: 8.5px; padding: 10px 0;">Tidak ada attachment</div>
                                </t>
                            </div>
                        </div>

                        <t t-if="doc.image_masuk_ids">
                            <t t-foreach="doc.image_masuk_ids" t-as="img">
                                <div style="width: 100%; margin-bottom: 8px; border: 1px solid #000; box-sizing: border-box; page-break-inside: avoid;">
                                    <div style="background-color: #EFEFEF; color: #000; font-weight: bold; font-size: 9px; padding: 3px 6px; border-bottom: 1px solid #000; text-align: left;">
                                        <t t-esc="img.name.upper() if img.name else 'FOTO KONDISI KENDARAAN'"/>
                                    </div>
                                    <div style="padding: 4px; text-align: center;">
                                        <t t-if="img.annotated_image">
                                            <img t-att-src="image_data_uri(img.annotated_image)" style="max-width: 100%; max-height: 160px; display: block; margin: auto;"/>
                                        </t>
                                        <t t-elif="img.image">
                                            <img t-att-src="image_data_uri(img.image)" style="max-width: 100%; max-height: 160px; display: block; margin: auto;"/>
                                        </t>
                                        <t t-else="">
                                            <span style="color:#777; font-size:8.5px;">Tidak ada gambar</span>
                                        </t>
                                    </div>
                                </div>
                            </t>
                        </t>
                        <t t-elif="doc.vehicle_id and (doc.vehicle_id.category_id or (doc.vehicle_id.model_id and doc.vehicle_id.model_id.category_id))">
                            <t t-set="cat_obj" t-value="doc.vehicle_id.category_id or doc.vehicle_id.model_id.category_id"/>
                            <t t-if="cat_obj.photo_ids">
                                <t t-foreach="cat_obj.photo_ids" t-as="img">
                                    <div style="width: 100%; margin-bottom: 8px; border: 1px solid #000; box-sizing: border-box; page-break-inside: avoid;">
                                        <div style="background-color: #EFEFEF; color: #000; font-weight: bold; font-size: 9px; padding: 3px 6px; border-bottom: 1px solid #000; text-align: left;">
                                            <t t-esc="img.name.upper() if img.name else 'FOTO KONDISI KENDARAAN'"/>
                                        </div>
                                        <div style="padding: 4px; text-align: center;">
                                            <img t-if="img.image" t-att-src="image_data_uri(img.image)" style="max-width: 100%; max-height: 160px; display: block; margin: auto;"/>
                                            <span t-else="" style="color:#777; font-size:8.5px;">Tidak ada gambar</span>
                                        </div>
                                    </div>
                                </t>
                            </t>
                            <t t-else="">
                                <div style="border: 1px solid #000; margin-bottom: 8px; padding: 12px 0; text-align: center; color: #777; font-size: 8.5px;">Tidak ada foto kendaraan</div>
                            </t>
                        </t>
                        <t t-else="">
                            <div style="border: 1px solid #000; margin-bottom: 8px; padding: 12px 0; text-align: center; color: #777; font-size: 8.5px;">Tidak ada foto kendaraan</div>
                        </t>

                        <table border="0" cellspacing="0" cellpadding="0" style="width:100%; border-collapse:collapse; margin-top:0; margin-bottom:0; page-break-inside:avoid;">
                            <tr>
                                <td style="width:50%; text-align:center; padding:6px 4px; vertical-align:top;">
                                    <p style="font-weight:bold; margin-bottom:8px; color:#000; font-size:9.5px;">Tanda Tangan Pelanggan</p>
                                    <t t-if="doc.customer_sign_masuk">
                                        <img t-att-src="'data:image/png;base64,' + doc.customer_sign_masuk.decode('utf-8')"
                                             style="max-height:70px; max-width:100%; display:block; margin:auto;"/>
                                    </t>
                                    <t t-else="">
                                        <div style="height:55px; border-bottom:1px solid #000; margin:0 15px;"></div>
                                    </t>
                                    <t t-if="doc.customer_name_masuk">
                                        <p style="margin-top:4px; margin-bottom:0; font-size:9.5px; font-weight:bold; color:#000;">( <t t-esc="doc.customer_name_masuk"/> )</p>
                                        <p style="margin-top:1px; font-size:8.5px; color:#333;">( <t t-esc="doc.partner_id.name if doc.partner_id else '.......................'"/> )</p>
                                    </t>
                                    <t t-else="">
                                        <p style="margin-top:4px; font-size:9.5px; color:#000;">( <t t-esc="doc.partner_id.name if doc.partner_id else '.......................'"/> )</p>
                                    </t>
                                    <t t-if="doc.customer_date_masuk">
                                        <p style="margin-top:1px; font-size:8.5px; color:#000;">Tanggal: <span t-field="doc.customer_date_masuk" t-options='{"widget": "date"}'/></p>
                                    </t>
                                    <t t-else="">
                                        <p style="margin-top:1px; font-size:8.5px; color:#000;">Tanggal: -</p>
                                    </t>
                                </td>
                                <td style="width:50%; text-align:center; padding:6px 4px; vertical-align:top;">
                                    <p style="font-weight:bold; margin-bottom:8px; color:#000; font-size:9.5px;">Tanda Tangan Cakrawala Rent</p>
                                    <t t-if="doc.cakrawala_sign_masuk">
                                        <img t-att-src="'data:image/png;base64,' + doc.cakrawala_sign_masuk.decode('utf-8')"
                                             style="max-height:70px; max-width:100%; display:block; margin:auto;"/>
                                    </t>
                                    <t t-else="">
                                        <div style="height:55px; border-bottom:1px solid #000; margin:0 15px;"></div>
                                    </t>
                                    <t t-if="doc.cakrawala_name_masuk">
                                        <p style="margin-top:4px; margin-bottom:0; font-size:9.5px; font-weight:bold; color:#000;">( <t t-esc="doc.cakrawala_name_masuk"/> )</p>
                                        <p style="margin-top:1px; font-size:8.5px; color:#333;">( Cakrawala Rent )</p>
                                    </t>
                                    <t t-else="">
                                        <p style="margin-top:4px; font-size:9.5px; color:#000;">( Cakrawala Rent )</p>
                                    </t>
                                    <t t-if="doc.cakrawala_date_masuk">
                                        <p style="margin-top:1px; font-size:8.5px; color:#000;">Tanggal: <span t-field="doc.cakrawala_date_masuk" t-options='{"widget": "date"}'/></p>
                                    </t>
                                    <t t-else="">
                                        <p style="margin-top:1px; font-size:8.5px; color:#000;">Tanggal: -</p>
                                    </t>
                                </td>
                            </tr>
                        </table>
                    </div>

                    <div class="clearfix"></div>

                </div>
            </t>
        </t>
    </t>
</template>
</odoo>
