<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="report_bastk_in_template">
    <t t-call="web.html_container">
        <t t-foreach="docs" t-as="doc">
            <t t-call="web.basic_layout">
                <style>
                    .page { font-family: Arial, sans-serif; font-size: 11px; }
                    .bt { width: 100%; border-collapse: collapse; margin-bottom: 14px; font-size: 11px; }
                    .bt td, .bt th { border: 1px solid #BDD7EE; padding: 6px 10px !important; vertical-align: middle; }
                    .bt thead th { background-color: #2E75B6; color: #fff; font-weight: bold; text-align: center; padding: 7px 10px !important; }
                    .lbl { background-color: #DEEAF1 !important; color: #1F3864; font-weight: bold; }
                    .sec-title { background-color: #1F3864; color: #fff; padding: 7px 12px; font-size: 12px; font-weight: bold; margin: 0; display: block; }
                    .tick { display: inline-block; width: 6px; height: 12px; border-right: 3px solid #2E75B6; border-bottom: 3px solid #2E75B6; -webkit-transform: rotate(45deg); transform: rotate(45deg); margin-bottom: 4px; }
                    .tick-red { display: inline-block; width: 6px; height: 12px; border-right: 3px solid #C00000; border-bottom: 3px solid #C00000; -webkit-transform: rotate(45deg); transform: rotate(45deg); margin-bottom: 4px; }
                    .tick-orange { display: inline-block; width: 6px; height: 12px; border-right: 3px solid #D06000; border-bottom: 3px solid #D06000; -webkit-transform: rotate(45deg); transform: rotate(45deg); margin-bottom: 4px; }
                    .checklist-tbl { width: 100%; border-collapse: collapse; font-size: 9px; margin-top: 0; }
                    .checklist-tbl td, .checklist-tbl th { border: 1px solid #BDD7EE; padding: 2px 4px !important; vertical-align: middle; line-height: 1.2; }
                    .checklist-tbl thead th { background-color: #2E75B6; color: #fff; font-weight: bold; text-align: center; padding: 4px 3px !important; font-size: 8.5px; }
                    .info-tbl td, .info-tbl th { padding: 4.5px 7px !important; font-size: 10.5px; }
                    .info-tbl .lbl { font-size: 10px; }
                </style>

                <div class="page">

                    <!-- TITLE & LOGO -->
                    <table style="width: 100%; border-collapse: collapse; margin-bottom: 15px;">
                        <tr>
                            <td style="width: 40%; vertical-align: middle; padding: 0;">
                                <img t-if="doc.env.company.logo" t-att-src="image_data_uri(doc.env.company.logo)" style="max-height: 80px; max-width: 220px;" alt="Logo"/>
                            </td>
                            <td style="width: 60%; text-align: right; vertical-align: top; padding: 0; padding-top: 5px;">
                                <div style="font-size: 18px; font-weight: bold; color: #1F3864; line-height: 1.4;">
                                    <t t-esc="doc.env.company.name"/>
                                </div>
                                <div style="font-size: 14px; color: #333; line-height: 1.4;">
                                    <t t-esc="doc.env.company.city or ''"/>
                                    <t t-if="doc.env.company.country_id">
                                        <t t-esc="' ' + doc.env.company.country_id.name"/>
                                    </t>
                                </div>
                            </td>
                        </tr>
                    </table>
                    <div style="text-align: center; margin-bottom: 6px;">
                        <div style="font-size: 14px; font-weight: bold; text-transform: uppercase; letter-spacing: 1px; color: #1F3864;">Berita Acara Serah Terima Kendaraan</div>
                        <div style="font-size: 12px; color: #2E75B6;">(BASTK MASUK)</div>
                    </div>

                    <!-- INFORMASI BASTK -->
                    <div class="sec-title">Informasi BASTK</div>
                    <table class="bt" style="margin-top:0;">
                        <tbody>
                            <tr>
                                <td class="lbl" style="width:22%;">BASTK Number</td>
                                <td style="width:28%;"><t t-esc="doc.name or '-'"/></td>
                                <td class="lbl" style="width:22%;">Status</td>
                                <td style="width:28%;">
                                    <t t-if="doc.state == 'draft'">Draft</t>
                                    <t t-elif="doc.state == 'submitted_outside'">Submitted Out</t>
                                    <t t-elif="doc.state == 'submitted_inside'">Submitted In</t>
                                    <t t-elif="doc.state == 'done'">Done</t>
                                    <t t-else="-"/>
                                </td>
                            </tr>
                            <tr>
                                <td class="lbl">Bastk Type</td>
                                <td><t t-esc="doc.bastk_type_id.name if doc.bastk_type_id else '-'"/></td>
                                <td class="lbl">Start Date</td>
                                <td><t t-esc="doc.start_date or '-'"/></td>
                            </tr>
                            <tr>
                                <td class="lbl">End Date</td>
                                <td><t t-esc="doc.end_date or '-'"/></td>
                                <td class="lbl">Description</td>
                                <td><t t-esc="doc.description or '-'"/></td>
                            </tr>
                        </tbody>
                    </table>

                    <!-- TWO COLUMNS -->
                    <table border="0" cellspacing="0" cellpadding="0" style="width:100%; border-collapse:separate; border-spacing:0; border:none; margin-bottom:14px;">
                        <tr style="border:none;">
                            <td style="width:50%; vertical-align:top; padding-right:6px; border:none;">
                                <div class="sec-title">Informasi Pelanggan &amp; Pengemudi</div>
                                <table class="bt info-tbl" style="margin-top:0;">
                                    <tbody>
                                        <tr><td class="lbl" style="width:38%;">Partner</td><td><t t-esc="doc.partner_id.name if doc.partner_id else '-'"/></td></tr>
                                        <tr><td class="lbl">PIC Partner</td><td><t t-esc="doc.pic_masuk or '-'"/></td></tr>
                                        <tr><td class="lbl">Call Number</td><td><t t-esc="doc.call_number_masuk or '-'"/></td></tr>
                                        <tr><td class="lbl">Driver / User Name</td><td><t t-esc="doc.driver_name or '-'"/></td></tr>
                                        <tr><td class="lbl">Address</td><td><t t-esc="doc.address_text or '-'"/></td></tr>
                                    </tbody>
                                </table>
                            </td>
                            <td style="width:50%; vertical-align:top; padding-left:6px; border:none;">
                                <div class="sec-title">Informasi Kendaraan</div>
                                <table class="bt info-tbl" style="margin-top:0;">
                                    <tbody>
                                        <tr>
                                            <td class="lbl" style="width:25%;">Vehicle</td>
                                            <td colspan="3"><t t-esc="doc.vehicle_id.name if doc.vehicle_id else '-'"/></td>
                                        </tr>
                                        <tr>
                                            <td class="lbl" style="width:25%;">License Plate</td>
                                            <td style="width:25%;"><t t-esc="doc.license_plate or '-'"/></td>
                                            <td class="lbl" style="width:25%;">Asset Number</td>
                                            <td style="width:25%;"><t t-esc="doc.asset_number or '-'"/></td>
                                        </tr>
                                        <tr>
                                            <td class="lbl">Unit Type</td>
                                            <td><t t-esc="doc.unit_type.name if doc.unit_type else '-'"/></td>
                                            <td class="lbl">Color</td>
                                            <td><t t-esc="doc.color or '-'"/></td>
                                        </tr>
                                        <tr>
                                            <td class="lbl">Model Year</td>
                                            <td><t t-esc="doc.model_year or '-'"/></td>
                                            <td class="lbl">Engine Number</td>
                                            <td><t t-esc="doc.engine_number or '-'"/></td>
                                        </tr>
                                        <tr>
                                            <td class="lbl">VIN Number</td>
                                            <td colspan="3"><t t-esc="doc.vin_number or '-'"/></td>
                                        </tr>
                                        <tr>
                                            <td class="lbl">Odometer Out</td>
                                            <td><t t-esc="int(doc.odometer_out) if doc.odometer_out else '0'"/> km</td>
                                            <td class="lbl">Odometer In</td>
                                            <td><t t-esc="int(doc.odometer_in) if doc.odometer_in else '0'"/> km</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </td>
                        </tr>
                    </table>

                    <!-- CHECKLIST MASUK -->
                    <div class="sec-title">Checklist Masuk</div>
                    <t t-set="lines" t-value="doc.line_masuk_ids.filtered(lambda l: not l.display_type)"/>
                    <t t-if="lines">
                        <t t-set="half" t-value="(len(lines) + 1) // 2"/>
                        <table border="0" cellspacing="0" cellpadding="0" style="width:100%; border-collapse:separate; border-spacing:0; border:none; margin-top:0; margin-bottom:8px;">
                            <tr style="border:none;">
                                <!-- TABEL KIRI -->
                                <td style="width:50%; vertical-align:top; padding-right:4px; border:none;">
                                    <table class="checklist-tbl">
                                        <thead>
                                            <tr>
                                                <th style="width:52%; text-align:left; padding:4px 6px !important;">Item Checklist</th>
                                                <th style="width:24%; text-align:center; padding:4px 3px !important;">Status</th>
                                                <th style="width:24%; text-align:left; padding:4px 6px !important;">Remarks</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="lines[:half]" t-as="line">
                                                <tr t-att-style="'background-color:#F2F7FC;' if line_index % 2 == 0 else ''">
                                                    <td style="padding:3px 6px !important;"><t t-esc="line.checklist_id.name if line.checklist_id else '-'"/></td>
                                                    <td style="text-align:center; padding:3px !important; font-size:8.5px;">
                                                        <t t-if="line.condition == 'baik'"><span style="color:#1b5e20; font-weight:bold;">Baik</span></t>
                                                        <t t-elif="line.condition == 'tidak_ada'"><span style="color:#777;">Tidak Ada</span></t>
                                                        <t t-elif="line.condition == 'rusak'"><span style="color:#b71c1c; font-weight:bold;">Rusak</span></t>
                                                        <t t-elif="line.condition == 'hilang'"><span style="color:#e65100; font-weight:bold;">Hilang</span></t>
                                                        <t t-elif="line.selection_id"><span style="font-weight:bold;"><t t-esc="line.selection_id.name"/></span></t>
                                                        <t t-else="">-</t>
                                                    </td>
                                                    <td style="padding:3px 6px !important;"><t t-esc="line.remarks or ''"/></td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </td>
                                <!-- TABEL KANAN -->
                                <td style="width:50%; vertical-align:top; padding-left:4px; border:none;">
                                    <table class="checklist-tbl">
                                        <thead>
                                            <tr>
                                                <th style="width:52%; text-align:left; padding:4px 6px !important;">Item Checklist</th>
                                                <th style="width:24%; text-align:center; padding:4px 3px !important;">Status</th>
                                                <th style="width:24%; text-align:left; padding:4px 6px !important;">Remarks</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="lines[half:]" t-as="line">
                                                <tr t-att-style="'background-color:#F2F7FC;' if line_index % 2 == 0 else ''">
                                                    <td style="padding:3px 6px !important;"><t t-esc="line.checklist_id.name if line.checklist_id else '-'"/></td>
                                                    <td style="text-align:center; padding:3px !important; font-size:8.5px;">
                                                        <t t-if="line.condition == 'baik'"><span style="color:#1b5e20; font-weight:bold;">Baik</span></t>
                                                        <t t-elif="line.condition == 'tidak_ada'"><span style="color:#777;">Tidak Ada</span></t>
                                                        <t t-elif="line.condition == 'rusak'"><span style="color:#b71c1c; font-weight:bold;">Rusak</span></t>
                                                        <t t-elif="line.condition == 'hilang'"><span style="color:#e65100; font-weight:bold;">Hilang</span></t>
                                                        <t t-elif="line.selection_id"><span style="font-weight:bold;"><t t-esc="line.selection_id.name"/></span></t>
                                                        <t t-else="">-</t>
                                                    </td>
                                                    <td style="padding:3px 6px !important;"><t t-esc="line.remarks or ''"/></td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </td>
                            </tr>
                        </table>
                    </t>
                    <t t-else="">
                        <table class="checklist-tbl" style="margin-bottom:8px;">
                            <tbody>
                                <tr><td style="text-align:center; color:#999; padding:8px !important;">Tidak ada data checklist.</td></tr>
                            </tbody>
                        </table>
                    </t>

                    <!-- REMARKS MASUK -->
                    <table class="bt">
                        <tbody>
                            <tr>
                                <td class="lbl" style="width:25%;">Remarks (Masuk)</td>
                                <td><t t-esc="doc.remarks_masuk or '-'"/></td>
                            </tr>
                        </tbody>
                    </table>

                    <!-- FOTO MASUK -->
                    <t t-if="doc.image_masuk_ids">
                        <div style="margin-top:20px;">
                            <div class="sec-title" style="margin-bottom:10px;">Foto (Masuk)</div>
                            <div style="width:100%;">
                                <t t-foreach="doc.image_masuk_ids" t-as="img">
                                    <div style="width:23.5%; display:inline-block; vertical-align:top; margin-right:1%; margin-bottom:10px; text-align:center; border:1px solid #BDD7EE; padding:5px; border-radius:3px; box-sizing:border-box;">
                                        <t t-if="img.annotated_image">
                                            <img t-att-src="image_data_uri(img.annotated_image)" style="max-width:100%; max-height:110px; display:block; margin:auto;"/>
                                        </t>
                                        <t t-else="">
                                            <img t-att-src="image_data_uri(img.image)" style="max-width:100%; max-height:110px; display:block; margin:auto;"/>
                                        </t>
                                        <p style="font-size:9.5px; margin:4px 0 0 0; color:#555; word-break:break-all; font-weight:bold; line-height:1.2;"><t t-esc="img.name"/></p>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </t>

                    <!-- LAMPIRAN MASUK -->
                    <t t-if="doc.attachment_masuk_ids">
                        <t t-set="img_attachments_masuk" t-value="doc.attachment_masuk_ids.filtered(lambda a: a.mimetype and a.mimetype.startswith('image/'))"/>
                        <t t-set="non_img_masuk" t-value="doc.attachment_masuk_ids.filtered(lambda a: not (a.mimetype and a.mimetype.startswith('image/')))"/>
                        <t t-if="img_attachments_masuk or non_img_masuk">
                            <div style="margin-top:20px;">
                                <div class="sec-title" style="margin-bottom:10px;">Lampiran Lainnya (Masuk)</div>
                                <div t-if="img_attachments_masuk" style="width:100%;">
                                    <t t-foreach="img_attachments_masuk" t-as="att">
                                        <div style="width:23.5%; display:inline-block; vertical-align:top; margin-right:1%; margin-bottom:10px; text-align:center; border:1px solid #BDD7EE; padding:5px; border-radius:3px; box-sizing:border-box;">
                                            <img t-att-src="'/web/image/%s' % att.id" style="max-width:100%; max-height:110px; display:block; margin:auto;"/>
                                            <p style="font-size:9.5px; margin:4px 0 0 0; color:#555; word-break:break-all; line-height:1.2;"><t t-esc="att.name"/></p>
                                        </div>
                                    </t>
                                </div>
                                <t t-if="non_img_masuk">
                                    <p style="font-size:11px; margin-top:10px; margin-bottom:4px; font-weight:bold; color:#1F3864;">File Lampiran Lainnya:</p>
                                    <ul style="font-size:11px; margin:0; padding-left:20px;">
                                        <t t-foreach="non_img_masuk" t-as="att_file">
                                            <li style="padding:2px 0;"><t t-esc="att_file.name"/></li>
                                        </t>
                                    </ul>
                                </t>
                            </div>
                        </t>
                    </t>

                    <!-- TANDA TANGAN MASUK -->
                    <table border="0" cellspacing="0" cellpadding="0" style="width:100%; border-collapse:separate; border-spacing:0; border:none; margin-top:10px; margin-bottom:20px;">
                        <tr style="border:none;">
                            <td style="width:50%; text-align:center; padding:8px 16px; border:none; vertical-align:top;">
                                <p style="font-weight:bold; margin-bottom:10px; color:#1F3864;">Tanda Tangan Pelanggan</p>
                                <t t-if="doc.customer_sign_masuk">
                                    <img t-att-src="'data:image/png;base64,' + doc.customer_sign_masuk.decode('utf-8')"
                                         style="max-height:80px; max-width:200px; display:block; margin:auto;"/>
                                </t>
                                <t t-else="">
                                    <div style="height:70px; border-bottom:1px solid #1F3864; margin:0 40px;"></div>
                                </t>
                                <t t-if="doc.customer_name_masuk">
                                    <p style="margin-top:6px; margin-bottom:0; font-size:11px; font-weight:bold;">( <t t-esc="doc.customer_name_masuk"/> )</p>
                                    <p style="margin-top:2px; font-size:10px; color:#555;">( <t t-esc="doc.partner_id.name if doc.partner_id else '.......................'"/> )</p>
                                </t>
                                <t t-else="">
                                    <p style="margin-top:6px; font-size:11px;">( <t t-esc="doc.partner_id.name if doc.partner_id else '.......................'"/> )</p>
                                </t>
                                <t t-if="doc.customer_date_masuk">
                                    <p style="margin-top:2px; font-size:10px; color:#333;">Tanggal: <span t-field="doc.customer_date_masuk" t-options='{"widget": "date"}'/></p>
                                </t>
                                <t t-else="">
                                    <p style="margin-top:2px; font-size:10px; color:#333;">Tanggal: -</p>
                                </t>
                            </td>
                            <td style="width:50%; text-align:center; padding:8px 16px; border:none; vertical-align:top;">
                                <p style="font-weight:bold; margin-bottom:10px; color:#1F3864;">Tanda Tangan Cakrawala</p>
                                <t t-if="doc.cakrawala_sign_masuk">
                                    <img t-att-src="'data:image/png;base64,' + doc.cakrawala_sign_masuk.decode('utf-8')"
                                         style="max-height:80px; max-width:200px; display:block; margin:auto;"/>
                                </t>
                                <t t-else="">
                                    <div style="height:70px; border-bottom:1px solid #1F3864; margin:0 40px;"></div>
                                </t>
                                <t t-if="doc.cakrawala_name_masuk">
                                    <p style="margin-top:6px; margin-bottom:0; font-size:11px; font-weight:bold;">( <t t-esc="doc.cakrawala_name_masuk"/> )</p>
                                    <p style="margin-top:2px; font-size:10px; color:#555;">( Cakrawala )</p>
                                </t>
                                <t t-else="">
                                    <p style="margin-top:6px; font-size:11px;">( Cakrawala )</p>
                                </t>
                                <t t-if="doc.cakrawala_date_masuk">
                                    <p style="margin-top:2px; font-size:10px; color:#333;">Tanggal: <span t-field="doc.cakrawala_date_masuk" t-options='{"widget": "date"}'/></p>
                                </t>
                                <t t-else="">
                                    <p style="margin-top:2px; font-size:10px; color:#333;">Tanggal: -</p>
                                </t>
                            </td>
                        </tr>
                    </table>

                </div>
            </t>
        </t>
    </t>
</template>
</odoo>
