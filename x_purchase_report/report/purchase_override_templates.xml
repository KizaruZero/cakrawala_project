<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="purchase.action_report_purchase_order" model="ir.actions.report" forcecreate="False">
    <field name="report_name">x_purchase_report.report_purchase_order_custom</field>
    <field name="report_file">x_purchase_report.report_purchase_order_custom</field>
  </record>
  <record id="report_purchase_order_custom_action" model="ir.actions.report">
    <field name="name">Purchase Order Custom</field>
    <field name="model">purchase.order</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">x_purchase_report.report_purchase_order_custom</field>
    <field name="report_file">x_purchase_report.report_purchase_order_custom</field>
    <field name="binding_model_id" ref="purchase.model_purchase_order"/>
    <field name="binding_type">report</field>
  </record>
  <record id="purchase_order_form_inherit_print" model="ir.ui.view">
    <field name="name">purchase.order.form.inherit.print.custom</field>
    <field name="model">purchase.order</field>
    <field name="inherit_id" ref="purchase.purchase_order_form"/>
    <field name="arch" type="xml">
      <xpath expr="//button[@name='print_quotation']" position="attributes">
        <attribute name="name">action_print_custom</attribute>
        <attribute name="type">object</attribute>
      </xpath>
    </field>
  </record>
</odoo>