<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_purchase_order_custom">
        <t t-set="o" t-value="docs and docs[0]"/>
        <t t-set="company" t-value="o.company_report_id or o.company_id"/>
        <t t-set="report_type" t-value="'pdf'"/>
        <t t-call="x_purchase_report.external_layout_bubble">
            <main>
                <t t-foreach="docs" t-as="o">
                    <div class="page" style="position:relative; font-family:Arial,sans-serif; font-size:11px; color:#2b477c;">
                        <t t-if="o.state == 'cancel'">
                            <img src="/x_purchase_report/static/img/cancelled_logo_rotate.png" style="position:fixed; top:40%; left:-15%; width:1200px; opacity:.22;"/>
                        </t>
                        <t t-elif="o.state not in ('purchase', 'done')">
                            <img src="/x_purchase_report/static/img/draft_logo_rotate.png" alt="DRAFT"
                                 style="position:absolute; top:220px; left:20%; width:60%; opacity:.13; z-index:0;"/>
                        </t>
                        <div style="text-align:right; margin:0 0 10px 0;">
                            <h2 style="margin:0; color:#e34a00; font-size:25px; font-weight:700;">
                                <t t-if="o.state == 'cancel'">Cancelled Purchase Order #</t>
                                <t t-elif="o.state in ('purchase', 'done')">Purchase Order #</t>
                                <t t-else="">Request for Quotation #</t>
                                <t t-esc="o.name"/>
                            </h2>
                        </div>

                        <table style="width:100%; border:1px solid #617eb5; border-collapse:collapse; margin-bottom:9px;">
                            <tr>
                                <td style="width:50%; vertical-align:top; padding:8px 12px; border-right:1px solid #b7c7e1;">
                                    <strong style="color:#0066d9; font-size:12px;">Vendor</strong>
                                    <div t-field="o.partner_id" t-options='{"widget":"contact","fields":["name","address","phone"],"no_marker":True}'/>
                                </td>
                                <td style="width:50%; vertical-align:top; padding:8px 12px;">
                                    <strong style="color:#0066d9; font-size:12px;">Shipping Address</strong>
                                    <t t-if="o.dest_address_id">
                                        <div t-field="o.dest_address_id" t-options='{"widget":"contact","fields":["name","address","phone"],"no_marker":True}'/>
                                    </t>
                                    <t t-elif="o.picking_type_id.warehouse_id.partner_id">
                                        <div t-field="o.picking_type_id.warehouse_id.partner_id" t-options='{"widget":"contact","fields":["name","address","phone"],"no_marker":True}'/>
                                    </t>
                                    <div t-if="company.po_contact_up">UP: <span t-esc="company.po_contact_up"/></div>
                                    <div t-if="company.po_contact_mobile">No. HP: <span t-esc="company.po_contact_mobile"/></div>
                                </td>
                            </tr>
                        </table>

                        <div style="text-align:right; margin:0 0 9px 0;">
                            <table style="display:inline-table; border:1px solid #617eb5; border-collapse:collapse; min-width:315px;">
                                <tr>
                                    <td style="padding:5px 9px; color:#0066d9; font-weight:700; white-space:nowrap;">Confirm Receipt Date:</td>
                                    <td style="padding:5px 9px; min-width:180px;">
                                        <span t-esc="o._po_report_date(o.effective_date) or '-'"/>
                                    </td>
                                </tr>
                            </table>
                        </div>

                        <table style="width:100%; border-collapse:collapse; margin-bottom:7px;">
                            <thead>
                                <tr style="background:#e44b00; color:white;">
                                    <th style="width:47%; padding:9px 7px; border:1px solid #bbc8e0; text-align:left;">DESCRIPTION</th>
                                    <th style="width:11%; padding:9px 7px; border:1px solid #bbc8e0; text-align:center;">QTY</th>
                                    <th style="width:18%; padding:9px 7px; border:1px solid #bbc8e0; text-align:right;">UNIT PRICE</th>
                                    <th style="width:11%; padding:9px 7px; border:1px solid #bbc8e0; text-align:right;">FIX DISC.</th>
                                    <th style="width:13%; padding:9px 7px; border:1px solid #bbc8e0; text-align:right;">AMOUNT</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o._po_report_lines()" t-as="line">
                                    <td style="padding:8px 7px; border:1px solid #d5dce9;">
                                        <strong t-esc="line.product_id.display_name or line.name"/>
                                        <div t-if="line.name and line.name != line.product_id.display_name" style="font-size:10px; color:#859ac8;" t-esc="line.name"/>
                                    </td>
                                    <td style="padding:8px 7px; border:1px solid #d5dce9; text-align:center; white-space:nowrap;">
                                        <span t-esc="line.product_qty"/>
                                        <span t-if="line.product_uom_id" t-esc="' ' + line.product_uom_id.name"/>
                                    </td>
                                    <td style="padding:8px 7px; border:1px solid #d5dce9; text-align:right; white-space:nowrap;">
                                        <span t-out="line.price_unit" t-options="{'widget':'monetary','display_currency':o.currency_id}"/>
                                    </td>
                                    <td style="padding:8px 7px; border:1px solid #d5dce9; text-align:right; white-space:nowrap;">
                                        <span t-out="line.fixed_discount or 0" t-options="{'widget':'monetary','display_currency':o.currency_id}"/>
                                    </td>
                                    <td style="padding:8px 7px; border:1px solid #d5dce9; text-align:right; white-space:nowrap;">
                                        <span t-out="line.price_total" t-options="{'widget':'monetary','display_currency':o.currency_id}"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <table style="width:38%; margin-left:62%; border-collapse:collapse; color:white; background:#e44b00; margin-bottom:11px;">
                            <tr>
                                <td style="padding:7px 10px; font-weight:700;">Total</td>
                                <td style="padding:7px 10px; text-align:right; font-weight:700; white-space:nowrap;">
                                    <span t-out="o.amount_total" t-options="{'widget':'monetary','display_currency':o.currency_id}"/>
                                </td>
                            </tr>
                        </table>

                        <div style="border:1px solid #617eb5; padding:8px 12px; margin-bottom:10px;">
                            <strong style="color:#0066d9; font-size:12px;">Leasing Partner</strong>
                            <div t-if="o.leasing_partner_id" t-field="o.leasing_partner_id" t-options='{"widget":"contact","fields":["name","address","phone"],"no_marker":True}'/>
                            <div t-else="">-</div>
                        </div>

                        <div style="width:70%; float:left;">
                            <div style="margin-bottom:7px; font-size:12px;">
                                <strong style="color:#0066d9;">Payment Terms:</strong>
                                <span t-if="o.payment_term_id" t-esc="o.payment_term_id.name"/>
                            </div>
                            <div t-if="o.note" style="border:1px solid #617eb5; padding:8px 10px;">
                                <strong style="color:#182e59;">Detail Description</strong>
                                <div t-field="o.note" style="margin-top:4px;"/>
                            </div>
                        </div>
                        <div style="width:28%; float:right; text-align:right;">
                            <div><span t-esc="company.city or ''"/>, <span t-esc="o._po_report_date(o.date_approve or o.date_order)"/></div>
                            <div t-esc="company.name"/>
                            <div style="height:85px;"/>
                            <div style="display:inline-block; min-width:230px; text-align:center; border-top:1px solid #3155a4; padding-top:5px; color:#172544;">
                                <span t-esc="company.po_sign or ''"/>
                            </div>
                        </div>
                        <div style="clear:both;"/>
                    </div>
                </t>
            </main>
        </t>
    </template>
</odoo>
