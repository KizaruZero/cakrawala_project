<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_purchase_fleet_terms" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.purchase.fleet.terms</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="purchase.res_config_settings_view_form_purchase"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='purchase_setting_container']" position="after">
                <block title="Default Syarat dan Ketentuan (Fleet)" name="purchase_fleet_terms_container">
                    <setting id="purchase_fleet_terms" string="Default Syarat dan Ketentuan" company_dependent="1"
                             help="Default Syarat dan Ketentuan di Rental Order, lalu dibawa ke Detail Description PR, PO, dan Bill">
                        <field name="purchase_fleet_terms"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

    <record id="purchase_order_form_notes_terms" model="ir.ui.view">
        <field name="name">purchase.order.form.notes.terms</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//label[@for='note']" position="before">
                <label for="x_notes" string="Notes" style="font-weight: bold; display: block;"/>
                <field name="x_notes" colspan="2" nolabel="1" placeholder="Notes dari Rental Order / Purchase Request..."/>
            </xpath>
        </field>
    </record>

    <record id="employee_purchase_requisition_form_notes_terms" model="ir.ui.view">
        <field name="name">employee.purchase.requisition.form.notes.terms</field>
        <field name="model">employee.purchase.requisition</field>
        <field name="inherit_id" ref="employee_purchase_requisition.employee_purchase_requisition_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//label[@for='detail_description']" position="before">
                <label for="x_notes" string="Notes" style="font-weight: bold; margin-top: 10px; display: block;"/>
                <field name="x_notes" readonly="state not in ['draft', 'new']" placeholder="Notes dari Rental Order..."/>
            </xpath>
        </field>
    </record>

    <record id="view_move_form_notes" model="ir.ui.view">
        <field name="name">account.move.form.notes</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[hasclass('oe_invoice_lines_tab')]//field[@name='narration']" position="before">
                <field name="x_notes" nolabel="1" placeholder="Notes..."
                       invisible="move_type not in ('in_invoice', 'in_refund')"
                       readonly="state != 'draft'"/>
            </xpath>
        </field>
    </record>
</odoo>
