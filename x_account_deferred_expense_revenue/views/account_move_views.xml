<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_deferred_items" model="ir.ui.view">
        <field name="name">account.move.form.deferred.items</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_view_deferred_entries"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-calendar"
                    invisible="deferred_entry_count == 0">
                    <field name="deferred_entry_count" widget="statinfo" string="Deferred Items"/>
                </button>
            </xpath>
            <xpath expr="//header" position="inside">
                <button
                    name="action_create_deferred_entries"
                    type="object"
                    string="Create Deferred Items"
                    invisible="state != 'posted' or move_type not in ('in_invoice', 'in_receipt', 'out_invoice', 'out_receipt') or deferred_entry_count != 0"/>
            </xpath>
        </field>
    </record>
</odoo>
