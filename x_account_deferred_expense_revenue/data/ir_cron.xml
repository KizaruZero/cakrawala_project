<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_post_deferred_entries" model="ir.cron">
        <field name="name">Post Deferred Expense / Revenue Entries</field>
        <field name="model_id" ref="model_account_deferred_entry"/>
        <field name="state">code</field>
        <field name="code">model._cron_post_due_lines()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now().replace(hour=2, minute=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="active">False</field>
    </record>
</odoo>
