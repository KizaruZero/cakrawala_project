<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_out_invoice_tree_add_soa_button" model="ir.ui.view">
        <field name="name">account.move.out.invoice.tree.create.soa</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <header>
                    <button name="action_create_statement_of_account"
                            string="Create SoA"
                            type="object"
                            class="btn-primary"/>
                </header>
            </xpath>
        </field>
    </record>
</odoo>
