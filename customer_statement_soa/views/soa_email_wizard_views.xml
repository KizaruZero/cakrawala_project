<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_soa_email_wizard_form" model="ir.ui.view">
        <field name="name">customer.statement.soa.email.wizard.form</field>
        <field name="model">customer.statement.soa.email.wizard</field>
        <field name="arch" type="xml">
            <form string="Send Statement of Account">
                <group>
                    <field name="partner_id"/>
                    <field name="email_to" widget="email"/>
                    <field name="subject"/>
                </group>
                <field name="body" widget="html"/>
                <field name="attachment_ids" widget="many2many_binary"/>
                <field name="move_ids" invisible="1"/>
                <footer>
                    <button name="action_send" string="Send" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
