<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_customer_statement" model="ir.actions.report">
        <field name="name">Customer Statement</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">customer_statement_soa.report_customer_statement_document</field>
        <field name="report_file">customer_statement_soa.report_customer_statement_document</field>
        <field name="print_report_name">'Statement of Account - %s' % (object.commercial_partner_id.name)</field>
    </record>

    <template id="report_customer_statement_document">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <t t-set="partner" t-value="docs[0].commercial_partner_id"/>
                <div class="page">
                    <h2 class="text-center">Customer Statement</h2>
                    <div class="row mt-4 mb-4">
                        <div class="col-7">
                            <strong t-esc="company.name"/><br/>
                            <span t-esc="company.partner_id.contact_address"/>
                        </div>
                        <div class="col-5 text-end">
                            <strong>NPWP:</strong> <span t-esc="company.vat or ''"/>
                        </div>
                    </div>
                    <h4 t-esc="partner.name"/>
                    <table class="table table-sm o_main_table">
                        <thead>
                            <tr>
                                <th>Invoice</th>
                                <th>Invoice Date</th>
                                <th>Due Date</th>
                                <th class="text-end">Amount Due</th>
                                <th class="text-end">Aging</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="total_due" t-value="0.0"/>
                            <tr t-foreach="docs.sorted(lambda m: (m.invoice_date or m.date, m.name))" t-as="move">
                                <td t-esc="move.name"/>
                                <td t-esc="format_date(move.invoice_date) if move.invoice_date else ''"/>
                                <td t-esc="format_date(move.invoice_date_due) if move.invoice_date_due else ''"/>
                                <td class="text-end" t-esc="formatLang(move.amount_residual, currency_obj=move.currency_id)"/>
                                <td class="text-end" t-esc="move._soa_aging_label()"/>
                                <t t-set="total_due" t-value="total_due + move.amount_residual"/>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr>
                                <th colspan="3">Total</th>
                                <th class="text-end" t-esc="formatLang(total_due, currency_obj=docs[0].currency_id)"/>
                                <th/>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
