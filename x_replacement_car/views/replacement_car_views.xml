<odoo>

    <record id="view_replacement_approval_master_list" model="ir.ui.view">
        <field name="name">master.approval.list</field>
        <field name="model">master.approval</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" required="1"/>
                <field name="approver_id" required="1"/>
            </list>
        </field>
    </record>

    <record id="action_replacement_approval_master" model="ir.actions.act_window">
        <field name="name">Master Approval Replacement</field>
        <field name="res_model">master.approval</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_replacement_car" model="ir.actions.act_window">
        <field name="name">Replacement Car</field>
        <field name="res_model">replacement.car</field>
        <field name="view_mode">list,form</field>
    </record>


    <menuitem
        id="menu_replacement_car"
        name="Replacement Car"
        parent="fleet.menu_root"
        action="action_replacement_car"
        sequence="50"/>

    <menuitem
        id="menu_replacement_approval_master"
        name="Master Approval Replacement"
        parent="x_replacement_car.menu_replacement_car"
        action="action_replacement_approval_master"
        sequence="49"/>
    
    <menuitem id="menu_replacement_car_management"
              name="Replacement Car Management"
              parent="x_replacement_car.menu_replacement_car"
              action="action_replacement_car"
              sequence="10"/>

    <record id="view_replacement_car_list" model="ir.ui.view">
        <field name="name">replacement.car.list</field>
        <field name="model">replacement.car</field>
        <field name="arch" type="xml">
            <list create="false">
                <field name="name"/>
                <field name="customer_id"/>
                <field name="vehicle_old_id"/>
                <field name="vehicle_new_id"/>
                <field name="request_date"/>
                <field name="state"/>
                <field name="bastk_out_id" optional="show" string="BASTK Out"/>
                <field name="bastk_in_id" optional="show" string="BASTK In"/>
                <field name="bastk_duration_days" optional="show" string="RC Duration (Days)"/>
            </list>
        </field>
    </record>


    <record id="view_replacement_car_search" model="ir.ui.view">
        <field name="name">replacement.car.search</field>
        <field name="model">replacement.car</field>
        <field name="arch" type="xml">
            <search string="Replacement Car">
                <field name="name"/>
                <field name="customer_id"/>
                <field name="vehicle_old_id"/>
                <field name="vehicle_new_id"/>
                <separator/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="waiting" string="Waiting" domain="[('state', '=', 'waiting')]"/>
                <filter name="approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <filter name="done" string="Done" domain="[('state', '=', 'done')]"/>
                <separator/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
                <separator/>
                <filter name="group_state" string="State" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="view_replacement_car_form" model="ir.ui.view">
        <field name="name">replacement.car.form</field>
        <field name="model">replacement.car</field>
        <field name="arch" type="xml">
            <form string="Replacement Car" create="false">
                <field name="active" invisible="1"/>
                <header>
                    <field name="can_approve" invisible="1"/>

                    <button name="action_submit"
                            type="object"
                            string="Submit"
                            class="btn-primary"
                            invisible="state != 'draft'"/>



                    <button name="action_done"
                            type="object"
                            string="Done"
                            class="btn-success"
                            invisible="state != 'approved'"/>
                    <button name="action_create_bastk"
                            type="object"
                            string="Create BASTK"
                            class="btn-primary"
                            invisible="state != 'approved' or bastk_count &gt; 0"/>

                    <button name="action_approve"
                            type="object"
                            string="Approve"
                            class="btn-success"
                            invisible="state != 'waiting' or not can_approve"/>

                    <button name="action_reject"
                            type="object"
                            string="Reject"
                            class="btn-danger"
                            invisible="state != 'waiting' or not can_approve"/>
                    <button name="action_reset_to_draft"
                            type="object"
                            string="Reset to Draft"
                            class="btn-warning"
                            invisible="state != 'rejected'"/>

                    <button name="%(x_replacement_car.action_report_replacement_car)d"
                            type="action"
                            string="Print Out"
                            class="btn-secondary"
                            icon="fa-print"/>

                    <field name="state" widget="statusbar" statusbar_visible="draft,waiting,approved,done"/>
                </header>

                <sheet>
                   <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                   <div class="oe_button_box" name="button_box">
                        <button name="action_view_bastk"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-file-text-o"
                                invisible="bastk_count == 0">
                            <field name="bastk_count" widget="statinfo" string="BASTK"/>
                        </button>
                        <button name="action_view_spk"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-wrench"
                                invisible="spk_count == 0">
                            <field name="spk_count" widget="statinfo" string="SPK"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" class="oe_inline"/>
                        </h1>
                    </div>

                    <group>
                        <group string="FIRST DATA FROM CLIENT">
                            <field name="customer_id" string="Company Client" readonly="state not in ('draft',)"/>
                            <field name="vehicle_old_id" string="License Plate" readonly="state not in ('draft',)" required="1"/>
                            <field name="old_vehicle_model_id" string="Vehicle" readonly="1"/>
                            <field name="old_year" string="Year" readonly="1"/>
                            <field name="old_color" string="Color" readonly="1"/>
                        </group>
                        <group string="REPLACEMENT CAR REQUEST DATA">
                            <field name="can_fill_request_data" invisible="1"/>
                            <field name="vehicle_new_id" string="License Plate"
                                   required="can_fill_request_data"
                                   readonly="state != 'draft' and not can_fill_request_data"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="new_vehicle_model_id" string="Vehicle" readonly="1"/>
                            <field name="new_year" string="Year" readonly="1"/>
                            <field name="new_color" string="Color" readonly="1"/>
                        </group>
                    </group>
                <notebook>
                    <page string="Detail">
                        <group>
                            <group>
                                <field name="request_date" readonly="state not in ('draft',)"/>
                                <field name="pic_name" readonly="state not in ('draft',)"/>
                                <field name="estimation_use_date" readonly="state not in ('draft',)"/>
                                <label for="duration"/>
                                <div class="d-flex align-items-center gap-2">
                                    <field name="duration" readonly="state not in ('draft',)" class="oe_inline" style="max-width: 80px;"/>
                                    <field name="duration_unit" readonly="state not in ('draft',)" class="oe_inline" style="max-width: 110px;"/>
                                </div>
                                <separator string="BASTK Tracking" invisible="not bastk_out_id and not bastk_in_id"/>
                                <field name="bastk_out_id" readonly="1" invisible="not bastk_out_id"/>
                                <field name="bastk_in_id" readonly="1" invisible="not bastk_in_id"/>
                                <label for="bastk_duration_days" string="RC Duration" invisible="not bastk_out_id"/>
                                <div class="d-flex align-items-center gap-2" invisible="not bastk_out_id">
                                    <field name="bastk_duration_days" readonly="1" class="oe_inline"/>
                                    <span>Days</span>
                                </div>
                            </group>
                            <group>
                                <field name="reason" readonly="state not in ('draft',)"/>
                            </group>
                        </group>
                        <group name="group_references" string="References">
                            <field name="spk_reference_id" readonly="1" invisible="not spk_reference_id"/>
                        </group>
                    </page>

                    <page string="Matrix Approval">
                        <field name="approval_line_ids" readonly="1">
                            <list editable="bottom">
                                <field name="sequence" widget="handle" invisible="1"/>
                                <field name="approver_id"/>
                                <field name="state"/>
                                <field name="approval_date"/>
                                <field name="reject_date" invisible="1"/>
                                <field name="notes"/>
                            </list>
                        </field>
                    </page>

                </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_picking_form_inherit_replacement"
            model="ir.ui.view">

        <field name="name">
            stock.picking.form.replacement
        </field>

        <field name="model">stock.picking</field>

        <field name="inherit_id"
               ref="x_stock_asset_receipt.view_picking_form_inherit_asset"/>

        <field name="arch" type="xml">
            <xpath expr="//field[@name='is_replace']" position="after">
                <field name="replacement_car"
                        readonly="1"
                        force_save="1"/>

            </xpath>

        </field>

    </record>

</odoo>
