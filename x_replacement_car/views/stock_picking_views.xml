      <field name="name">stock.picking.form.inherit.rc.hide.forecast</field>
      <field name="model">stock.picking</field>
      <field name="inherit_id" ref="stock.view_picking_form"/>
      <field name="arch" type="xml">
        <xpath expr="//field[@name='move_ids']//list//field[@name='forecast_availability']"
               position="attributes">
          <attribute name="column_invisible">1</attribute>
        </xpath>
      </field>
    </record>
  </data>
</odoo>
