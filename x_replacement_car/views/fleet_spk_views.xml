<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="fleet_spk_form_replacement_car" model="ir.ui.view">
    <field name="name">fleet.spk.form.replacement.car</field>
    <field name="model">fleet.spk</field>
    <field name="inherit_id" ref="x_spk.fleet_spk_form"/>
    <field name="arch" type="xml">
      <xpath expr="//header" position="inside">
        <button
            name="action_create_replacement_car"
            type="object"
            string="Replacement Car"
            class="btn-secondary"
            invisible="not unit_breakdown or state != 'approved'"
        />
      </xpath>

      <xpath expr="//div[@name='button_box']" position="inside">
        <button name="action_view_replacement_car"
                type="object"
                class="oe_stat_button"
                icon="fa-car"
                invisible="replacement_car_count == 0">
          <field name="replacement_car_count" widget="statinfo" string="Replacement Car"/>
        </button>
      </xpath>
    </field>
  </record>
</odoo>
