<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_replacement_car_lead_time" model="ir.cron">
            <field name="name">Replacement Car: refresh lead time</field>
            <field name="model_id" ref="model_replacement_car"/>
            <field name="state">code</field>
            <field name="code">model.with_context(tz='Asia/Jakarta').cron_refresh_lead_time()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <!-- 17:00 UTC is 00:00 in Jakarta. -->
            <field name="nextcall" eval="DateTime.now().replace(hour=17, minute=0, second=0).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="priority">5</field>
        </record>
    </data>
</odoo>
