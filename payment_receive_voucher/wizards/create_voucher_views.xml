<odoo>
    <record id="create_payment_voucher_wizard_form" model="ir.ui.view">
        <field name="name">prv.voucher.create.form</field>
        <field name="model">prv.voucher.create</field>
        <field name="arch" type="xml">
            <form string="Create Payment Voucher">
                <group>
                    <field name="move_ids" widget="many2many_tags"/>
                    <field name="company_id" invisible="True"/>
                </group>
                <div class="alert alert-info" role="alert">Please verify the selected bills and outstanding amounts. Continue to create a Payment Voucher?</div>
                <footer>
                    <button name="action_confirm" type="object" string="Create Payment Voucher" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
