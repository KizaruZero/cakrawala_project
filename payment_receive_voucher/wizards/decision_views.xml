<odoo>
    <record id="decision_form" model="ir.ui.view">
        <field name="name">prv.voucher.decision.form</field><field name="model">prv.voucher.decision</field>
        <field name="arch" type="xml"><form string="Voucher Decision"><group>
            <field name="voucher_id"/><field name="decision" invisible="True"/><field name="remarks" string="Notes" required="decision == 'reject'" placeholder="Add approval notes or a rejection reason..."/>
        </group><footer>
            <button name="action_confirm" string="Approve" type="object" class="btn-success" invisible="decision != 'approve'"/>
            <button name="action_confirm" string="Reject" type="object" class="btn-danger" invisible="decision != 'reject'"/>
            <button string="Close" special="cancel" class="btn-secondary"/>
        </footer></form></field>
    </record>
</odoo>
