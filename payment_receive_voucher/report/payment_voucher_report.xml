            <div class="page"><div style="border-top:1px solid #aab2bd;margin:18px 12px 18px 12px;"/><h2>Payment Voucher</h2>
                <div class="row mb-3">
                    <div class="col-6">
                        <div class="mb-1"><strong>Voucher:</strong> <span t-field="doc.name"/></div>
                        <div class="mb-1" style="white-space:normal;word-wrap:break-word;"><strong>Vendor:</strong> <span t-field="doc.partner_summary" style="white-space:normal;word-wrap:break-word;"/></div>
                        <div class="mb-1"><strong>Payment Voucher Type:</strong> <span t-field="doc.payment_voucher_type_id"/></div>
                        <div class="mb-1"><strong>Currency:</strong> <span t-field="doc.currency_id"/></div>
                        <div class="mb-1" style="white-space:normal;word-wrap:break-word;"><strong>Analytic:</strong> <span t-esc="doc._get_analytic_summary()" style="white-space:normal;word-wrap:break-word;"/></div>
                    </div>
                    <div class="col-6">
                        <div class="mb-1"><strong>Date:</strong> <span t-field="doc.date"/></div>
                        <div class="mb-1"><strong>Company:</strong> <span t-field="doc.company_id"/></div>
                        <div class="mb-1" style="white-space:normal;word-wrap:break-word;"><strong>Bank Name:</strong> <span t-field="doc.vendor_bank_name" style="white-space:normal;word-wrap:break-word;"/></div>
                        <div class="mb-1" style="white-space:normal;word-wrap:break-word;"><strong>Bank Account Number:</strong> <span t-field="doc.vendor_bank_account" style="white-space:normal;word-wrap:break-word;"/></div>
                        <div class="mb-1" style="white-space:normal;word-wrap:break-word;"><strong>Account Holder Name:</strong> <span t-field="doc.vendor_account_holder" style="white-space:normal;word-wrap:break-word;"/></div>
                    </div>
                </div>
                <h3>Summary</h3><table class="table table-sm table-bordered" style="width:640px;max-width:100%;table-layout:fixed;"><colgroup><col style="width:330px;"/><col style="width:100px;"/><col style="width:210px;"/></colgroup>
                    <thead><tr><th style="font-weight:bold;text-align:center;background-color:#eaf2f8;padding:3px 5px;">Item</th><th style="font-weight:bold;text-align:center;background-color:#eaf2f8;padding:3px 4px;white-space:nowrap;">Quantity</th><th style="font-weight:bold;text-align:center;background-color:#eaf2f8;padding:3px 5px;white-space:nowrap;">Amount</th></tr></thead>
                    <tbody><t t-foreach="doc._get_print_summary_lines()" t-as="row"><tr t-att-class="'table-light' if row['kind'] == 'tax' else ''"><td style="padding:3px 5px;word-wrap:break-word;"><span t-esc="row['label']"/></td><td class="text-end" style="padding:3px 4px;white-space:nowrap;"><span t-if="row['quantity']" t-esc="row['quantity']"/></td><td class="text-end" style="padding:3px 5px;white-space:nowrap;"><span t-esc="row['amount']" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/></td></tr></t></tbody>
                    <tfoot><tr><th colspan="2" style="font-weight:bold;text-align:center;background-color:#eaf2f8;">Bill Total</th><th class="text-end" style="font-weight:bold;text-align:center;background-color:#eaf2f8;padding:3px 5px;white-space:nowrap;"><span t-esc="sum(doc.bill_ids.mapped('original_total'))" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/></th></tr></tfoot>
                </table><div class="mt-3"><strong>Notes:</strong> <span t-field="doc.notes"/></div>
            </div>
        </t></t></t>
    </template>
</odoo>
