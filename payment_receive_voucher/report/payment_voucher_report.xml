<odoo>
    <record id="action_report_payment_voucher" model="ir.actions.report">
        <field name="name">Print PV Detail</field><field name="model">prv.voucher</field>
        <field name="report_type">qweb-pdf</field><field name="report_name">payment_receive_voucher.report_payment_voucher_document</field>
        <field name="report_file">payment_receive_voucher.report_payment_voucher_document</field>
        <field name="binding_model_id" ref="model_prv_voucher"/><field name="binding_type">report</field><field name="binding_view_types">form</field>
        <field name="group_ids" eval="[(4, ref('payment_receive_voucher.group_voucher_user'))]"/>
        <field name="domain">[('voucher_type', '=', 'payment')]</field>
        <field name="print_report_name">'Payment Voucher - %s' % (object.name)</field>
    </record>
    <record id="action_report_payment_voucher_summary" model="ir.actions.report">
        <field name="name">Print PV Summary Only</field><field name="model">prv.voucher</field>
        <field name="report_type">qweb-pdf</field><field name="report_name">payment_receive_voucher.report_payment_voucher_summary</field>
        <field name="report_file">payment_receive_voucher.report_payment_voucher_summary</field>
        <field name="binding_model_id" ref="model_prv_voucher"/><field name="binding_type">report</field><field name="binding_view_types">form</field>
        <field name="group_ids" eval="[(4, ref('payment_receive_voucher.group_voucher_user'))]"/>
        <field name="domain">[('voucher_type', '=', 'payment')]</field>
        <field name="print_report_name">'Payment Voucher Summary - %s' % (object.name)</field>
    </record>
    <template id="report_payment_voucher_document">
        <t t-call="web.html_container"><t t-foreach="docs" t-as="doc"><t t-set="o" t-value="doc"/><t t-call="web.external_layout">
            <div class="page"><div style="border-top:1px solid #aab2bd;margin:18px 12px 18px 12px;"/><h2>Payment Voucher</h2>
                <div class="row mb-3">
                    <div class="col-6">
                        <div class="mb-1"><strong>Voucher:</strong> <span t-field="doc.name"/></div>
                        <div class="mb-1" style="white-space:normal;word-wrap:break-word;"><strong>Vendor:</strong> <span t-field="doc.partner_summary" style="white-space:normal;word-wrap:break-word;"/></div>
                        <div class="mb-1"><strong>Payment Voucher Type:</strong> <span t-field="doc.payment_voucher_type_id"/></div>
                        <div class="mb-1"><strong>Currency:</strong> <span t-field="doc.currency_id"/></div>
                        <div class="mb-1" style="white-space:normal;word-wrap:break-word;"><strong>Analytic:</strong> <span t-esc="doc._get_analytic_summary()" style="white-space:normal;word-wrap:break-word;"/></div>
                    </div>
                    <div class="col-6">
                        <div class="mb-1"><strong>Date:</strong> <span t-field="doc.date"/></div>
                        <div class="mb-1"><strong>Company:</strong> <span t-field="doc.company_id"/></div>
                        <div class="mb-1" style="white-space:normal;word-wrap:break-word;"><strong>Bank Name:</strong> <span t-field="doc.vendor_bank_name" style="white-space:normal;word-wrap:break-word;"/></div>
                        <div class="mb-1" style="white-space:normal;word-wrap:break-word;"><strong>Bank Account Number:</strong> <span t-field="doc.vendor_bank_account" style="white-space:normal;word-wrap:break-word;"/></div>
                        <div class="mb-1" style="white-space:normal;word-wrap:break-word;"><strong>Account Holder Name:</strong> <span t-field="doc.vendor_account_holder" style="white-space:normal;word-wrap:break-word;"/></div>
                    </div>
                </div>
                <h3>Summary</h3><table class="table table-sm table-bordered" style="width:640px;max-width:100%;table-layout:fixed;"><colgroup><col style="width:330px;"/><col style="width:100px;"/><col style="width:210px;"/></colgroup>
                    <thead><tr><th style="font-weight:bold;text-align:center;background-color:#eaf2f8;padding:3px 5px;">Item</th><th style="font-weight:bold;text-align:center;background-color:#eaf2f8;padding:3px 4px;white-space:nowrap;">Quantity</th><th style="font-weight:bold;text-align:center;background-color:#eaf2f8;padding:3px 5px;white-space:nowrap;">Amount</th></tr></thead>
                    <tbody><t t-foreach="doc._get_print_summary_lines()" t-as="row"><tr t-att-class="'table-light' if row['kind'] == 'tax' else ''"><td style="padding:3px 5px;word-wrap:break-word;"><span t-esc="row['label']"/></td><td class="text-end" style="padding:3px 4px;white-space:nowrap;"><span t-if="row['quantity']" t-esc="row['quantity']"/></td><td class="text-end" style="padding:3px 5px;white-space:nowrap;"><span t-esc="row['amount']" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/></td></tr></t></tbody>
                    <tfoot><tr><th colspan="2" style="font-weight:bold;text-align:center;background-color:#eaf2f8;">Bill Total</th><th class="text-end" style="font-weight:bold;text-align:center;background-color:#eaf2f8;padding:3px 5px;white-space:nowrap;"><span t-esc="sum(doc.bill_ids.mapped('original_total'))" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/></th></tr></tfoot>
                </table>
                <h3 class="mt-4">Bill Details</h3><table class="table table-sm table-bordered"><thead><tr>
                    <th style="font-weight:bold;text-align:center;background-color:#eaf2f8;">Bill</th><th style="font-weight:bold;text-align:center;background-color:#eaf2f8;">Product</th><th style="font-weight:bold;text-align:center;background-color:#eaf2f8;">Description</th><th style="font-weight:bold;text-align:center;background-color:#eaf2f8;">Account</th>
                    <th style="font-weight:bold;text-align:center;background-color:#eaf2f8;">Analytic</th><th style="font-weight:bold;text-align:center;background-color:#eaf2f8;">Quantity</th><th style="font-weight:bold;text-align:center;background-color:#eaf2f8;">Unit Price</th><th style="font-weight:bold;text-align:center;background-color:#eaf2f8;">Discount %</th><th style="font-weight:bold;text-align:center;background-color:#eaf2f8;">Taxes</th><th style="font-weight:bold;text-align:center;background-color:#eaf2f8;">Subtotal</th>
                </tr></thead><tbody><tr t-foreach="doc.detail_ids" t-as="line">
                    <td><span t-field="line.bill_name"/></td><td><span t-field="line.product"/></td><td><span t-field="line.description"/></td><td><span t-field="line.account"/></td><td><span t-field="line.analytic"/></td>
                    <td class="text-end"><span t-field="line.quantity"/></td><td class="text-end"><span t-field="line.unit_price" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/></td><td class="text-end"><span t-field="line.discount"/></td><td><span t-field="line.taxes"/></td><td class="text-end"><span t-field="line.subtotal" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/></td>
                </tr></tbody></table><div class="mt-3"><strong>Notes:</strong> <span t-field="doc.notes"/></div>
            </div>
        </t></t></t>
    </template>
    <template id="report_payment_voucher_summary">
