<odoo>
    <record id="privilege_voucher" model="res.groups.privilege">
        <field name="name">Vouchers</field>
        <field name="category_id" ref="base.module_category_accounting"/>
        <field name="sequence">25</field>
    </record>
    <record id="group_voucher_user" model="res.groups">
        <field name="name">Voucher User</field>
        <field name="privilege_id" ref="privilege_voucher"/>
        <field name="sequence">10</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_voucher_approver" model="res.groups">
        <field name="name">Voucher Approver</field>
        <field name="privilege_id" ref="privilege_voucher"/>
        <field name="sequence">20</field>
        <field name="implied_ids" eval="[(4, ref('group_voucher_user'))]"/>
    </record>
    <record id="group_voucher_manager" model="res.groups">
        <field name="name">Voucher Manager</field>
        <field name="privilege_id" ref="privilege_voucher"/>
        <field name="sequence">30</field>
        <field name="implied_ids" eval="[(4, ref('group_voucher_approver'))]"/>
    </record>
</odoo>
