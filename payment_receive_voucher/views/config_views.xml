<odoo>
    <record id="config_list" model="ir.ui.view">
        <field name="name">prv.voucher.config.list</field><field name="model">prv.voucher.config</field>
        <field name="arch" type="xml"><list><field name="name"/><field name="company_id"/><field name="voucher_type"/><field name="require_same_partner"/><field name="show_pay_button"/><field name="active"/></list></field>
    </record>
    <record id="config_form" model="ir.ui.view">
        <field name="name">prv.voucher.config.form</field><field name="model">prv.voucher.config</field>
        <field name="arch" type="xml"><form><sheet>
            <div class="oe_title"><h1><field name="name" placeholder="Approval configuration"/></h1></div>
            <group><field name="company_id"/><field name="voucher_type"/><field name="active"/><field name="require_same_partner"/><field name="show_pay_button"/><field name="currency_id"/></group>
            <div class="alert alert-info" role="alert">Every layer whose threshold is reached must approve, in layer order. Thresholds use company currency at the voucher date. Include a zero-threshold layer. Delegation dates are inclusive (UTC). Routes are frozen on submission; changes apply to future submissions.</div>
            <field name="layer_ids"><list editable="bottom">
                <field name="sequence"/><field name="approver_id"/>
                <field name="currency_id" column_invisible="True"/><field name="min_amount"/>
                <field name="delegate_id"/><field name="valid_from"/><field name="valid_until"/>
            </list></field>
        </sheet></form></field>
    </record>
    <record id="action_config" model="ir.actions.act_window">
        <field name="name">Voucher Approval Configuration</field><field name="res_model">prv.voucher.config</field><field name="view_mode">list,form</field>
    </record>
</odoo>
