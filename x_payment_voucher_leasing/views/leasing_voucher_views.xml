<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_leasing_payment_voucher_list" model="ir.ui.view">
        <field name="name">leasing.payment.voucher.list</field>
        <field name="model">leasing.payment.voucher</field>
        <field name="arch" type="xml">
            <list string="Payment Vouchers Leasing" decoration-success="state == 'approved' or state == 'paid'" decoration-muted="state in ('cancelled', 'rejected')">
                <field name="name"/>
                <field name="date"/>
                <field name="partner_summary"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="installment_count"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="amount_principal" sum="Total Pokok"/>
                <field name="amount_interest" sum="Total Bunga"/>
                <field name="amount_total" sum="Total Pembayaran"/>
                <field name="current_layer"/>
                <field name="current_approver_id"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state == 'waiting'" decoration-success="state in ('approved', 'paid')" decoration-danger="state == 'rejected'"/>
                <field name="settlement_state" widget="badge" decoration-success="settlement_state == 'paid'" decoration-warning="settlement_state == 'unpaid'"/>
            </list>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_leasing_payment_voucher_search" model="ir.ui.view">
        <field name="name">leasing.payment.voucher.search</field>
        <field name="model">leasing.payment.voucher</field>
        <field name="arch" type="xml">
            <search string="Search Payment Voucher Leasing">
                <field name="name"/>
                <field name="partner_id"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="waiting" string="Waiting Approval" domain="[('state', '=', 'waiting')]"/>
                <filter name="approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <filter name="paid" string="Paid" domain="[('state', '=', 'paid')]"/>
                <separator/>
                <filter name="mine" string="Created by Me" domain="[('create_uid', '=', uid)]"/>
                <group>
                    <filter name="group_by_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_by_partner" string="Vendor / Partner" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_by_company" string="Company" context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_leasing_payment_voucher_form" model="ir.ui.view">
        <field name="name">leasing.payment.voucher.form</field>
        <field name="model">leasing.payment.voucher</field>
        <field name="arch" type="xml">
            <form string="Payment Voucher Leasing">
                <header>
                    <button name="action_submit"
                            string="Submit"
                            type="object"
                            class="oe_highlight"
                            invisible="state != 'draft'"
                            groups="x_payment_voucher_leasing.group_leasing_voucher_user"/>

                    <button name="action_approve"
                            string="Approve"
                            type="object"
                            class="btn-success"
                            invisible="not can_decide"
                            groups="x_payment_voucher_leasing.group_leasing_voucher_approver"/>

                    <button name="action_reject"
                            string="Reject"
                            type="object"
                            class="btn-danger"
                            invisible="not can_decide"
                            groups="x_payment_voucher_leasing.group_leasing_voucher_approver"/>

                    <button name="action_open_pay_wizard"
                            string="Pay Installments"
                            type="object"
                            class="oe_highlight"
                            invisible="state != 'approved' or settlement_state == 'paid'"
                            groups="account.group_account_invoice"/>

                    <button name="action_reset"
                            string="Reset to Draft"
                            type="object"
                            class="btn-secondary"
                            invisible="not can_reset"
                            confirm="Voucher akan di-reset ke Draft dan baris angsuran leasing akan dilepaskan. Lanjutkan?"
                            groups="x_payment_voucher_leasing.group_leasing_voucher_manager"/>

                    <button name="action_cancel"
                            string="Cancel"
                            type="object"
                            invisible="state not in ('draft', 'waiting', 'approved') or settlement_state == 'paid'"
                            confirm="Apakah Anda yakin ingin membatalkan voucher ini?"
                            groups="x_payment_voucher_leasing.group_leasing_voucher_user"/>

                    <field name="state" widget="statusbar" statusbar_visible="draft,waiting,approved,paid"/>
                </header>
                <sheet>
                    <field name="can_decide" invisible="1"/>
                    <field name="can_reset" invisible="1"/>
                    <div class="oe_title">
                        <label for="name" string="No. Payment Voucher"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="voucher_type"/>
                            <field name="partner_summary"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="date"/>
                            <field name="currency_id"/>
                        </group>
                        <group>
                            <field name="installment_count"/>
                            <field name="amount_principal"/>
                            <field name="amount_interest"/>
                            <field name="amount_total"/>
                            <field name="settlement_state" widget="badge" decoration-success="settlement_state == 'paid'" decoration-warning="settlement_state == 'unpaid'"/>
                            <field name="current_layer" invisible="state != 'waiting'"/>
                            <field name="current_approver_id" invisible="state != 'waiting'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Daftar Leasing Terpilih" name="leasing_lines">
                            <field name="line_ids">
                                <list create="0" edit="0" delete="0">
                                    <field name="loan_id" string="Leasing"/>
                                    <field name="vendor_id"/>
                                    <field name="po_number"/>
                                    <field name="vehicle_id"/>
                                    <field name="license_plate"/>
                                    <field name="installment_number" string="Angs. ke"/>
                                    <field name="date" string="Tanggal"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="principal" sum="Total Pokok"/>
                                    <field name="interest" sum="Total Bunga"/>
                                    <field name="total" sum="Total"/>
                                    <field name="remaining_principal" optional="show"/>
                                    <field name="remaining_interest" optional="show"/>
                                    <field name="payment_move_id" optional="show" widget="many2one"/>
                                </list>
                            </field>
                            <group>
                                <field name="notes" placeholder="Catatan atau tujuan pengajuan voucher..." readonly="state != 'draft'"/>
                            </group>
                        </page>
                        <page string="Approval History" name="approval_history">
                            <separator string="Rute Persetujuan (Approval Route)"/>
                            <field name="step_ids" readonly="1">
                                <list create="0" edit="0" delete="0">
                                    <field name="sequence" string="Layer"/>
                                    <field name="approver_id"/>
                                    <field name="delegate_id"/>
                                    <field name="valid_from"/>
                                    <field name="valid_until"/>
                                    <field name="state" widget="badge" decoration-success="state == 'approved'" decoration-danger="state == 'rejected'" decoration-info="state == 'pending'"/>
                                    <field name="actor_id"/>
                                    <field name="acted_at"/>
                                    <field name="remarks"/>
                                </list>
                            </field>
                            <separator string="Audit Trail Log"/>
                            <field name="history_ids" readonly="1">
                                <list create="0" edit="0" delete="0">
                                    <field name="date"/>
                                    <field name="sequence" string="Layer"/>
                                    <field name="approver_id"/>
                                    <field name="actor_id"/>
                                    <field name="action"/>
                                    <field name="delegated"/>
                                    <field name="remarks"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Action Window -->
    <record id="action_leasing_payment_voucher" model="ir.actions.act_window">
        <field name="name">Payment Voucher Leasing</field>
        <field name="res_model">leasing.payment.voucher</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Buat Payment Voucher Leasing dengan memilih baris angsuran di menu Table Leasing Detail.
            </p>
        </field>
    </record>
</odoo>
