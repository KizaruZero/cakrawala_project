<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_leasing_voucher_pay_wizard_form" model="ir.ui.view">
        <field name="name">leasing.voucher.pay.wizard.form</field>
        <field name="model">leasing.voucher.pay.wizard</field>
        <field name="arch" type="xml">
            <form string="Pay Installments">
                <group>
                    <field name="voucher_id" invisible="1"/>
                    <field name="journal_id" options="{'no_create': True, 'no_open': True}"/>
                    <field name="payment_date"/>
                </group>
                <footer>
                    <button name="action_confirm_payment" string="Confirm Payment" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
