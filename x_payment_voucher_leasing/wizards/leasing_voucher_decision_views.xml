<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_leasing_voucher_decision_form" model="ir.ui.view">
        <field name="name">leasing.voucher.decision.form</field>
        <field name="model">leasing.voucher.decision</field>
        <field name="arch" type="xml">
            <form string="Voucher Approval Decision">
                <group>
                    <field name="voucher_id"/>
                    <field name="decision" invisible="1"/>
                    <field name="remarks" string="Catatan / Alasan" placeholder="Tambahkan catatan persetujuan atau alasan penolakan..." required="decision == 'reject'"/>
                </group>
                <footer>
                    <button name="action_confirm" string="Approve" type="object" class="btn-success" invisible="decision != 'approve'"/>
                    <button name="action_confirm" string="Reject" type="object" class="btn-danger" invisible="decision != 'reject'"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
