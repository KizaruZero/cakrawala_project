<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_leasing_voucher_company" model="ir.rule">
        <field name="name">Leasing Payment Voucher: multi-company</field>
        <field name="model_id" ref="model_leasing_payment_voucher"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_leasing_voucher_config_company" model="ir.rule">
        <field name="name">Leasing Voucher Config: multi-company</field>
        <field name="model_id" ref="model_leasing_voucher_config"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
