<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_vehicle_pnl" model="ir.actions.report">
        <field name="name">Laporan Laba Rugi Kendaraan</field>
        <field name="model">vehicle.pnl.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">x_vehicle_pnl_report.report_vehicle_pnl_document</field>
        <field name="report_file">x_vehicle_pnl_report.report_vehicle_pnl_document</field>
        <field name="print_report_name">'Laba_Rugi_Kendaraan_%s' % (time.strftime('%Y%m%d'))</field>
        <field name="binding_model_id" eval="False"/>
    </record>

    <template id="report_vehicle_pnl_document">
        <t t-call="web.html_container">
            <style>
                .pnl-container {
                    font-family: Arial, 'Helvetica Neue', Helvetica, sans-serif !important;
                    font-size: 12px !important;
                    color: #1a1a1a !important;
                    line-height: 1.4 !important;
                    padding: 20px 25px !important;
                    -webkit-print-color-adjust: exact !important;
                    print-color-adjust: exact !important;
                }
                .pnl-header-card {
                    width: 100% !important;
                    border-collapse: collapse !important;
                    border: 1px solid #333333 !important;
                    background-color: #ffffff !important;
                }
                .pnl-header-card td {
                    padding: 5px 14px !important;
                    vertical-align: middle !important;
                    border: none !important;
                }
                .pnl-trans-table {
                    width: 100% !important;
                    table-layout: fixed !important;
                    border-collapse: collapse !important;
                    border: 1px solid #333333 !important;
                }
                .pnl-trans-table thead th {
                    background-color: #f4f5f7 !important;
                    border-bottom: 1px solid #333333 !important;
                    border-top: none !important;
                    border-left: none !important;
                    border-right: none !important;
                    padding: 7px 14px !important;
                    font-weight: bold !important;
                    font-size: 12px !important;
                    color: #111111 !important;
                }
                .pnl-trans-table td {
                    padding: 4px 14px !important;
                    border: none !important;
                }
                .pnl-row-subtotal td {
                    padding: 3px 14px !important;
                    border: none !important;
                }
                .pnl-row-subtotal td.subtotal-val {
                    border-top: 1px solid #666666 !important;
                }
                .pnl-row-section-total td {
                    background-color: #f9fafb !important;
                    border-top: 1px solid #333333 !important;
                    border-bottom: 1px solid #e0e0e0 !important;
                    padding: 6px 14px !important;
                }
                .pnl-row-grand-total td {
                    background-color: #f0f2f5 !important;
                    border-top: 1.5px solid #333333 !important;
                    border-bottom: 1.5px solid #333333 !important;
                    padding: 7px 14px !important;
                }
                .pnl-summary-card {
                    width: 62% !important;
                    border: 1px solid #333333 !important;
                    border-collapse: collapse !important;
                    background-color: #f9fafb !important;
                }
                .pnl-summary-card td {
                    padding: 5px 16px !important;
                    border: none !important;
                }
                .pnl-summary-card tr.pnl-row-book-value td {
                    border-top: 1px solid #e0e0e0 !important;
                    border-bottom: 1px solid #e0e0e0 !important;
                    background-color: #ffffff !important;
                }
                .pnl-summary-card tr.pnl-row-laba-rugi td {
                    border-top: 1.5px solid #333333 !important;
                    background-color: #eef1f5 !important;
                    padding: 7px 16px !important;
                }
            </style>

            <t t-foreach="reports_data" t-as="data">
                <div class="article page pnl-container" t-att-style="'page-break-after: always;' if not data_last else ''">
                    
                    <!-- Header Info Kendaraan -->
                    <table class="pnl-header-card o_ignore_layout_styling" cellspacing="0" cellpadding="0">
                        <tr>
                            <td style="width: 18%; font-weight: bold; border: none !important;">No Polisi</td>
                            <td style="width: 2%; font-weight: bold; text-align: center; border: none !important;">:</td>
                            <td style="width: 80%; font-weight: bold; font-size: 13px; border: none !important;"><t t-esc="data['nopol']"/></td>
                        </tr>
                        <tr>
                            <td style="font-weight: bold; border: none !important;">Merk/Tipe</td>
                            <td style="font-weight: bold; text-align: center; border: none !important;">:</td>
                            <td style="font-weight: bold; font-size: 13px; border: none !important;"><t t-esc="data['merk_tipe']"/></td>
                        </tr>
                        <tr><td colspan="3" style="height: 6px; padding: 0; border: none !important;"></td></tr>
                        <tr>
                            <td style="font-weight: bold; border: none !important;">Sisa Pokok / Lama</td>
                            <td style="font-weight: bold; text-align: center; border: none !important;">:</td>
                            <td style="font-weight: bold; border: none !important;"><t t-esc="data['sisa_pokok_lama']"/></td>
                        </tr>
                        <tr><td colspan="3" style="height: 6px; padding: 0; border: none !important;"></td></tr>
                        <tr>
                            <td style="font-weight: bold; border: none !important;">Per Tanggal</td>
                            <td style="font-weight: bold; text-align: center; border: none !important;">:</td>
                            <td style="font-weight: bold; border: none !important;"><t t-esc="data['per_tanggal']"/></td>
                        </tr>
                    </table>

                    <!-- Spacer -->
                    <div style="height: 18px; line-height: 18px; font-size: 1px;">&#160;</div>

                    <!-- Table Transaksi Pendapatan & Biaya (3 Kolom: Jenis, Ket, Jumlah) -->
                    <table class="pnl-trans-table o_ignore_layout_styling" width="100%" style="width: 100% !important; table-layout: fixed !important; border-collapse: collapse; border: 1px solid #333333;" cellspacing="0" cellpadding="0">
                        <colgroup>
                            <col style="width: 24%;"/>
                            <col style="width: 46%;"/>
                            <col style="width: 30%;"/>
                        </colgroup>
                        <thead>
                            <tr>
                                <th style="width: 24%; text-align: left;">Jenis</th>
                                <th style="width: 46%; text-align: left;">Financial Account</th>
                                <th style="width: 30%; text-align: right;">Jumlah</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- SEKSI PENDAPATAN -->
                            <t t-set="is_first_income" t-value="True"/>
                            <t t-if="data['income_groups']">
                                <t t-foreach="data['income_groups']" t-as="group_name">
                                    <t t-set="group_data" t-value="data['income_groups'][group_name]"/>
                                    <tr style="border: none !important;">
                                        <td style="font-weight: bold; vertical-align: top; border: none !important;">
                                            <t t-if="is_first_income">PENDAPATAN</t>
                                            <t t-set="is_first_income" t-value="False"/>
                                        </td>
                                        <td style="vertical-align: top; border: none !important;">
                                            <t t-esc="group_name"/>
                                        </td>
                                        <td style="text-align: right; vertical-align: top; border: none !important;">
                                            <t t-esc="'{:,.0f}'.format(group_data['subtotal'])"/>
                                        </td>
                                    </tr>
                                </t>
                            </t>
                            <t t-else="">
                                <tr style="border: none !important;">
                                    <td style="font-weight: bold; vertical-align: top; border: none !important;">PENDAPATAN</td>
                                    <td style="vertical-align: top; border: none !important;">-</td>
                                    <td style="text-align: right; vertical-align: top; border: none !important;">0</td>
                                </tr>
                            </t>

                            <!-- Subtotal Pendapatan -->
                            <tr class="pnl-row-section-total">
                                <td colspan="2" style="text-align: right; font-weight: bold;">Total PENDAPATAN</td>
                                <td style="text-align: right; font-weight: bold;">
                                    <t t-esc="'{:,.0f}'.format(data['total_pendapatan'])"/>
                                </td>
                            </tr>

                            <!-- Spasi Pemisah Antara Pendapatan & Biaya -->
                            <tr style="border: none !important;">
                                <td colspan="3" style="height: 14px; padding: 0; background-color: #ffffff; border-top: 1px solid #e0e0e0 !important; border-bottom: 1px solid #e0e0e0 !important; border-left: none !important; border-right: none !important;"></td>
                            </tr>

                            <!-- SEKSI BIAYA -->
                            <t t-set="is_first_expense" t-value="True"/>
                            <t t-if="data['expense_groups']">
                                <t t-foreach="data['expense_groups']" t-as="group_name">
                                    <t t-set="group_data" t-value="data['expense_groups'][group_name]"/>
                                    <tr style="border: none !important;">
                                        <td style="font-weight: bold; vertical-align: top; border: none !important;">
                                            <t t-if="is_first_expense">BIAYA</t>
                                            <t t-set="is_first_expense" t-value="False"/>
                                        </td>
                                        <td style="vertical-align: top; border: none !important;">
                                            <t t-esc="group_name"/>
                                        </td>
                                        <td style="text-align: right; vertical-align: top; border: none !important;">
                                            <t t-esc="'{:,.0f}'.format(group_data['subtotal'])"/>
                                        </td>
                                    </tr>
                                </t>
                            </t>
                            <t t-else="">
                                <tr style="border: none !important;">
                                    <td style="font-weight: bold; vertical-align: top; border: none !important;">BIAYA</td>
                                    <td style="vertical-align: top; border: none !important;">-</td>
                                    <td style="text-align: right; vertical-align: top; border: none !important;">0</td>
                                </tr>
                            </t>

                            <!-- Subtotal Biaya -->
                            <tr class="pnl-row-section-total">
                                <td colspan="2" style="text-align: right; font-weight: bold;">Total BIAYA</td>
                                <td style="text-align: right; font-weight: bold;">
                                    <t t-esc="'{:,.0f}'.format(data['total_biaya'])"/>
                                </td>
                            </tr>

                            <!-- Total PENDAPATAN - BIAYA -->
                            <tr class="pnl-row-grand-total">
                                <td colspan="2" style="text-align: right; font-weight: bold; font-size: 13px;">Total PENDAPATAN-BIAYA</td>
                                <td style="text-align: right; font-weight: bold; font-size: 13px;">
                                    <t t-esc="'{:,.0f}'.format(data['total_pendapatan_biaya'])"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <!-- Spacer -->
                    <div style="height: 18px; line-height: 18px; font-size: 1px;">&#160;</div>

                    <!-- Summary Box (HPP, Amortisasi, Book Value, Laba Rugi) -->
                    <table class="pnl-summary-card o_ignore_layout_styling" cellspacing="0" cellpadding="0">
                        <tr>
                            <td style="width: 55%; font-weight: bold; border: none !important;">BELI (HPP)</td>
                            <td style="width: 45%; text-align: right; border: none !important;">
                                <t t-esc="'{:,.0f}'.format(data['beli_hpp'])"/>
                            </td>
                        </tr>
                        <tr>
                            <td style="font-weight: bold; border: none !important;">AMORTISASI</td>
                            <td style="text-align: right; border: none !important;">
                                <t t-esc="'{:,.0f}'.format(data['amortisasi'])"/>
                            </td>
                        </tr>
                        <tr class="pnl-row-book-value">
                            <td style="font-weight: bold; border-top: 1px solid #e0e0e0 !important; border-bottom: 1px solid #e0e0e0 !important; border-left: none !important; border-right: none !important;">BOOK VALUE</td>
                            <td style="text-align: right; font-weight: bold; border-top: 1px solid #e0e0e0 !important; border-bottom: 1px solid #e0e0e0 !important; border-left: none !important; border-right: none !important;">
                                <t t-esc="'{:,.0f}'.format(data['book_value'])"/>
                            </td>
                        </tr>
                        <tr>
                            <td style="font-weight: bold; border: none !important;">TOTAL PENDAPATAN-BIAYA</td>
                            <td style="text-align: right; border: none !important;">
                                <t t-esc="'{:,.0f}'.format(data['total_pendapatan_biaya'])"/>
                            </td>
                        </tr>
                        <tr>
                            <td style="font-weight: bold; border: none !important;">HARGA JUAL</td>
                            <td style="text-align: right; border: none !important;">
                                <t t-esc="'{:,.0f}'.format(data['harga_jual'])"/>
                            </td>
                        </tr>
                        <tr class="pnl-row-laba-rugi">
                            <td style="font-weight: bold; font-size: 13px; border-top: 1.5px solid #333333 !important; border-bottom: none !important; border-left: none !important; border-right: none !important;">LABA/RUGI</td>
                            <td style="text-align: right; font-weight: bold; font-size: 13px; border-top: 1.5px solid #333333 !important; border-bottom: none !important; border-left: none !important; border-right: none !important;">
                                <t t-esc="'{:,.0f}'.format(data['laba_rugi'])"/>
                            </td>
                        </tr>
                    </table>

                </div>
            </t>
        </t>
    </template>
</odoo>
