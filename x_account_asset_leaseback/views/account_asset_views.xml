<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_asset_form_inherit_leaseback" model="ir.ui.view">
        <field name="name">account.asset.form.inherit.leaseback</field>
        <field name="model">account.asset</field>
        <field name="inherit_id" ref="account_asset.view_account_asset_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_create_purchase_order" type="object" string="Create PO" class="oe_highlight" invisible="state not in ('close', 'leaseback') or purchase_order_ref"/>
                <button name="action_create_incoming_payment" type="object" string="Create Incoming Payment" class="oe_highlight" invisible="state not in ('close', 'leaseback') or incoming_payment_ref or purchase_order_status not in ('purchase', 'done')"/>
            </xpath>
            <xpath expr="//button[@name='set_to_running']" position="attributes">
                <attribute name="invisible">state not in ('close', 'leaseback', 'dispose', 'sell')</attribute>
            </xpath>
            <xpath expr="//button[@name='action_save_model']" position="attributes">
                <attribute name="invisible">state not in ('open', 'paused', 'close', 'leaseback', 'dispose', 'sell')</attribute>
            </xpath>
            <xpath expr="//h1/field[@name='name']" position="attributes">
                <attribute name="readonly">state in ('close', 'leaseback', 'dispose', 'sell')</attribute>
            </xpath>
            <xpath expr="//field[@name='state'][@widget='statusbar']" position="attributes">
                <attribute name="statusbar_visible">draft,open</attribute>
            </xpath>
            <xpath expr="//field[@name='analytic_distribution']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>
            <xpath expr="//div[field[@name='salvage_value_pct']]" position="after">
                <field name="x_is_fleet" invisible="state != 'model'"/>
            </xpath>
            <xpath expr="//field[@name='analytic_distribution']" position="attributes">
                <attribute name="readonly">x_is_fleet</attribute>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Other Info" name="other_info_leaseback">
                    <group>
                        <group string="Incoming Payment">
                            <field name="incoming_payment_ref" readonly="1"/>
                            <field name="incoming_payment_status" readonly="1"/>
                        </group>
                        <group string="Purchase Order">
                            <field name="purchase_order_ref" readonly="1"/>
                            <field name="purchase_order_status" readonly="1"/>
                        </group>
                    </group>
                    <group string="Leaseback Information">
                        <group>
                            <field name="leaseback_remaining_duration" readonly="1" invisible="x_refinancing_type != 'leaseback' and state != 'leaseback'"/>
                            <field name="leaseback_ar_amount" readonly="1" invisible="x_refinancing_type != 'leaseback' and state != 'leaseback'"/>
                            <field name="leaseback_deferred_pl_amount" readonly="1"/>
                            <field name="deferred_expense_id" string="Deferred Revenue Entry" readonly="1" invisible="x_refinancing_type != 'leaseback'" options="{'no_create': True}"/>
                            <field name="disposal_pl_amount" readonly="1"/>
                            <field name="sell_pl_amount" readonly="1"/>
                        </group>
                        <group string="Refinancing">
                            <field name="x_is_refinanced" readonly="1"/>
                            <field name="x_refinancing_type" readonly="1" invisible="not x_is_refinanced"/>
                            <field name="x_refinancing_date" readonly="1" invisible="not x_is_refinanced"/>
                            <field name="x_refinancing_move_id" readonly="1" invisible="not x_is_refinanced"/>
                            <field name="x_pre_refinancing_move_id" readonly="1" invisible="not x_is_refinanced"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_account_asset_tree_inherit_leaseback" model="ir.ui.view">
        <field name="name">account.asset.tree.inherit.leaseback</field>
        <field name="model">account.asset</field>
        <field name="inherit_id" ref="account_asset.view_account_asset_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="decoration-muted">state in ['close', 'cancelled', 'leaseback', 'dispose', 'sell']</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_account_asset_search_inherit_leaseback" model="ir.ui.view">
        <field name="name">account.asset.search.inherit.leaseback</field>
        <field name="model">account.asset</field>
        <field name="inherit_id" ref="account_asset.view_account_asset_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='closed']" position="attributes">
                <attribute name="domain">[('state', 'in', ('close', 'leaseback', 'dispose', 'sell'))]</attribute>
            </xpath>
            <xpath expr="//filter[@name='closed']" position="after">
                <filter string="Leaseback" name="state_leaseback" domain="[('state', '=', 'leaseback')]"/>
                <filter string="Dispose" name="state_dispose" domain="[('state', '=', 'dispose')]"/>
                <filter string="Sell" name="state_sell" domain="[('state', '=', 'sell')]"/>
            </xpath>
            <xpath expr="//filter[@name='month']" position="before">
                <filter string="Status" name="group_by_state" domain="[]" context="{'group_by':'state'}"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_asset_kanban_inherit_leaseback" model="ir.ui.view">
        <field name="name">account.asset.kanban.inherit.leaseback</field>
        <field name="model">account.asset</field>
        <field name="inherit_id" ref="account_asset.view_account_asset_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state'][@widget='label_selection']" position="attributes">
                <attribute name="options">{'classes': {'draft': 'primary', 'open': 'success', 'close': 'default', 'leaseback': 'info', 'dispose': 'warning', 'sell': 'secondary'}}</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_account_asset_form_inherit_leaseback_fleet" model="ir.ui.view">
        <field name="name">account.asset.form.inherit.leaseback.fleet</field>
        <field name="model">account.asset</field>
        <field name="inherit_id" ref="account_asset_fleet.view_account_asset_fleet_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='already_depreciated_amount_import']/following-sibling::field[@name='vehicle_id']" position="attributes">
                <attribute name="invisible">not x_is_fleet</attribute>
            </xpath>
        </field>
    </record>
</odoo>
