<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_leaseback" model="ir.ui.view">
        <field name="name">res.config.settings.form.leaseback</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <block id="default_accounts" position="inside">
                <setting id="leaseback_deferred_account"
                         string="Leaseback Deferred P/L"
                         help="Account receiving the gain/loss of an asset leaseback versus its book value (e.g. 501409 Laba Rugi Ditangguhkan).">
                    <field name="leaseback_deferred_account_id"/>
                </setting>
            </block>
        </field>
    </record>

</odoo>
