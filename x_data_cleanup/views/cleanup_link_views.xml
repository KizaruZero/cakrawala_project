<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cleanup_link_list" model="ir.ui.view">
        <field name="name">x.cleanup.link.list</field>
        <field name="model">x.cleanup.link</field>
        <field name="arch" type="xml">
            <list string="Aturan Relasi" editable="bottom">
                <field name="model_id" options="{'no_create': True}"/>
                <field name="field_id" options="{'no_create': True}"/>
                <field name="ttype"/>
                <field name="relation"/>
                <field name="action"/>
                <field name="note" optional="show"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_cleanup_link_search" model="ir.ui.view">
        <field name="name">x.cleanup.link.search</field>
        <field name="model">x.cleanup.link</field>
        <field name="arch" type="xml">
            <search>
                <field name="model_name"/>
                <field name="field_name"/>
                <field name="relation"/>
                <filter name="archived" string="Nonaktif" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_model" string="Model" context="{'group_by': 'model_id'}"/>
                    <filter name="group_action" string="Aturan" context="{'group_by': 'action'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_cleanup_link" model="ir.actions.act_window">
        <field name="name">Aturan Relasi</field>
        <field name="res_model">x.cleanup.link</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Belum ada aturan relasi</p>
            <p>Foreign key sudah dibaca otomatis. Aturan di sini hanya untuk relasi yang tidak tersirat dari
               foreign key, misalnya delivery dan invoice adalah turunan dari Sales Order.</p>
        </field>
    </record>
</odoo>
