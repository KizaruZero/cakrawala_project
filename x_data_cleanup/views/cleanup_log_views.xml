<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cleanup_log_list" model="ir.ui.view">
        <field name="name">x.cleanup.log.list</field>
        <field name="model">x.cleanup.log</field>
        <field name="arch" type="xml">
            <list string="Log" create="0" edit="0" delete="0">
                <field name="date"/>
                <field name="user_login"/>
                <field name="database"/>
                <field name="mode"/>
                <field name="name"/>
                <field name="total_deleted"/>
                <field name="total_nullified"/>
            </list>
        </field>
    </record>

    <record id="view_cleanup_log_form" model="ir.ui.view">
        <field name="name">x.cleanup.log.form</field>
        <field name="model">x.cleanup.log</field>
        <field name="arch" type="xml">
            <form string="Log" create="0" edit="0" delete="0">
                <sheet>
                    <h2><field name="name"/></h2>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="user_login"/>
                            <field name="database"/>
                        </group>
                        <group>
                            <field name="mode"/>
                            <field name="total_deleted"/>
                            <field name="total_nullified"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Detail per Tabel">
                            <field name="details"/>
                        </page>
                        <page string="Tindak Lanjut">
                            <field name="post_notes"/>
                        </page>
                        <page string="Opsi">
                            <field name="options"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_cleanup_log" model="ir.actions.act_window">
        <field name="name">Log Pembersihan</field>
        <field name="res_model">x.cleanup.log</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
