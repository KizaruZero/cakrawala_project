<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bastk_create_from_picking_wizard_form" model="ir.ui.view">
        <field name="name">bastk.create.from.picking.wizard.form</field>
        <field name="model">bastk.create.from.picking.wizard</field>
        <field name="arch" type="xml">
            <form string="Create BASTK">
                <group>
                    <field name="picking_id"/>
                    <field name="bastk_type_id" options="{'no_create': True}"/>
                </group>
                <p class="text-muted">One BASTK will be created for each vehicle below.</p>
                <field name="vehicle_ids" readonly="1">
                    <list>
                        <field name="asset_number" string="Fleet Number"/>
                        <field name="model_id"/>
                        <field name="license_plate"/>
                        <field name="chassis_number"/>
                    </list>
                </field>
                <footer>
                    <button name="action_confirm" type="object" string="Create BASTK" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
