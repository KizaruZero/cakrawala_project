<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_bastk_submit_wizard_form" model="ir.ui.view">
            <field name="name">bastk.submit.wizard.form</field>
            <field name="model">bastk.submit.wizard</field>
            <field name="arch" type="xml">
                <form string="Submit BASTK">
                    <field name="bastk_id" invisible="1"/>
                    <field name="submit_type" invisible="1"/>
                    <sheet>
                        <group>
                            <field name="pic"/>
                            <field name="call_number"/>
                            <field name="odometer"/>
                        </group>
                    </sheet>
                    <footer>
                        <button name="action_confirm" type="object" string="Confirm" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
