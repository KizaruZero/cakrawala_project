<odoo>

    <record id="view_bastk_type_list" model="ir.ui.view">
        <field name="name">bastk.type.list</field>
        <field name="model">bastk.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>


    <record id="view_bastk_type_form" model="ir.ui.view">
        <field name="name">bastk.type.form</field>
        <field name="model">bastk.type</field>
        <field name="arch" type="xml">
            <form string="BASTK Type">
                <sheet>
                        <group>
                            <field name="name"/>
                            <field name="is_disposal"/>
                            <field name="is_disabled_after_submitted_in"/>
                            <field name="need_submit_out"/>
                            <field name="need_submit_in"/>
                        </group>
                        <group string="State when Out">
                            <field name="out_state_id"/>
                            <field name="out_substate_id"/>
                        </group>
                        <group string="State when In" invisible="is_disposal or is_disabled_after_submitted_in">
                            <field name="in_state_id"/>
                            <field name="in_substate_id"/>
                        </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bastk_type" model="ir.actions.act_window">
        <field name="name">BASTK Type</field>
        <field name="res_model">bastk.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_bastk_type"
              name="BASTK Type"
              parent="x_bastk_management.menu_bastk"
              action="action_bastk_type"
              sequence="60"/>
</odoo>