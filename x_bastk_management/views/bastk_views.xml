<odoo>

    <record id="view_bastk_list" model="ir.ui.view">
        <field name="name">bastk.management.list</field>
        <field name="model">bastk.management</field>
        <field name="arch" type="xml">
            <list default_order="id desc">
                <field name="name"/>
                <field name="bastk_type_id"/>
                <field name="partner_id"/>
                <field name="vehicle_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="sale_order_id" optional="show"/>
            </list>
        </field>
    </record>


    <record id="view_bastk_form" model="ir.ui.view">
        <field name="name">bastk.management.form</field>
        <field name="model">bastk.management</field>
        <field name="arch" type="xml">
            <form string="BASTK">
                <header>
                    <button name="action_submit_outside"
                            string="Submit Out"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_submit_inside"
                            string="Submit In"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'submitted_outside' or is_disposal"/>
                    <button name="action_done"
                            string="Done"
                            type="object"
                            class="btn-primary"
                            invisible="state not in ('submitted_inside', 'submitted_outside') or (state == 'submitted_outside' and not is_disposal)"/>
                    <button name="action_reset_to_draft"
                            string="Reset to Draft"
                            type="object"
                            invisible="state == 'draft'"/>
                    <button name="action_open_wizard_goods_issue"
                            string="Create Goods Issue"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'submitted_outside' or is_from_so or has_goods_issue"/>
                    <button name="action_open_wizard_goods_receive"
                            string="Create Goods Receive"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'submitted_inside' or is_from_so or has_goods_receive"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted_outside,submitted_inside,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_pickings" type="object" class="oe_stat_button" icon="fa-truck" invisible="picking_count == 0">
                            <field name="picking_count" widget="statinfo" string="Transfers"/>
                        </button>
                    </div>
                    <group cols="2">
                    <group>
                        <field name="name" readonly="1"/>
                        <field name="is_disposal" invisible="1"/>
                        <field name="has_goods_issue" invisible="1"/>
                        <field name="has_goods_receive" invisible="1"/>
                        <field name="bastk_type_id" readonly="state != 'draft'"/>
                        <field name="start_date" readonly="state == 'done'"/>
                        <field name="end_date" readonly="state == 'done'" invisible="is_disposal" required="not is_disposal"/>
                        <field name="partner_id" readonly="state != 'draft'"/>
                        <field name="last_odometer"/>
                        <field name="sale_order_id" invisible="not sale_order_id" readonly="1"/>
                        <field name="is_from_so" invisible="1"/>
                        <field name="address_text" readonly="state != 'draft'"/>
                        <field name="driver_name" readonly="state != 'draft'"/>
                    </group>

                    <group>
                        <field name="vehicle_id" readonly="state != 'draft'"/>
                        <field name="asset_number" readonly="1"/>
                        <field name="license_plate" readonly="1"/>
                        <field name="unit_type" readonly="1"/>
                        <field name="color" readonly="1"/>
                        <field name="model_year" readonly="1"/>
                        <field name="vin_number" readonly="1"/>
                        <field name="engine_number" readonly="1"/>
                        <field name="description" readonly="state != 'draft'"/>
                    </group>
                    </group>

                    <notebook>

                        <page string="KELUAR">
                            <group cols="2">
                                <group>
                                    <field name="pic_keluar" readonly="state != 'draft'"/>
                                    <field name="call_number_keluar" readonly="state != 'draft'"/>
                                    <field name="odometer_out" required="state == 'draft'" readonly="state != 'draft'"/>
                                </group>
                            </group>
                            <field name="line_keluar_ids" context="{'default_bastk_type': 'keluar'}" readonly="state != 'draft'">
                                <list editable="bottom" delete="0" class="o_bastk_checklist_conditions">
                                    <field name="bastk_type" column_invisible="1"/>
                                    <field name="checklist_id" domain="[('type', 'in', ['keluar', 'both'])]"/>
                                    <field name="condition_baik"/>
                                    <field name="condition_tidak_ada"/>
                                    <field name="condition_rusak"/>
                                    <field name="condition_hilang"/>
                                    <field name="remarks"/>
                                </list>
                                <form string="Checklist Keluar Line">
                                    <group class="o_bastk_checklist_conditions">
                                        <field name="bastk_type" invisible="1"/>
                                        <field name="checklist_id" domain="[('type', 'in', ['keluar', 'both'])]"/>
                                        <field name="condition_baik"/>
                                        <field name="condition_tidak_ada"/>
                                        <field name="condition_rusak"/>
                                        <field name="condition_hilang"/>
                                        <field name="remarks"/>
                                    </group>
                                </form>
                            </field>
                            <group cols="2">
                                <group>
                                    <field name="customer_sign_keluar" widget="signature" readonly="state != 'draft'"/>
                                </group>
                                <group>
                                    <field name="cakrawala_sign_keluar" widget="signature" readonly="state != 'draft'"/>
                                </group>
                            </group>
                            <group string="Photos (Keluar)">
                                <field name="image_keluar_ids" nolabel="1" mode="kanban" context="{'default_bastk_type': 'keluar'}" readonly="state != 'draft'">
                                    <kanban string="Photos" create="0" delete="0">
                                        <field name="id"/>
                                        <field name="name"/>
                                        <field name="image"/>
                                        <field name="annotated_image"/>
                                        <templates>
                                            <t t-name="card">
                                                <div class="oe_kanban_global_click">
                                                    <div class="o_kanban_image">
                                                        <t t-if="record.annotated_image.raw_value">
                                                            <field name="annotated_image" widget="image" class="o_image_256_contain" options="{'size': [256, 256]}"/>
                                                        </t>
                                                        <t t-else="">
                                                            <field name="image" widget="image" class="o_image_256_contain" options="{'size': [256, 256]}"/>
                                                        </t>
                                                    </div>
                                                    <div class="oe_kanban_details">
                                                        <field name="name"/>
                                                    </div>
                                                </div>
                                            </t>
                                        </templates>
                                    </kanban>
                                    <form create="0" delete="0">
                                        <sheet>
                                            <group class="d-none">
                                                <field name="name"/>
                                                <field name="image"/>
                                            </group>
                                            <div class="w-100">
                                                <field name="annotated_image" widget="image_annotator" nolabel="1"/>
                                            </div>
                                        </sheet>
                                    </form>
                                </field>
                            </group>
                            <group>
                                <field name="attachment_keluar_ids" widget="many2many_binary" readonly="state != 'draft'"/>
                            </group>
                            <group>
                                <field name="remarks_keluar" readonly="state != 'draft'"/>
                            </group>
                        </page>

                        <page string="MASUK" invisible="is_disposal">
                            <group cols="2">
                                <group>
                                    <field name="pic_masuk" readonly="state != 'submitted_outside'"/>
                                    <field name="call_number_masuk" readonly="state != 'submitted_outside'"/>
                                    <field name="odometer_in" required="state == 'submitted_outside'" readonly="state != 'submitted_outside'"/>
                                </group>
                            </group>
                            <field name="line_masuk_ids" context="{'default_bastk_type': 'masuk'}" readonly="state != 'submitted_outside'" force_save="1">
                                <list editable="bottom" delete="0" class="o_bastk_checklist_conditions">
                                    <field name="bastk_type" column_invisible="1"/>
                                    <field name="checklist_id" domain="[('type', 'in', ['masuk', 'both'])]"/>
                                    <field name="condition_baik"/>
                                    <field name="condition_tidak_ada"/>
                                    <field name="condition_rusak"/>
                                    <field name="condition_hilang"/>
                                    <field name="remarks"/>
                                </list>
                                <form string="Checklist Masuk Line">
                                    <group class="o_bastk_checklist_conditions">
                                        <field name="bastk_type" invisible="1"/>
                                        <field name="checklist_id" domain="[('type', 'in', ['masuk', 'both'])]"/>
                                        <field name="condition_baik"/>
                                        <field name="condition_tidak_ada"/>
                                        <field name="condition_rusak"/>
                                        <field name="condition_hilang"/>
                                        <field name="remarks"/>
                                    </group>
                                </form>
                            </field>
                            <group cols="2">
                                <group>
                                    <field name="customer_sign_masuk" widget="signature" readonly="state != 'submitted_outside'"/>
                                </group>
                                <group>
                                    <field name="cakrawala_sign_masuk" widget="signature" readonly="state != 'submitted_outside'"/>
                                </group>
                            </group>
                            <group string="Photos (Masuk)">
                                <field name="image_masuk_ids" nolabel="1" mode="kanban" context="{'default_bastk_type': 'masuk'}" readonly="state != 'submitted_outside'" force_save="1">
                                    <kanban string="Photos" create="0" delete="0">
                                        <field name="id"/>
                                        <field name="name"/>
                                        <field name="image"/>
                                        <field name="annotated_image"/>
                                        <templates>
                                            <t t-name="card">
                                                <div class="oe_kanban_global_click">
                                                    <div class="o_kanban_image">
                                                        <t t-if="record.annotated_image.raw_value">
                                                            <field name="annotated_image" widget="image" class="o_image_256_contain" options="{'size': [256, 256]}"/>
                                                        </t>
                                                        <t t-else="">
                                                            <field name="image" widget="image" class="o_image_256_contain" options="{'size': [256, 256]}"/>
                                                        </t>
                                                    </div>
                                                    <div class="oe_kanban_details">
                                                        <field name="name"/>
                                                    </div>
                                                </div>
                                            </t>
                                        </templates>
                                    </kanban>
                                    <form create="0" delete="0">
                                        <sheet>
                                            <group class="d-none">
                                                <field name="name"/>
                                                <field name="image"/>
                                            </group>
                                            <div class="w-100">
                                                <field name="annotated_image" widget="image_annotator" nolabel="1"/>
                                            </div>
                                        </sheet>
                                    </form>
                                </field>
                            </group>
                            <group>
                                <field name="attachment_masuk_ids" widget="many2many_binary" readonly="state != 'submitted_outside'"/>
                            </group>
                            <group>
                                <field name="remarks_masuk" readonly="state != 'submitted_outside'"/>
                            </group>
                        </page>



                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bastk" model="ir.actions.act_window">
        <field name="name">BASTK</field>
        <field name="res_model">bastk.management</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_bastk"
            name="BASTK Management"
            parent="fleet.menu_root"
            sequence="60"
            groups="fleet.fleet_group_user"/>

    <menuitem id="menu_bastk_management"
            name="BASTK Record"
            parent="x_bastk_management.menu_bastk"
            action="action_bastk"
            sequence="10"
            groups="fleet.fleet_group_user"/>

</odoo>