<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fleet_vehicle_model_category_form_inherit_photos" model="ir.ui.view">
        <field name="name">fleet.vehicle.model.category.form.inherit.photos</field>
        <field name="model">fleet.vehicle.model.category</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_model_category_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <notebook>
                    <page string="Photos" name="photos">
                        <field name="photo_ids" mode="kanban">
                            <kanban string="Photos">
                                <field name="id"/>
                                <field name="name"/>
                                <field name="image"/>
                                <templates>
                                    <t t-name="card">
                                        <div class="oe_kanban_global_click">
                                            <div class="o_kanban_image">
                                                <field name="image" widget="image" class="o_image_256_contain" options="{'size': [256, 256]}"/>
                                            </div>
                                            <div class="oe_kanban_details">
                                                <field name="name"/>
                                            </div>
                                        </div>
                                    </t>
                                </templates>
                            </kanban>
                            <form>
                                <sheet>
                                    <group>
                                        <field name="name"/>
                                        <field name="image" widget="image"/>
                                    </group>
                                </sheet>
                            </form>
                        </field>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>

    <record id="view_fleet_vehicle_model_category_tree_inherit_unlock" model="ir.ui.view">
        <field name="name">fleet.vehicle.model.category.tree.inherit.unlock</field>
        <field name="model">fleet.vehicle.model.category</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_model_category_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="replace">
                <list string="Model Category">
                    <field name="name"/>
                </list>
            </xpath>
        </field>
    </record>

    <record id="fleet.fleet_vehicle_model_category_action" model="ir.actions.act_window">
        <field name="name">Categories</field>
        <field name="res_model">fleet.vehicle.model.category</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new category
            </p>
            <p>
                Categories will help you manage your fleet more efficiently and arrange your vehicles.
            </p>
        </field>
    </record>
</odoo>
