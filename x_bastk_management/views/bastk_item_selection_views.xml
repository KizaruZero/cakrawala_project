<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_bastk_item_selection_list" model="ir.ui.view">
        <field name="name">bastk.item.selection.list</field>
        <field name="model">bastk.item.selection</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_bastk_item_selection_form" model="ir.ui.view">
        <field name="name">bastk.item.selection.form</field>
        <field name="model">bastk.item.selection</field>
        <field name="arch" type="xml">
            <form string="BASTK Item Selection">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active"/>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bastk_item_selection" model="ir.actions.act_window">
        <field name="name">BASTK Item Selection</field>
        <field name="res_model">bastk.item.selection</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_bastk_item_selection"
              name="BASTK Item Selection"
              parent="x_bastk_management.menu_bastk"
              action="action_bastk_item_selection"
              sequence="40"/>

</odoo>
