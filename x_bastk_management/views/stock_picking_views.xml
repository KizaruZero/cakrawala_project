<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_inherit_bastk" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.bastk</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_bastk"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-file-text-o"
                        invisible="not bastk_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">BASTK</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="action_create_bastk"
                        string="Create BASTK"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'done' or bastk_id"/>
            </xpath>
            <xpath expr="//field[@name='origin']" position="after">
                <field name="bastk_id" invisible="1"/>
                <field name="bastk_reference" invisible="not bastk_id"/>
                <field name="bastk_date" invisible="not bastk_id"/>
                <field name="bastk_sale_order_id"
                       string="Sales Order"
                       readonly="1"
                       invisible="picking_type_code != 'outgoing' or not sale_id"/>
            </xpath>
        </field>
    </record>
</odoo>
