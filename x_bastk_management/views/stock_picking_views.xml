<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_inherit_bastk" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.bastk</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field name="bastk_id" invisible="picking_type_code != 'outgoing' or not sale_id"/>
            </xpath>
        </field>
    </record>
</odoo>
