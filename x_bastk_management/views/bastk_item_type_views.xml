<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_bastk_item_type_list" model="ir.ui.view">
        <field name="name">bastk.item.type.list</field>
        <field name="model">bastk.item.type</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_bastk_item_type_form" model="ir.ui.view">
        <field name="name">bastk.item.type.form</field>
        <field name="model">bastk.item.type</field>
        <field name="arch" type="xml">
            <form string="BASTK Item Category">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active"/>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bastk_item_type" model="ir.actions.act_window">
        <field name="name">BASTK Item Category</field>
        <field name="res_model">bastk.item.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_bastk_item_type"
              name="BASTK Item Category"
              parent="x_bastk_management.menu_bastk"
              action="action_bastk_item_type"
              sequence="50"/>

</odoo>
