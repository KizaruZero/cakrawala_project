<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_bastk_end_date_notifications" model="ir.cron">
            <field name="name">BASTK: end date email reminders</field>
            <field name="model_id" ref="model_bastk_management"/>
            <field name="state">code</field>
            <field name="code">model.cron_send_end_date_notifications()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="priority">5</field>
        </record>
        <record id="ir_cron_bastk_aging" model="ir.cron">
            <field name="name">BASTK: refresh aging</field>
            <field name="model_id" ref="model_bastk_management"/>
            <field name="state">code</field>
            <field name="code">model.with_context(tz='Asia/Jakarta').cron_refresh_aging()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <!-- 17:00 UTC is 00:00 in Jakarta. -->
            <field name="nextcall" eval="DateTime.now().replace(hour=17, minute=0, second=0).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="priority">5</field>
        </record>
    </data>
</odoo>
