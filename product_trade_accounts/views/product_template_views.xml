<odoo>
  <record id="product_template_form_trade_accounts" model="ir.ui.view">
    <field name="name">product.template.form.trade.accounts</field>
    <field name="model">product.template</field>
    <field name="inherit_id" ref="account.product_template_form_view"/>
    <field name="arch" type="xml">
      <xpath expr="//page[@name='invoicing']/group[@name='accounting']" position="inside">
        <field name="property_trade_receivable_account_id" groups="account.group_account_manager"/>
        <field name="property_trade_payable_account_id" groups="account.group_account_manager"/>
      </xpath>
    </field>
  </record>
</odoo>
