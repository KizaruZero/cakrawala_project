<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_inherit_delivery_slip_enhance" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.delivery.slip.enhance</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='extra']//group[@name='other_infos']//field[@name='user_id']" position="after">
                <field name="received_by" widget="many2one_avatar_user" readonly="state in ['cancel', 'done']"/>
            </xpath>
        </field>
    </record>
</odoo>
