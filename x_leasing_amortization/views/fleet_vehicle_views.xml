<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="fleet_vehicle_form_inherit_leasing" model="ir.ui.view">
        <field name="name">fleet.vehicle.form.inherit.leasing.amortization</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_leasing_schedule"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-calendar"
                        groups="fleet.fleet_group_user"
                        invisible="leasing_loan_count == 0"
                        help="show the leasing amortization schedule for this vehicle">
                    <field name="leasing_loan_count" string="Leasing Schedule" widget="statinfo"/>
                </button>
            </xpath>

        </field>
    </record>

</odoo>
