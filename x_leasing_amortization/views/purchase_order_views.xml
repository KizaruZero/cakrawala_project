<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!--  Smart Button on Purchase Order form for Leasing Schedule     -->
    <!-- ============================================================ -->
    <record id="purchase_order_form_inherit_leasing" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.leasing.amortization</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">

            <!-- Add Smart Button in button box -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_leasing_schedule"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-calendar"
                        invisible="leasing_loan_count == 0 or not is_leasing"
                >
                    <field name="leasing_loan_count" string="Leasing Schedule" widget="statinfo"/>
                </button>
            </xpath>

            <!-- Add "Create Leasing Schedule" button in header (visible only for Leasing PO without existing schedule) -->
            <xpath expr="//header" position="inside">
                <button name="action_create_leasing_schedule"
                        string="Create Leasing Schedule"
                        type="object"
                        class="btn-secondary"
                        invisible="not is_leasing or leasing_loan_count > 0 or state not in ('purchase', 'done')"
                        groups="account.group_account_invoice"
                />
            </xpath>

        </field>
    </record>

</odoo>
