<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_leasing_schedule_import" model="ir.ui.view">
        <field name="name">leasing.schedule.import.form</field>
        <field name="model">leasing.schedule.import</field>
        <field name="arch" type="xml">
            <form string="Import Leasing Schedules">
                <p>Upload the Header and Angsuran sheets to create draft leasing contracts and their complete schedules.
                    Principal and interest follow the file, not the Compute formulas. No journals or payments are created.</p>
                <p>Use a new Import Key for each contract. Existing contracts are never replaced.
                    Paste formulas as values before uploading.</p>
                <p>Agreement No., Leasing Contract No. and Plate Number are optional.
                    Unmatched or ambiguous plates are kept as text without creating a vehicle.
                    Complete Vehicle and Analytic Account before confirming the imported Draft.</p>
                <p>Historical payments are not imported. Before confirming an old contract, Accounting must review
                    the existing Skip until setting so scheduled interest accrual does not repeat historical entries.</p>
                <button name="action_download_template" type="object" string="Download Template" class="btn-secondary"/>
                <group>
                    <field name="company_id" domain="[('id', 'in', allowed_company_ids)]" options="{'no_create': True}"/>
                    <field name="file" filename="filename"/>
                    <field name="filename" invisible="1"/>
                </group>
                <footer>
                    <button name="action_import" type="object" string="Import" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_leasing_schedule_import" model="ir.actions.act_window">
        <field name="name">Import Leasing Schedules</field>
        <field name="res_model">leasing.schedule.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <menuitem id="menu_leasing_schedule_import" name="Import Leasing Schedules"
              parent="purchase.menu_purchase_root" action="action_leasing_schedule_import"
              groups="account.group_account_invoice" sequence="3"/>
    <record id="account_loan_form_import" model="ir.ui.view">
        <field name="name">account.loan.form.import</field>
        <field name="model">account.loan</field>
        <field name="inherit_id" ref="x_leasing_amortization.account_loan_form_effective2"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='compute_method']" position="before">
                <field name="schedule_source"/>
                <field name="import_key" invisible="schedule_source != 'import'"/>
            </xpath>
            <xpath expr="//field[@name='vehicle_id']" position="attributes">
                <attribute name="readonly">schedule_source != 'import' or state != 'draft'</attribute>
                <attribute name="domain">[('company_id', '=', company_id)]</attribute>
            </xpath>
            <xpath expr="//field[@name='plate_number']" position="after">
                <field name="import_plate_number" invisible="schedule_source != 'import' or not vehicle_id or not import_plate_number or plate_number == import_plate_number"/>
            </xpath>
            <xpath expr="//header/widget[@name='new_loan']" position="attributes">
                <attribute name="invisible" add="schedule_source == 'import'" separator=" or "/>
            </xpath>
            <xpath expr="//header/button[@name='action_reset']" position="attributes">
                <attribute name="invisible" add="schedule_source == 'import'" separator=" or "/>
            </xpath>
            <xpath expr="//header/button[@name='action_set_to_draft']" position="attributes">
                <attribute name="invisible" add="schedule_source == 'import'" separator=" or "/>
            </xpath>
            <xpath expr="//header/button[@name='action_open_compute_wizard'][contains(@invisible, 'flat')]" position="attributes">
                <attribute name="invisible" add="schedule_source == 'import'" separator=" or "/>
            </xpath>
            <xpath expr="//header/button[@name='action_open_compute_wizard'][contains(@invisible, 'effective_2')]" position="attributes">
                <attribute name="invisible" add="schedule_source == 'import'" separator=" or "/>
            </xpath>
            <xpath expr="//notebook" position="before">
                <div class="alert alert-info" invisible="schedule_source != 'import'">
                    Import Kontrak: nilai pokok dan bunga mengikuti file. Compute/Reset tidak menimpa jadwal ini.
                    Due Date masih dapat diedit pada Draft yang belum terhubung transaksi.
                </div>
            </xpath>
            <xpath expr="//page[@name='flat_amortization_schedule']/div" position="attributes">
                <attribute name="invisible" add="schedule_source == 'import'" separator=" or "/>
            </xpath>
            <xpath expr="//field[@name='flat_interest_rounding']" position="attributes">
                <attribute name="invisible" add="schedule_source == 'import'" separator=" or "/>
            </xpath>
            <xpath expr="//field[@name='compute_method' or @name='monthly_installment' or @name='total_hutang' or @name='interest_rate_annual' or @name='duration' or @name='due_date']" position="attributes">
                <attribute name="readonly" add="schedule_source == 'import'" separator=" or "/>
            </xpath>
        </field>
    </record>
</odoo>
