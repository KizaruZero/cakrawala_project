<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form view for the wizard -->
    <record id="view_leasing_payment_wizard_form" model="ir.ui.view">
        <field name="name">leasing.payment.wizard.form</field>
        <field name="model">leasing.payment.wizard</field>
        <field name="arch" type="xml">
            <form string="Pay Installments">
                <group>
                    <field name="journal_id"/>
                    <field name="payment_date"/>
                </group>

                <footer>
                    <button string="Confirm Payment" name="action_confirm_payment" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action for the wizard -->
    <record id="action_leasing_payment_wizard" model="ir.actions.act_window">
        <field name="name">Pay Installments</field>
        <field name="res_model">leasing.payment.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="account_loans.model_account_loan_line"/>
        <field name="binding_view_types">list</field>
    </record>
</odoo>
