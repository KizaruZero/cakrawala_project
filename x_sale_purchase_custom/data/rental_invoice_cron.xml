<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_rental_draft_invoices" model="ir.cron">
        <field name="name">Generate Rental Draft Invoices</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="state">code</field>
        <field name="code">model._cron_generate_rental_draft_invoices()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="active">True</field>
    </record>

    <record id="ir_cron_check_rental_contract_expiration" model="ir.cron">
        <field name="name">Check Rental Contract Expiration Reminders</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="state">code</field>
        <field name="code">model._cron_check_contract_expiration()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="active">True</field>
    </record>
</odoo>
