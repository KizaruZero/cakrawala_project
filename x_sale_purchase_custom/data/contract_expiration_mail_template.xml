<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="mail_template_rental_contract_expiration" model="mail.template">
            <field name="name">Rental Order: Contract Expiration Reminder</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="subject">Reminder Kontrak Sewa Akan Berakhir: {{ object.contract_number or object.name }} - {{ object.partner_id.name or '' }}</field>
            <field name="email_from">{{ (object.company_id.email_formatted or user.email_formatted or '') }}</field>
            <field name="email_to">{{ (object.user_id.email_formatted or object.user_id.partner_id.email_formatted or '') }}</field>
            <field name="auto_delete" eval="False"/>
            <field name="description">Email reminder otomatis ke Salesperson sebelum masa berlaku kontrak Rental Order berakhir.</field>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px; font-family: Arial, Helvetica, sans-serif; font-size: 14px; color: #333333;">
    <p style="margin: 0px 0px 12px 0px;">
        Yth. <strong t-out="object.user_id.name or 'Salesperson'">Salesperson</strong>,
    </p>
    <p style="margin: 0px 0px 12px 0px;">
        Ini adalah notifikasi pengingat otomatis bahwa masa berlaku kontrak sewa pada <strong>Rental Order</strong> berikut akan segera berakhir:
    </p>
    <table style="border-collapse: collapse; width: 100%; max-width: 600px; margin: 12px 0px 16px 0px; border: 1px solid #dee2e6;">
        <tbody>
            <tr style="background-color: #f8f9fa;">
                <td style="padding: 8px 12px; border: 1px solid #dee2e6; width: 38%;"><strong>Nomor Rental Order</strong></td>
                <td style="padding: 8px 12px; border: 1px solid #dee2e6;"><span t-out="object.name or '-'">S00001</span></td>
            </tr>
            <tr>
                <td style="padding: 8px 12px; border: 1px solid #dee2e6;"><strong>Nomor Kontrak</strong></td>
                <td style="padding: 8px 12px; border: 1px solid #dee2e6;"><span t-out="object.contract_number or '-'">0001PS/CRS/XI/2026</span></td>
            </tr>
            <tr style="background-color: #f8f9fa;">
                <td style="padding: 8px 12px; border: 1px solid #dee2e6;"><strong>Customer</strong></td>
                <td style="padding: 8px 12px; border: 1px solid #dee2e6;"><span t-out="object.partner_id.name or '-'">PT Customer</span></td>
            </tr>
            <tr>
                <td style="padding: 8px 12px; border: 1px solid #dee2e6;"><strong>Periode Kontrak</strong></td>
                <td style="padding: 8px 12px; border: 1px solid #dee2e6;">
                    <span t-out="object.contract_start_date or '-'">2026-01-01</span>
                    s/d
                    <strong style="color: #c0392b;" t-out="object.contract_end_date or '-'">2026-12-31</strong>
                </td>
            </tr>
            <tr style="background-color: #f8f9fa;">
                <td style="padding: 8px 12px; border: 1px solid #dee2e6;"><strong>Pengaturan Reminder</strong></td>
                <td style="padding: 8px 12px; border: 1px solid #dee2e6;">
                    <t t-if="object.notify_contract_expiration == '2_months'">2 Month Before</t>
                    <t t-elif="object.notify_contract_expiration == '1_month'">1 Month before</t>
                    <t t-elif="object.notify_contract_expiration == '2_weeks'">2 Weeks before</t>
                    <t t-elif="object.notify_contract_expiration == '7_days'">7 Days before</t>
                    <t t-else="">-</t>
                </td>
            </tr>
        </tbody>
    </table>
    <p style="margin: 0px 0px 12px 0px;">
        Mohon segera melakukan konfirmasi kepada Customer terkait perpanjangan kontrak sewa (<em>Contract Renewal / Extend Rental</em>) atau persiapan pengembalian unit kendaraan.
    </p>
    <p style="margin: 16px 0px 0px 0px; color: #666666; font-size: 12px;">
        Terima kasih,<br/>
        <strong t-out="object.company_id.name or 'PT Cakrawala Rentalindo Sejahtera'">PT Cakrawala Rentalindo Sejahtera</strong>
    </p>
</div>
            </field>
        </record>
    </data>
</odoo>

