<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_customer_po_price_warning_form" model="ir.ui.view">
        <field name="name">rental.customer.po.price.warning.form</field>
        <field name="model">rental.customer.po.price.warning</field>
        <field name="arch" type="xml">
            <form string="Peringatan Harga PO Customer">
                <div class="alert alert-warning" role="alert">
                    Total harga SO tidak sama dengan Harga PO Customer.
                    Periksa kembali perbandingan di bawah ini. Pilih Tetap Konfirmasi untuk melanjutkan atau Batal untuk memperbaiki nominalnya.
                </div>
                <field name="comparison_html" widget="html" nolabel="1" readonly="1"/>
                <footer>
                    <button name="action_confirm" string="Tetap Konfirmasi" type="object" class="btn-primary"/>
                    <button string="Batal" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
