<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rental_return_picking_et_form" model="ir.ui.view">
        <field name="name">rental.return.picking.et.form</field>
        <field name="model">rental.return.picking.et</field>
        <field name="arch" type="xml">
            <form string="Return Picking ET">
                <field name="order_id" invisible="1" force_save="1"/>
                <field name="line_ids">
                    <list editable="bottom" create="false" delete="false">
                        <field name="sale_line_id" column_invisible="True" force_save="1"/>
                        <field name="available_quantity" column_invisible="True"/>
                        <field name="product_id" readonly="1"/>
                        <field name="license_plate" readonly="1"/>
                        <field name="quantity" decoration-danger="quantity &gt; available_quantity or quantity &lt; 0"/>
                        <field name="uom_id" readonly="1"/>
                    </list>
                </field>
                <footer>
                    <button name="action_return_et" string="Return ET" type="object" class="btn-primary"/>
                    <button string="Discard" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
