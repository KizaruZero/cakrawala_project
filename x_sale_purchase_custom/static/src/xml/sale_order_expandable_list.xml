<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="x_sale_purchase_custom.SaleOrderExpandableRecordRow"
       t-inherit="web.ListRenderer.RecordRow"
       t-inherit-mode="extension">

        <xpath expr="//td[hasclass('o_data_cell')]/t[@t-if='!isInvisible']" position="before">
            <button t-if="isSaleOrderExpandableList and !isInvisible and column_index === 0"
                    type="button"
                    class="btn btn-link p-0 me-2 o_so_expand_btn text-decoration-none d-inline-flex align-items-center"
                    t-att-title="isSaleOrderExpanded(record) ? 'Sembunyikan Detail Item' : 'Tampilkan Detail Item'"
                    t-on-click.stop.prevent="(ev) => this.toggleSaleOrderExpand(record, ev)">
                <i t-attf-class="fa fa-fw {{ isSaleOrderExpanded(record) ? 'fa-caret-down text-primary' : 'fa-caret-right text-muted' }}"/>
            </button>
        </xpath>

        <xpath expr="//tr[@t-on-click.capture]" position="after">
            <tr t-if="isSaleOrderExpandableList and isSaleOrderExpanded(record)"
                class="o_so_expanded_row"
                t-att-data-parent-id="record.id"
                t-on-click.stop="">
                <td t-att-colspan="nbCols" class="p-0 m-0 border-0">
                    <div class="o_so_expanded_container p-0 m-0">
                        <t t-if="isSaleOrderLinesLoading(record)">
                            <div class="text-muted small px-3 py-2 border-bottom">
                                <i class="fa fa-circle-o-notch fa-spin me-2"/>Memuat detail item...
                            </div>
                        </t>
                        <t t-elif="!getSaleOrderLines(record).length">
                            <div class="text-muted small px-3 py-2 fst-italic border-bottom">
                                Tidak ada item (Order Lines kosong).
                            </div>
                        </t>
                        <t t-else="">
                            <div class="table-responsive p-0 m-0">
                                <table class="o_list_table table table-sm table-hover mb-0 o_so_line_subtable align-middle w-100">
                                    <tbody>
                                        <tr class="o_so_line_subheader">
                                            <td class="fw-semibold">Product</td>
                                            <td class="fw-semibold">Description</td>
                                            <td class="fw-semibold">Analytic / Unit</td>
                                            <td class="fw-semibold">Estimated Delivery</td>
                                            <td class="fw-semibold">Actual Delivery</td>
                                            <td class="fw-semibold">Trigger Invoice Print</td>
                                            <td class="fw-semibold">Last Invoice</td>
                                            <td class="fw-semibold text-end">Utilized Months</td>
                                            <td class="fw-semibold text-end">Remaining Months</td>
                                            <td class="fw-semibold text-end">Quantity</td>
                                            <td class="fw-semibold text-end">Delivered</td>
                                            <td class="fw-semibold text-end">Returned</td>
                                            <td class="fw-semibold text-end">Returned ET</td>
                                            <td class="fw-semibold text-end">Invoiced</td>
                                            <td class="fw-semibold text-end">Unit Price/Month</td>
                                            <td class="fw-semibold">Taxes</td>
                                            <td class="fw-semibold text-end">Amount</td>
                                        </tr>
                                        <t t-foreach="getSaleOrderLines(record)" t-as="line" t-key="line.id">
                                            <tr t-if="line.display_type" class="o_so_line_section_row">
                                                <td colspan="17" class="fw-bold fst-italic text-muted">
                                                    <span t-esc="line.name"/>
                                                </td>
                                            </tr>
                                            <tr t-else="" class="o_data_row o_so_line_data_row">
                                                <td class="o_data_cell" t-esc="line.product_name"/>
                                                <td class="o_data_cell" t-esc="line.name"/>
                                                <td class="o_data_cell" t-esc="line.analytic_display"/>
                                                <td class="o_data_cell text-nowrap" t-esc="line.estimated_delivery_date"/>
                                                <td class="o_data_cell text-nowrap" t-esc="line.actual_delivery_date"/>
                                                <td class="o_data_cell text-nowrap" t-esc="line.trigger_invoice_print"/>
                                                <td class="o_data_cell text-nowrap" t-esc="line.last_invoice_date"/>
                                                <td class="o_data_cell text-end" t-esc="line.utilized_months"/>
                                                <td class="o_data_cell text-end" t-esc="line.remaining_months"/>
                                                <td class="o_data_cell text-end" t-esc="line.product_uom_qty"/>
                                                <td class="o_data_cell text-end" t-esc="line.qty_delivered"/>
                                                <td class="o_data_cell text-end" t-esc="line.qty_returned"/>
                                                <td class="o_data_cell text-end" t-esc="line.qty_returned_et"/>
                                                <td class="o_data_cell text-end" t-esc="line.qty_invoiced"/>
                                                <td class="o_data_cell text-end text-nowrap" t-esc="line.price_unit"/>
                                                <td class="o_data_cell" t-esc="line.taxes"/>
                                                <td class="o_data_cell text-end fw-semibold text-nowrap" t-esc="line.price_subtotal"/>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </t>
                    </div>
                </td>
            </tr>
        </xpath>

    </t>

</templates>
