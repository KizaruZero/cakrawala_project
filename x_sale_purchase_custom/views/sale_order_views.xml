<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_form_inherit_rental_purchase" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.rental.purchase</field>
        <field name="model">sale.order</field>
        <field name="priority">99</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id'][@widget='res_partner_many2one']" position="after">
                <field name="attention_up" readonly="state in ['sale', 'done', 'cancel']"/>
                <field name="order_type_id" options="{'no_create': True}" invisible="is_rental_order"/>
                <field name="periodic" invisible="is_rental_order"/>

                <!-- Rental Invoicing Parameters (Left Column, immediately below Attention/UP for Rental Orders) -->
                <field name="invoicing_cycle_period" invisible="not is_rental_order" readonly="state in ['sale', 'done', 'cancel']"/>
                <field name="billing_period" invisible="1"/>
                <field name="billing_settings_changed" invisible="1"/>
                <field name="billing_engine_regenerated" invisible="1"/>
                <field name="invoicing_date_monthly"
                       invisible="not is_rental_order or grouping_invoice == 'delivered_date'"
                       readonly="state in ['done', 'cancel'] or billing_settings_changed or billing_engine_regenerated"/>
                <field name="weekend_rule_adjustment" invisible="not is_rental_order" readonly="state in ['sale', 'done', 'cancel']"/>
                <field name="top_billing" invisible="not is_rental_order" readonly="state in ['done', 'cancel'] or billing_settings_changed or billing_engine_regenerated"/>
                <field name="billing_rule" invisible="not is_rental_order" readonly="state in ['sale', 'done', 'cancel']"/>
                <field name="grouping_invoice" invisible="not is_rental_order" readonly="state in ['done', 'cancel'] or billing_settings_changed or billing_engine_regenerated"/>
                <field name="invoice_print_lead_time" invisible="not is_rental_order" readonly="state in ['sale', 'done', 'cancel']"/>
            </xpath>

            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="rpc_price_locked" invisible="1"/>
                <field name="rpc_document_id" invisible="1"/>
                <field name="rpc_document_ids" invisible="1"/>
                <field name="rental_type_id" options="{'no_create': True}" invisible="not is_rental_order" readonly="state in ['sale', 'done', 'cancel']"/>
                <field name="location_id" options="{'no_create': True}" invisible="not is_rental_order" readonly="state in ['sale', 'done', 'cancel']"/>
                <field name="estimated_delivery_date_header" invisible="1"/>
                <field name="is_early_termination_requested" invisible="1"/>
                <field name="rental_type_id_is_related_pr" related="rental_type_id.is_related_pr" invisible="1"/>
                <field name="rental_type_id_is_related_po" related="rental_type_id.is_related_po" invisible="1"/>
                <field name="po_related_ids" invisible="1"/>
                <field name="active" invisible="1"/>
            </xpath>

            <!-- Hide standard invoice button for rental orders -->
            <xpath expr="//button[@name='action_view_invoice']" position="attributes">
                <attribute name="invisible">invoice_count == 0 or is_rental_order</attribute>
            </xpath>

            <!-- Smart Button: Rental Draft & Confirmed Invoices -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_billing_engine"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-calendar"
                        invisible="not is_rental_order">
                    <field name="billing_engine_count" widget="statinfo" string="Billing Engine"/>
                </button>
                <button name="action_view_rental_draft_invoices"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-pencil-square-o"
                        invisible="not is_rental_order">
                    <field name="rental_draft_invoice_count" widget="statinfo" string="Draft Invoices"/>
                </button>
                <button name="action_view_rental_confirmed_invoices"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-file-text-o"
                        invisible="not is_rental_order">
                    <field name="rental_confirmed_invoice_count" widget="statinfo" string="Invoices"/>
                </button>
            </xpath>
            
            <xpath expr="//header" position="inside">
                <button name="action_generate_billing_engine" string="Generate Billing Engine"
                        type="object" class="btn-primary"
                        invisible="not is_rental_order or state != 'sale' or billing_engine_regenerated"
                        confirm="This will replace only Billing Engine rows without an invoice. Existing invoices and their billing rows will be preserved. This action can only be used once, and billing settings will then be locked. Continue?"/>
                <button name="action_create_pr" string="Submit PR" type="object" class="oe_highlight" invisible="state not in ('sent', 'sale') or not rental_type_id_is_related_pr"/>
                <button name="action_create_po" string="Create PO" type="object" class="oe_highlight" invisible="state not in ('sent', 'sale') or not rental_type_id_is_related_po or po_related_ids"/>
                <button name="action_request_early_termination" string="Request ET" type="object" class="btn-secondary" invisible="state != 'sale' or not is_rental_order or is_early_termination_requested"/>
                <button name="action_approve_early_termination" string="Approve ET" type="object" class="btn-primary" groups="x_sale_purchase_custom.group_et_director" invisible="not is_early_termination_requested or et_is_approved" confirm="Apakah Anda yakin ingin menyetujui Early Termination dan membuat Invoice Penalti?"/>
                
                <field name="show_return_button" invisible="1"/>
                <button name="action_return_from_ro" string="Return" type="object" class="btn-primary" invisible="not show_return_button"/>
            </xpath>

            <xpath expr="//sheet" position="before">
                <div class="alert alert-warning" role="alert"
                     invisible="not is_rental_order or not billing_settings_changed or billing_engine_regenerated">
                    Billing settings have been changed once and are now locked. Click
                    <strong>Generate Billing Engine</strong> to replace uninvoiced billing rows.
                    Invoice generation will skip this order until regeneration is complete.
                </div>
            </xpath>

            <!-- Hide Pick up and standard Return from sale_renting -->
            <xpath expr="//header/button[@name='action_open_pickup']" position="attributes" if_exists="1">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//header/button[@name='action_open_return']" position="attributes" if_exists="1">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Order Line: Add rental tracking columns -->
            <xpath expr="//field[@name='order_line']//list//field[@name='product_uom_qty']" position="before">
                <field name="estimated_delivery_date" optional="show" string="Estimated Delivery"/>
                <field name="actual_delivery_date" optional="show" string="Actual Delivery"/>
                <field name="trigger_invoice_print" optional="show" string="Trigger Invoice Print"/>
                <field name="last_invoice_date" optional="show" string="Last Invoice"/>
                <field name="utilized_months" optional="show" string="Utilized Months"/>
                <field name="remaining_months" optional="show" string="Remaining Months"/>
            </xpath>

            <!-- Force qty_returned to be visible even if not standard is_rental -->
            <xpath expr="//field[@name='order_line']//list//field[@name='qty_returned']" position="attributes" if_exists="1">
                <attribute name="invisible">0</attribute>
            </xpath>

            <!-- Rename Unit Price column to Unit Price/Month -->
            <xpath expr="//field[@name='order_line']//list//field[@name='price_unit']" position="attributes">
                <attribute name="string">Unit Price/Month</attribute>
                <attribute name="readonly">parent.rpc_price_locked</attribute>
            </xpath>

            <!-- Tab: Input Order -->
            <xpath expr="//page[@name='order_lines']" position="before">
                <page string="Input Order" name="input_order" invisible="not is_rental_order">
                    <div class="mb-3 d-flex gap-2">
                        <button name="action_generate_order_lines" type="object" string="Generate Order" class="btn-primary" icon="fa-cogs"/>
                        <button name="action_reset_order_lines" type="object" string="Reset Order" class="btn-secondary" icon="fa-undo" confirm="Apakah Anda yakin ingin menghapus seluruh daftar Order Lines dan mengulangi proses generate dari Input Order? Tindakan ini tidak dapat dibatalkan." invisible="state not in ('draft', 'sent')"/>
                    </div>
                    <field name="input_line_ids" mode="list">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="product_id"/>
                            <field name="name"/>
                            <field name="quantity"/>
                            <field name="generated_qty"/>
                            <field name="price_unit" string="Unit Price/Month"
                                   readonly="parent.rpc_price_locked"/>
                            <field name="harga_otr" string="Harga OTR"/>
                            <field name="estimated_delivery_date"/>
                            <field name="tax_ids" widget="many2many_tags"/>
                        </list>
                    </field>
                </page>
            </xpath>

            <!-- Tab: Request Early Termination & Contract Agreement -->
            <xpath expr="//page[@name='other_information']" position="before">
                <page string="Request Early Termination" name="early_termination" invisible="not is_early_termination_requested or not is_rental_order">
                    <div class="mb-3 d-flex gap-2" invisible="et_is_approved">
                        <button name="action_approve_early_termination"
                                type="object"
                                string="Approve ET"
                                class="btn-primary"
                                groups="x_sale_purchase_custom.group_et_director"
                                invisible="et_is_approved"
                                confirm="Apakah Anda yakin ingin menyetujui Early Termination dan membuat Invoice Penalti?"/>
                    </div>
                    <group>
                        <group string="Early Termination Details">
                            <field name="et_is_approved" invisible="1"/>
                            <field name="et_termination_date" readonly="et_is_approved"/>
                            <field name="et_penalty_amount" readonly="et_is_approved"/>
                            <field name="et_reason" readonly="et_is_approved"/>
                            <field name="et_notes" readonly="et_is_approved"/>
                        </group>
                        <group string="Approval &amp; Penalty Invoice" invisible="not et_is_approved">
                            <field name="et_approved_by"/>
                            <field name="et_approval_date"/>
                            <field name="et_invoice_id" widget="many2one"/>
                        </group>
                    </group>
                </page>
                <page string="Contract &amp; Agreement" name="contract_agreement" invisible="not is_rental_order">
                    <div class="mb-3 d-flex gap-2">
                        <button name="action_create_contract" type="object" string="Create Contract" class="btn-primary" icon="fa-file-text-o"/>
                    </div>
                    <group>
                        <group>
                            <field name="notify_contract_expiration"/>
                        </group>
                    </group>
                    <separator string="Contract Document"/>
                    <field name="contract_filename" invisible="1"/>
                    <field name="contract_file" filename="contract_filename" widget="binary" readonly="1" string="Generated Contract"/>
                </page>
            </xpath>

            <xpath expr="//page[@name='other_information']" position="inside">
                <group name="signoff_details" string="Signoff Details">
                    <field name="signoff_name"/>
                    <field name="signoff_position"/>
                </group>
                <group name="related_documents" string="Related Documents">
                    <field name="pr_related_html" readonly="1"/>
                    <field name="po_related_html" readonly="1"/>
                    <field name="rpc_related_html" readonly="1"/>
                </group>
            </xpath>

            <xpath expr="//field[@name='tax_totals']" position="after">
                <table class="table table-sm table-borderless mb-0" style="width: 100%;" invisible="not is_rental_order">
                    <tbody>
                        <tr class="oe_subtotal_footer_separator">
                            <td class="pb-0"><strong>Total Keseluruhan</strong></td>
                            <td class="text-end pb-0 text-nowrap">
                                <field name="x_total_keseluruhan" nolabel="1" widget="monetary" options="{'currency_field': 'currency_id'}" class="fw-bold"/>
                            </td>
                        </tr>
                    </tbody>
                </table>
                <field name="x_total_keseluruhan" invisible="is_rental_order" widget="monetary" options="{'currency_field': 'currency_id'}"/>
            </xpath>
        </field>
    </record>

    <!-- Hide searchpanel in Rental Order search view -->
    <record id="rental_order_view_search_inherit_hide_panel" model="ir.ui.view">
        <field name="name">rental.order.search.inherit.hide.panel</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_renting.rental_order_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//searchpanel/field[@name='rental_status']" position="replace">
            </xpath>
        </field>
    </record>

    <!-- Isolate Rental Orders from standard Sales Quotations / Orders views (Option B) -->
    <record id="sale.action_quotations_with_onboarding" model="ir.actions.act_window">
        <field name="domain">['|', ('is_rental_order', '=', False), ('is_rpc_related', '=', False)]</field>
    </record>

    <record id="sale.action_orders" model="ir.actions.act_window">
        <field name="domain">[('state', 'not in', ('draft', 'sent', 'cancel')), '|', ('is_rental_order', '=', False), ('is_rpc_related', '=', False)]</field>
    </record>

    <record id="sale_renting.rental_order_action" model="ir.actions.act_window">
        <field name="domain">[('is_rental_order', '=', True), ('is_rpc_related', '=', True)]</field>
    </record>

    <record id="sale_order_form_inherit_rental_dates" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.rental.dates</field>
        <field name="model">sale.order</field>
        <field name="priority">99</field>
        <field name="inherit_id" ref="sale_renting.rental_order_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='rental_start_date']" position="attributes">
                <attribute name="string">Estimate Rental Period</attribute>
                <attribute name="options">{'end_date_field': 'rental_return_date', 'show_time': False}</attribute>
            </xpath>
            <!-- Hide default duration_days from sale_renting to prevent duplication -->
            <xpath expr="//label[@for='duration_days']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='duration_days']/parent::div" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <!-- Place Total Months and custom Duration immediately after Rental period in Right Column -->
            <xpath expr="//field[@name='rental_start_date']" position="after">
                <label for="actual_rental_start_date"
                       string="Actual Rental Period"
                       invisible="not is_rental_order"/>
                <div class="o_row"
                     invisible="not is_rental_order">
                    <span class="text-nowrap">From</span>
                    <field name="actual_rental_start_date"
                           class="oe_inline"
                           nolabel="1"
                           options="{'show_time': False}"/>
                    <span class="text-nowrap mx-2">To</span>
                    <field name="actual_rental_return_date"
                           class="oe_inline"
                           nolabel="1"
                           readonly="1"
                           options="{'show_time': False}"/>
                </div>
                <field name="masa_sewa_bulan" string="Total Months" readonly="1" force_save="1"/>
                <field name="duration" readonly="1" force_save="1"/>
                <field name="return_status" readonly="1"/>
            </xpath>
            <xpath expr="//field[@name='client_order_ref']" position="attributes">
                <attribute name="string">Cust. Reference (No. PO)</attribute>
            </xpath>
            <xpath expr="//field[@name='client_order_ref']" position="after">
                <field name="customer_po_date" string="Tanggal PO Cust."/>
            </xpath>
        </field>
    </record>

    <record id="sale_order_form_archived_ribbon" model="ir.ui.view">
        <field name="name">sale.order.form.archived.ribbon</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
            </xpath>
        </field>
    </record>

    <record id="view_sales_order_filter_inherit_rental" model="ir.ui.view">
        <field name="name">sale.order.search.inherit.rental</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
            </xpath>
        </field>
    </record>

    <record id="rental_order_view_tree_inherit_return_status" model="ir.ui.view">
        <field name="name">rental.order.list.inherit.return.status</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_renting.rental_order_view_tree"/>
        <field name="priority">25</field>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="default_order">date_order desc, id desc</attribute>
            </xpath>
            <xpath expr="//field[@name='amount_total']" position="after">
                <field name="nopol_search"
                       string="No. Polisi"
                       optional="show"/>
                <field name="return_status"
                       string="Return"
                       optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="rental_order_view_search_inherit_custom" model="ir.ui.view">
        <field name="name">rental.order.search.inherit.custom</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_renting.rental_order_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="filter_domain">['|', '|', '|', ('name', 'ilike', self), ('client_order_ref', 'ilike', self), ('partner_id', 'child_of', self), ('nopol_search', 'ilike', self)]</attribute>
            </xpath>
            <xpath expr="//field[@name='name']" position="after">
                <field name="nopol_search" string="No. Polisi / Nopol"/>
            </xpath>
            <xpath expr="//search" position="inside">
                <separator/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
                <separator/>
                <filter string="Not Returned" name="not_returned" domain="[('return_status', '=', 'not_returned')]"/>
                <filter string="Partially Returned" name="partial_returned" domain="[('return_status', '=', 'partial')]"/>
                <filter string="Fully Returned" name="fully_returned" domain="[('return_status', '=', 'fully_returned')]"/>
            </xpath>
            <xpath expr="//group" position="inside">
                <filter string="Return Status" name="groupby_return_status" context="{'group_by': 'return_status'}"/>
            </xpath>
        </field>
    </record>
</odoo>
