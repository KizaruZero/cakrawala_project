<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_so_line_item_list" model="ir.ui.view">
        <field name="name">sale.order.line.so.line.item.list</field>
        <field name="model">sale.order.line</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <list string="SO Line Item" create="0" edit="0" delete="0" import="0" action="action_open_order" type="object">
                <field name="order_id" string="Order"/>
                <field name="order_partner_id"/>
                <field name="state" widget="badge"/>
                <field name="product_id"/>
                <field name="name" string="Description"/>
                <field name="analytic_account_id" string="Analytic / Unit"/>
                <field name="product_uom_qty" string="Quantity"/>
                <field name="qty_delivered"/>
                <field name="qty_invoiced"/>
                <field name="price_unit" string="Unit Price"/>
                <field name="tax_ids" widget="many2many_tags"/>
                <field name="price_subtotal" string="Amount" sum="Total" widget="monetary"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_ro_line_item_list" model="ir.ui.view">
        <field name="name">sale.order.line.ro.line.item.list</field>
        <field name="model">sale.order.line</field>
        <field name="inherit_id" ref="view_so_line_item_list"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="string">RO Line Item</attribute>
            </xpath>
            <xpath expr="//field[@name='analytic_account_id']" position="after">
                <field name="estimated_delivery_date"/>
                <field name="actual_delivery_date"/>
                <field name="trigger_invoice_print"/>
                <field name="last_invoice_date"/>
                <field name="utilized_months"/>
                <field name="remaining_months"/>
            </xpath>
            <xpath expr="//field[@name='qty_delivered']" position="after">
                <field name="qty_returned"/>
                <field name="qty_returned_et"/>
                <field name="bastk_return_date"/>
            </xpath>
            <xpath expr="//field[@name='price_unit']" position="attributes">
                <attribute name="string">Unit Price/Month</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_line_item_search" model="ir.ui.view">
        <field name="name">sale.order.line.line.item.search</field>
        <field name="model">sale.order.line</field>
        <field name="inherit_id" ref="sale.view_sales_order_line_filter"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='product']" position="before">
                <filter string="Customer" name="customer" context="{'group_by': 'order_partner_id'}"/>
                <filter string="Status" name="status" context="{'group_by': 'state'}"/>
            </xpath>
        </field>
    </record>

    <record id="action_so_line_item" model="ir.actions.act_window">
        <field name="name">SO Line Item</field>
        <field name="res_model">sale.order.line</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_so_line_item_list"/>
        <field name="search_view_id" ref="view_line_item_search"/>
        <field name="domain">[('display_type', '=', False), ('is_downpayment', '=', False), ('order_id.is_rental_order', '=', False)]</field>
    </record>

    <record id="action_ro_line_item" model="ir.actions.act_window">
        <field name="name">RO Line Item</field>
        <field name="res_model">sale.order.line</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_ro_line_item_list"/>
        <field name="search_view_id" ref="view_line_item_search"/>
        <field name="domain">[('display_type', '=', False), ('is_downpayment', '=', False), ('order_id.is_rental_order', '=', True)]</field>
    </record>

    <menuitem id="menu_so_line_item"
              name="SO Line Item"
              parent="sale.sale_order_menu"
              action="action_so_line_item"
              groups="sales_team.group_sale_salesman"
              sequence="21"/>

    <menuitem id="menu_ro_line_item"
              name="RO Line Item"
              parent="sale_renting.rental_order_menu"
              action="action_ro_line_item"
              sequence="2"/>
</odoo>
