<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_rental_deferred_revenue" model="ir.ui.view">
        <field name="name">sale.order.rental.deferred.revenue</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="can_create_rental_deferred" invisible="1"/>
                <button name="action_create_rental_deferred_revenue" type="object" string="Create Deferred Revenue"
                        groups="account.group_account_manager" class="btn-secondary"
                        invisible="not can_create_rental_deferred"
                        confirm="Create draft deferred revenue for delivered Rental Order lines that do not already have one? Original Value covers the full rental term; no recognition entries are posted until validation."/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_rental_deferred_revenue" type="object" class="oe_stat_button" icon="fa-calendar"
                        groups="account.group_account_user,account.group_account_manager" invisible="not rental_deferred_count">
                    <field name="rental_deferred_count" widget="statinfo" string="Deferred Revenue"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='order_line']//list//field[@name='product_uom_qty']" position="before">
                <field name="rental_deferred_state" widget="badge" optional="show" readonly="1"
                       column_invisible="not parent.is_rental_order or parent.top_billing != 'dibelakang'"/>
            </xpath>
        </field>
    </record>
    <record id="account_deferred_entry_rental_source" model="ir.ui.view">
        <field name="name">account.deferred.entry.rental.source</field>
        <field name="model">account.deferred.entry</field>
        <field name="inherit_id" ref="x_account_deferred_expense_revenue.view_account_deferred_entry_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[field[@name='source_move_line_ids']]/group" position="inside">
                <field name="rental_order_id" invisible="not rental_sale_line_id"/>
                <field name="rental_sale_line_id" invisible="not rental_sale_line_id"/>
                <field name="rental_analytic_account_id" invisible="not rental_sale_line_id"/>
                <field name="rental_unit_plate_no" invisible="not rental_sale_line_id"/>
            </xpath>
        </field>
    </record>
    <record id="account_deferred_entry_rental_list" model="ir.ui.view">
        <field name="name">account.deferred.entry.rental.list</field>
        <field name="model">account.deferred.entry</field>
        <field name="inherit_id" ref="x_account_deferred_expense_revenue.view_account_deferred_entry_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="rental_order_id" optional="show" column_invisible="context.get('default_deferred_type') != 'revenue'"/>
                <field name="rental_unit_plate_no" optional="show" column_invisible="context.get('default_deferred_type') != 'revenue'"/>
            </xpath>
        </field>
    </record>
    <record id="res_config_settings_rental_deferred" model="ir.ui.view">
        <field name="name">res.config.settings.rental.deferred</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="x_sale_purchase_custom.res_config_settings_rental_stamp_duty"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='rental_invoice_settings']" position="inside">
                <setting string="Rental Deferred Revenue Model" company_dependent="1"
                         help="Monthly Deferred Revenue model for TOP Dibelakang. Duration follows the Rental Order Total Months. If empty, a unique active Pendapatan Diterima Di Muka model in this company is used.">
                    <field name="rental_deferred_revenue_model_id"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
