<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_rental_type_view_form" model="ir.ui.view">
        <field name="name">sale.rental.type.form</field>
        <field name="model">sale.rental.type</field>
        <field name="arch" type="xml">
            <form string="Rental Type">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g. Type A"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="is_related_pr"/>
                            <field name="is_related_po"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sale_rental_type_view_tree" model="ir.ui.view">
        <field name="name">sale.rental.type.tree</field>
        <field name="model">sale.rental.type</field>
        <field name="arch" type="xml">
            <list string="Rental Types">
                <field name="name"/>
                <field name="is_related_pr"/>
                <field name="is_related_po"/>
            </list>
        </field>
    </record>

    <record id="action_sale_rental_type" model="ir.actions.act_window">
        <field name="name">Rental Types</field>
        <field name="res_model">sale.rental.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_sale_rental_type" 
              name="Rental Types" 
              parent="sale.menu_sale_config" 
              action="action_sale_rental_type" 
              sequence="100"/>
</odoo>
