<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_inherit_rental" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.rental</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='purchase_delivery_invoice']" position="inside">
                <group>
                    <group string="Sales Order Information">
                        <field name="sale_order_id"/>
                        <field name="customer_so_related"/>
                        <field name="rental_type_id" options="{'no_open': True}"/>
                        <field name="rpc"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
