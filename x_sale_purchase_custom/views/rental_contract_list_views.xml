<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rental_contract_list" model="ir.ui.view">
        <field name="name">sale.order.rental.contract.list</field>
        <field name="model">sale.order</field>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <list string="Contract List" create="0" default_order="contract_end_date asc, id desc">
                <field name="name" string="Nomor Rental Order" decoration-bf="1"/>
                <field name="contract_number" string="Nomor Kontrak"/>
                <field name="partner_id" string="Customer" optional="show"/>
                <field name="contract_start_date" string="Contract Start Date"/>
                <field name="contract_end_date" string="Contract End Date"/>
                <field name="user_id" string="Salesperson" widget="many2one_avatar_user"/>
                <field name="notify_contract_expiration" string="Notify Contract Expiration"/>
                <field name="contract_notification_status"
                       string="Notification Status"
                       widget="badge"
                       decoration-muted="contract_notification_status == 'no_schedule'"
                       decoration-info="contract_notification_status == 'scheduled'"
                       decoration-success="contract_notification_status == 'notified'"
                       decoration-danger="contract_notification_status == 'expired'"/>
                <field name="contract_expiration_notified_date" string="Notified On" optional="hide"/>
                <field name="state" string="Order Status" widget="badge" optional="hide"
                       decoration-info="state in ('draft', 'sent')"
                       decoration-success="state in ('sale', 'done')"
                       decoration-muted="state == 'cancel'"/>
            </list>
        </field>
    </record>

    <record id="view_rental_contract_search" model="ir.ui.view">
        <field name="name">sale.order.rental.contract.search</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <search string="Search Contracts">
                <field name="name" string="Rental Order / Contract"
                       filter_domain="['|', '|', ('name', 'ilike', self), ('contract_number', 'ilike', self), ('partner_id', 'child_of', self)]"/>
                <field name="contract_number" string="Nomor Kontrak"/>
                <field name="partner_id" string="Customer" operator="child_of"/>
                <field name="user_id" string="Salesperson"/>
                <filter string="Active Rental Orders" name="filter_active_rental"
                        domain="[('state', 'in', ('sale', 'done'))]"/>
                <filter string="My Contracts" name="filter_my_contracts"
                        domain="[('user_id', '=', uid)]"/>
                <separator/>
                <filter string="Has Contract" name="filter_has_contract"
                        domain="['|', ('contract_number', '!=', False), ('contract_end_date', '!=', False)]"/>
                <filter string="Missing Contract" name="filter_missing_contract"
                        domain="[('contract_number', '=', False), ('contract_end_date', '=', False)]"/>
                <separator/>
                <filter string="Expiring Within 30 Days" name="filter_expiring_soon"
                        domain="[('contract_end_date', '&gt;=', context_today().strftime('%Y-%m-%d')), ('contract_end_date', '&lt;=', (context_today() + relativedelta(days=30)).strftime('%Y-%m-%d'))]"/>
                <filter string="Notified" name="filter_notified"
                        domain="[('is_contract_expiration_notified', '=', True)]"/>
                <filter string="Expired" name="filter_expired"
                        domain="[('contract_end_date', '!=', False), ('contract_end_date', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter string="Contract End Date" name="filter_contract_end_date" date="contract_end_date"/>
                <group>
                    <filter string="Salesperson" name="groupby_salesperson" context="{'group_by': 'user_id'}"/>
                    <filter string="Customer" name="groupby_customer" context="{'group_by': 'partner_id'}"/>
                    <filter string="Notify Contract Expiration" name="groupby_notify_expiration" context="{'group_by': 'notify_contract_expiration'}"/>
                    <filter string="Notification Status" name="groupby_notification_status" context="{'group_by': 'contract_notification_status'}"/>
                    <filter string="Contract End Date" name="groupby_contract_end_date" context="{'group_by': 'contract_end_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_rental_contract_list" model="ir.actions.act_window">
        <field name="name">Contract List</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_rental_order', '=', True)]</field>
        <field name="search_view_id" ref="view_rental_contract_search"/>
        <field name="context">{
            'in_rental_app': 1,
            'default_is_rental_order': True,
            'search_default_filter_active_rental': 1,
            'create': False,
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Belum ada data kontrak Rental Order yang ditampilkan.
            </p>
            <p>
                Daftar ini memonitor Nomor Kontrak, Periode Kontrak (Start &amp; End Date), Salesperson, serta status pengiriman Email Reminder Kontrak Berakhir.
            </p>
        </field>
    </record>

    <record id="action_rental_contract_list_view_tree" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_rental_contract_list"/>
        <field name="act_window_id" ref="action_rental_contract_list"/>
    </record>

    <record id="action_rental_contract_list_view_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="sale_renting.rental_order_primary_form_view"/>
        <field name="act_window_id" ref="action_rental_contract_list"/>
    </record>

    <menuitem id="menu_rental_contract_list"
              name="Contract List"
              parent="sale_renting.rental_order_menu"
              action="action_rental_contract_list"
              sequence="2"/>
</odoo>

