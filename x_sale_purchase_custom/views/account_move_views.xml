<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit Invoice Form to add Plate Number and Billing Month columns -->
    <record id="view_move_form_inherit_rental_invoice" model="ir.ui.view">
        <field name="name">account.move.form.inherit.rental.invoice</field>
        <field name="model">account.move</field>
        <field name="priority">99</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']//list//field[@name='account_id']" position="before">
                <field name="x_plate_number" optional="show" string="Plate Number/Asset Number"/>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']//list//field[@name='account_id']" position="after">
                <field name="x_billing_month" optional="show" string="Billing Month"/>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
            </xpath>
            <xpath expr="//form" position="inside">
                <field name="active" invisible="1"/>
            </xpath>
        </field>
    </record>

    <!-- Draft Rental Invoices: Centralized "Big View" list -->
    <record id="action_rental_draft_invoices" model="ir.actions.act_window">
        <field name="name">Draft Rental Invoices</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('move_type', '=', 'out_invoice'), ('state', '=', 'draft'), ('x_is_rental_invoice', '=', True)]</field>
        <field name="context">{'default_move_type': 'out_invoice', 'search_default_group_by_partner': 1}</field>
    </record>

    <record id="view_account_invoice_filter_inherit_rental" model="ir.ui.view">
        <field name="name">account.move.search.inherit.rental</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_move_filter_inherit_rental" model="ir.ui.view">
        <field name="name">account.move.journal.search.inherit.rental</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_move_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
            </xpath>
        </field>
    </record>

    <!-- Menu entry under Rental menu -->
    <menuitem id="menu_rental_draft_invoices"
              name="Draft Rental Invoices"
              parent="sale_renting.rental_menu_root"
              action="action_rental_draft_invoices"
              sequence="30"/>
</odoo>
