<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_form_inherit_internal_transfer" model="ir.ui.view">
        <field name="name">account.payment.form.inherit.internal.transfer</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_type']" position="attributes">
                <attribute name="invisible">1</attribute>
                <attribute name="force_save">1</attribute>
            </xpath>
            <xpath expr="//field[@name='payment_type']" position="after">
                <field name="is_internal_transfer_custom" invisible="1" force_save="1"/>
                <field name="payment_type_ui"
                       string="Payment Type"
                       widget="radio"
                       options="{'horizontal': True}"
                       readonly="state != 'draft'"/>
                <field name="internal_transfer_direction"
                       string="Transfer Direction"
                       widget="radio"
                       options="{'horizontal': True}"
                       invisible="not is_internal_transfer_custom"
                       required="is_internal_transfer_custom"
                       readonly="state != 'draft'"/>
                <field name="custom_destination_account_id"
                       string="Destination Account"
                       options="{'no_create': True}"
                       invisible="not is_internal_transfer_custom"
                       required="is_internal_transfer_custom"
                       readonly="state != 'draft'"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_payment_tree_inherit_internal_transfer" model="ir.ui.view">
        <field name="name">account.payment.list.inherit.internal.transfer</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="custom_destination_account_id" string="Destination Account" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_payment_search_inherit_internal_transfer" model="ir.ui.view">
        <field name="name">account.payment.search.inherit.internal.transfer</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='outbound_filter']" position="after">
                <filter string="Internal Transfers"
                        name="internal_transfer_filter"
                        domain="[('is_internal_transfer_custom', '=', True)]"/>
            </xpath>
        </field>
    </record>
</odoo>

