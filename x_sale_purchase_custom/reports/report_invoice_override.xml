<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Paperformat for Invoices to reduce top whitespace natively -->
    <record id="paperformat_invoice_custom" model="report.paperformat">
        <field name="name">Invoice Custom (Smaller Top Margin)</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">25</field> <!-- Reduced from default 40 to 25 -->
        <field name="margin_bottom">20</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">20</field>
        <field name="dpi">90</field>
    </record>

    <!-- A separate action: never rebind the native invoice report actions. -->
    <record id="action_report_invoice_custom" model="ir.actions.report">
        <field name="name">Custom Print Out</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">x_sale_purchase_custom.report_invoice_custom</field>
        <field name="report_file">x_sale_purchase_custom.report_invoice_custom</field>
        <field name="is_invoice_report" eval="True"/>
        <field name="print_report_name">'Custom - ' + object._get_report_base_filename()</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
        <field name="domain" eval="[('move_type', 'in', ('out_invoice', 'out_refund'))]"/>
        <field name="attachment" eval="False"/>
        <field name="attachment_use" eval="False"/>
        <field name="group_ids" eval="[(6, 0, [ref('account.group_account_invoice'), ref('account.group_account_readonly')])]"/>
        <field name="paperformat_id" ref="x_sale_purchase_custom.paperformat_invoice_custom"/>
    </record>

    <template id="report_invoice_custom">
        <t t-set="customer_invoice_batch" t-value="docs and not docs.filtered(lambda move: move.move_type not in ('out_invoice', 'out_refund'))"/>
        <t t-set="data_report_margin_top" t-value="8 if customer_invoice_batch else None"/>
        <t t-set="data_report_header_spacing" t-value="1 if customer_invoice_batch else None"/>
        <t t-set="print_with_payments" t-value="True"/>
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="lang" t-value="o.partner_id.lang"/>
                <t t-if="o.move_type in ('out_invoice', 'out_refund')"
                   t-call="x_sale_purchase_custom.report_invoice_document_signoff" t-lang="lang"/>
                <t t-else="" t-call="{{ o._get_name_invoice_report() }}" t-lang="lang"/>
            </t>
        </t>
    </template>

    <!-- Customer invoices use an in-flow header: no oversized external-header
         margin, no company administrative address, and no overlap on page 1. -->
    <template id="external_layout_customer_invoice">
        <t t-set="company" t-value="o.company_id"/>
        <div t-attf-class="article o_cakrawala_invoice o_company_#{company.id}_layout"
             t-att-data-oe-model="o._name" t-att-data-oe-id="o.id"
             t-att-data-oe-lang="o.env.context.get('lang')">
            <style>
                .o_cakrawala_invoice { font-size: 10pt; line-height: 1.3; color: #202020; }
                .o_cakrawala_invoice, .o_cakrawala_invoice * { font-family: Arial, sans-serif !important; }
                body.o_body_pdf { overflow: visible !important; }
                .o_cakrawala_invoice .invoice_main { overflow: visible !important; }
                .o_cakrawala_invoice .invoice_header { width: 100%; table-layout: fixed; border-collapse: collapse; margin-bottom: 5mm; }
                .o_cakrawala_invoice .invoice_header,
                .o_cakrawala_invoice .invoice_header tbody,
                .o_cakrawala_invoice .invoice_header tr,
                .o_cakrawala_invoice .invoice_header td { border: 0 !important; outline: 0 !important; box-shadow: none !important; background: transparent !important; }
                .o_cakrawala_invoice .invoice_header::before { content: none !important; display: none !important; }
                .o_cakrawala_invoice .invoice_header td { border: 0 !important; vertical-align: top; padding: 0; }
                .o_cakrawala_invoice .invoice_logo { width: 62mm; max-height: 30mm; object-fit: contain; object-position: left top; }
                .o_cakrawala_invoice .seller_name { text-align: right; font-size: 9pt; padding-bottom: 5mm !important; }
                .o_cakrawala_invoice .customer_address { font-size: 9pt; line-height: 1.3; }
                .o_cakrawala_invoice .customer_address p { margin: 0; }
                .o_cakrawala_invoice h2 { font-size: 19pt; color: #a44319; margin: 0 0 4mm; }
                .o_cakrawala_invoice #informations { font-size: 9pt; margin-bottom: 5mm !important; }
                .o_cakrawala_invoice .o_main_table { font-size: 9pt; width: 100%; }
                .o_cakrawala_invoice .o_main_table th { font-weight: normal; text-transform: uppercase; }
                .o_cakrawala_invoice .o_main_table th, .o_cakrawala_invoice .o_main_table td { border: 0.3pt solid #777 !important; padding: 2mm; vertical-align: top; }
                .o_cakrawala_invoice .o_main_table thead { display: table-header-group !important; }
                .o_cakrawala_invoice .o_main_table tr { page-break-inside: avoid; }
                .o_cakrawala_invoice .o_main_table [name='th_description'] { width: 48%; }
                /* Collapsed cell borders can extend beyond the floated column
                   and get clipped by the native overflow-hidden wrapper. Draw
                   one inset table frame and single internal grid lines. */
                .o_cakrawala_invoice .o_total_table { font-size: 9pt; width: 100%; table-layout: fixed; box-sizing: border-box; border-collapse: separate !important; border-spacing: 0; border: 1px solid #777 !important; }
                .o_cakrawala_invoice .o_total_table td { border: 1px solid #777 !important; padding: 2mm !important; vertical-align: top; }
                .o_cakrawala_invoice .o_total_table tr td { box-sizing: border-box; border-top: 0 !important; border-left: 0 !important; }
                .o_cakrawala_invoice .o_total_table td:first-child { width: 45%; }
                .o_cakrawala_invoice .o_total_table td:last-child { width: 55%; white-space: nowrap; border-right: 0 !important; }
                .o_cakrawala_invoice .o_total_table tr:last-child td { border-bottom: 0 !important; }
                .o_cakrawala_invoice #right-elements { width: 38% !important; box-sizing: border-box; padding-right: 1pt !important; margin-top: 3mm !important; margin-left: 4% !important; }
                .o_cakrawala_invoice #right-elements #total { display: block; margin: 0 !important; }
                .o_cakrawala_invoice #right-elements #total > div { padding: 0 !important; }
                .o_cakrawala_invoice .invoice_words { border: 0.3pt solid #777 !important; border-top: 0 !important; padding: 2mm; font-size: 9pt; page-break-inside: avoid; }
                .o_cakrawala_invoice .invoice_payment { width: 58%; max-width: 58%; display: inline-block; vertical-align: top; font-size: 8.5pt; padding-top: 3mm; overflow-wrap: break-word; word-wrap: break-word; }
                .o_cakrawala_invoice .invoice_payment * { max-width: 100% !important; white-space: normal !important; }
                .o_cakrawala_invoice .invoice_payment table { width: 100% !important; table-layout: fixed; }
                .o_cakrawala_invoice .invoice_payment ul { padding-left: 4mm; margin-top: 2mm; }
                .o_cakrawala_invoice .invoice_payment li { margin-bottom: 2mm; }
                .o_cakrawala_invoice .invoice_unit_list { clear: both; width: 58%; max-width: 58%; padding-top: 4mm; font-size: 9pt; overflow-wrap: break-word; word-wrap: break-word; }
                .o_cakrawala_invoice .invoice_unit_list h4 { font-size: 10pt; margin: 0 0 2mm; page-break-after: avoid; }
                .o_cakrawala_invoice .invoice_unit_list .unit_group_description { white-space: pre-line; margin: 0 0 1mm; page-break-after: avoid; }
                .o_cakrawala_invoice .invoice_unit_list ol { padding-left: 6mm; margin: 0 0 3mm; }
                .o_cakrawala_invoice .invoice_unit_list li { padding-bottom: 1mm; page-break-inside: avoid; }
                .o_cakrawala_invoice .invoice_signature { clear: both; width: 38%; margin-left: 62%; padding-top: 12mm; text-align: center; page-break-inside: avoid; font-size: 10pt; }
                .o_cakrawala_invoice .signature_space { height: 32mm; }
                .o_cakrawala_invoice .rental_detail_heading { font-size: 12pt; margin: 0 0 2mm; color: #202020; }
                /* Preserve the former two-line header footprint: shifting a long
                   table up can split/repeat a boundary row in wkhtmltopdf. */
                .o_cakrawala_invoice .rental_detail_reference { font-size: 9pt; min-height: 2.6em; margin: 0 0 4mm; }
                .o_cakrawala_invoice .rental_invoice_appendix { clear: both; page-break-before: always; padding-top: 2mm; }
                .o_cakrawala_invoice .o_rental_invoice_detail { width: 100%; table-layout: fixed; border-collapse: separate !important; border-spacing: 0; border: 1px solid #777 !important; box-sizing: border-box; font-size: 7.5pt; }
                .o_cakrawala_invoice .o_rental_invoice_detail th,
                .o_cakrawala_invoice .o_rental_invoice_detail td { border: 0 !important; border-right: 1px solid #777 !important; border-bottom: 1px solid #777 !important; padding: 1.5mm 1mm; vertical-align: top; overflow-wrap: break-word; word-wrap: break-word; }
                .o_cakrawala_invoice .o_rental_invoice_detail th:last-child,
                .o_cakrawala_invoice .o_rental_invoice_detail td:last-child { border-right: 0 !important; }
                .o_cakrawala_invoice .o_rental_invoice_detail tfoot tr:last-child td { border-bottom: 0 !important; }
                .o_cakrawala_invoice .o_rental_invoice_detail thead { display: table-header-group !important; }
                .o_cakrawala_invoice .o_rental_invoice_detail tfoot { display: table-row-group !important; font-weight: bold; }
                .o_cakrawala_invoice .o_rental_invoice_detail tr { page-break-inside: avoid; }
                .o_cakrawala_invoice .o_rental_invoice_detail .detail_amount { text-align: right; white-space: nowrap; }
                .o_cakrawala_invoice .o_rental_invoice_detail .detail_period { font-size: 7pt; }
                .o_cakrawala_invoice .o_rental_invoice_detail .detail_notes { white-space: pre-line; font-size: 7pt; }
                .o_cakrawala_invoice .detail_formula { font-size: 7.5pt; margin-top: 2mm; }
            </style>
            <table class="invoice_header">
                <tr>
                    <td rowspan="2" style="width: 53%;">
                        <img t-if="company.logo" t-att-src="image_data_uri(company._rental_report_logo())" class="invoice_logo" alt="Company Logo"/>
                    </td>
                    <td class="seller_name"><span t-field="company.name"/></td>
                </tr>
                <tr><td class="customer_address"><t t-out="address"/></td></tr>
            </table>
            <h2 t-out="layout_document_title"/>
            <t t-out="0"/>
        </div>
    </template>

    <template id="rental_invoice_detail_table">
        <table class="o_rental_invoice_detail o_ignore_layout_styling" name="rental_invoice_detail_table">
            <colgroup>
                <col style="width: 3%;"/><col style="width: 10%;"/>
                <col t-att-style="'width: 19%;' if rental_invoice_details['show_other_tax'] else 'width: 23%;'"/>
                <col style="width: 16%;"/><col style="width: 7%;"/>
                <col style="width: 12%;"/>
                <col t-att-style="'width: 8%;' if rental_invoice_details['show_other_tax'] else 'width: 9%;'"/>
                <col t-att-style="'width: 8%;' if rental_invoice_details['show_other_tax'] else 'width: 9%;'"/>
                <col t-if="rental_invoice_details['show_other_tax']" style="width: 6%;"/>
                <col style="width: 11%;"/>
            </colgroup>
            <thead><tr>
                <th>No.</th><th>No Polisi</th><th>Tipe / Product</th><th>Periode Sewa</th>
                <th>Bulan Ke</th><th class="text-end">Harga Sewa</th>
                <th class="text-end">PPN</th><th class="text-end">PPh</th>
                <th t-if="rental_invoice_details['show_other_tax']" class="text-end">Pajak Lain</th>
                <th class="text-end">Total</th>
            </tr></thead>
            <tbody>
                <t t-foreach="rental_invoice_details['unit_rows']" t-as="detail">
                    <tr t-if="detail['display_type'] != 'product'" class="rental_detail_note">
                        <td t-att-colspan="10 if rental_invoice_details['show_other_tax'] else 9">
                            <span t-out="detail['description']" class="detail_notes"/>
                        </td>
                    </tr>
                    <tr t-else="" t-att-class="'rental_detail_fee' if detail['is_fee'] else 'rental_detail_row'">
                        <td class="detail_number"><span t-out="detail['number']"/></td>
                        <td class="detail_plate"><span t-out="', '.join(detail['plates'])"/></td>
                        <td class="detail_product"><span t-out="detail['description']"/>
                            <div t-if="detail['notes']" t-out="detail['notes']" class="detail_notes"/>
                            <div t-if="detail['quantity'] != 1" class="detail_notes">Qty: <span t-out="detail['quantity']" t-options="{'widget': 'float', 'decimal_precision': 'Product Unit'}"/></div>
                        </td>
                        <td class="detail_period"><span t-out="detail['period']"/></td>
                        <td class="detail_billing_month"><span t-out="detail['billing_month']"/></td>
                        <td class="detail_amount detail_rent"><span t-out="detail['subtotal']" t-options="{'widget': 'float', 'precision': o.currency_id.decimal_places}"/></td>
                        <td class="detail_amount detail_ppn"><span t-out="detail['ppn']" t-options="{'widget': 'float', 'precision': o.currency_id.decimal_places}"/></td>
                        <td class="detail_amount detail_pph"><span t-out="detail['pph']" t-options="{'widget': 'float', 'precision': o.currency_id.decimal_places}"/></td>
                        <td t-if="rental_invoice_details['show_other_tax']" class="detail_amount detail_other_tax"><span t-out="detail['other_tax']" t-options="{'widget': 'float', 'precision': o.currency_id.decimal_places}"/></td>
                        <td class="detail_amount detail_total"><span t-out="detail['total']" t-options="{'widget': 'float', 'precision': o.currency_id.decimal_places}"/></td>
                    </tr>
                </t>
            </tbody>
            <tfoot><tr class="rental_detail_totals">
                <td colspan="5" class="text-end">Total (<span t-out="o.currency_id.name"/>)</td>
                <td class="detail_amount"><span t-out="rental_invoice_details['unit_totals']['subtotal']" t-options="{'widget': 'float', 'precision': o.currency_id.decimal_places}"/></td>
                <td class="detail_amount"><span t-out="rental_invoice_details['unit_totals']['ppn']" t-options="{'widget': 'float', 'precision': o.currency_id.decimal_places}"/></td>
                <td class="detail_amount"><span t-out="rental_invoice_details['unit_totals']['pph']" t-options="{'widget': 'float', 'precision': o.currency_id.decimal_places}"/></td>
                <td t-if="rental_invoice_details['show_other_tax']" class="detail_amount"><span t-out="rental_invoice_details['unit_totals']['other_tax']" t-options="{'widget': 'float', 'precision': o.currency_id.decimal_places}"/></td>
                <td class="detail_amount"><span t-out="rental_invoice_details['unit_totals']['total']" t-options="{'widget': 'float', 'precision': o.currency_id.decimal_places}"/></td>
            </tr></tfoot>
        </table>
        <div class="detail_formula">PPN dan PPh dalam nominal <span t-out="o.currency_id.name"/>. PPh positif merupakan potongan. Total rincian unit = Harga Sewa + PPN - PPh<span t-if="rental_invoice_details['show_other_tax']"> + Pajak Lain</span>. Tagihan di luar unit sewa hanya tercakup dalam ringkasan Total invoice.</div>
    </template>

    <template id="customer_invoice_tax_totals">
        <tr class="o_subtotal">
            <td>DPP</td>
            <td class="text-end"><span t-out="o._customer_invoice_print_dpp()"
                t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td>
        </tr>
        <t t-foreach="o.tax_totals.get('subtotals', [])" t-as="subtotal">
            <tr t-foreach="subtotal['tax_groups']" t-as="tax_group" class="o_taxes">
                <td><span t-out="tax_group['group_name']"/></td>
                <td class="text-end"><span t-out="tax_group['tax_amount_currency']"
                    t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td>
            </tr>
        </t>
        <tr t-foreach="o._customer_invoice_print_fees()" t-as="fee"
            t-att-name="'stamp_duty_total' if fee.x_is_stamp_duty else 'other_fee_total'">
            <td><span t-out="'Biaya Materai' if fee.x_is_stamp_duty else fee.name"/></td>
            <td class="text-end"><span t-out="fee.price_subtotal"
                t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td>
        </tr>
        <tr t-if="o.tax_totals.get('cash_rounding_base_amount_currency')">
            <td>Pembulatan</td>
            <td class="text-end"><span t-out="o.tax_totals['cash_rounding_base_amount_currency']"
                t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td>
        </tr>
        <tr class="o_total"><td><strong>Total</strong></td>
            <td class="text-end"><strong t-field="o.amount_total"/></td>
        </tr>
    </template>

    <!-- Private primary variants retain the old XML IDs for upgrades, without
         applying their inheritance to any standard Odoo report. -->
    <template id="external_layout_select_customer_invoice" inherit_id="web.external_layout" primary="True">
        <xpath expr="//t[@t-if='company.external_report_layout_id']" position="attributes">
            <attribute name="t-call">{{ 'x_sale_purchase_custom.external_layout_customer_invoice' if cakrawala_customer_invoice else company.external_report_layout_id.sudo().key }}</attribute>
        </xpath>
        <xpath expr="//t[@t-call='web.external_layout_standard']" position="attributes">
            <attribute name="t-call">{{ 'x_sale_purchase_custom.external_layout_customer_invoice' if cakrawala_customer_invoice else 'web.external_layout_standard' }}</attribute>
        </xpath>
    </template>

    <template id="report_invoice_document_signoff" inherit_id="account.report_invoice_document" primary="True">
        <xpath expr="//t[@t-call='web.external_layout']" position="attributes">
            <attribute name="t-call">x_sale_purchase_custom.external_layout_select_customer_invoice</attribute>
        </xpath>
        <xpath expr="//t[@t-set='o']" position="after">
            <t t-set="cakrawala_customer_invoice" t-value="o.move_type in ('out_invoice', 'out_refund')"/>
            <t t-set="rental_invoice_details" t-value="o._rental_invoice_print_details() if cakrawala_customer_invoice else False"/>
        </xpath>
        <xpath expr="//div[@name='origin']" position="attributes">
            <attribute name="t-if">o.invoice_origin and o.move_type not in ('out_invoice', 'out_refund')</attribute>
        </xpath>
        <xpath expr="//div[@name='reference']" position="attributes">
            <attribute name="t-if">o.ref and o.move_type not in ('out_invoice', 'out_refund')</attribute>
        </xpath>
        <xpath expr="//div[@name='delivery_date']" position="after">
            <div class="col" name="customer_payment_terms" t-if="o.move_type in ('out_invoice', 'out_refund') and o.invoice_payment_term_id">
                <strong>Payment Terms</strong><div t-field="o.invoice_payment_term_id.name"/>
            </div>
        </xpath>
        <xpath expr="//div[@name='invoice_date']/div" position="replace">
            <div t-if="cakrawala_customer_invoice" t-out="o._customer_invoice_print_date(o.invoice_date)"/>
            <div t-else="" t-field="o.invoice_date"/>
        </xpath>
        <xpath expr="//div[@name='due_date']/div" position="replace">
            <div t-if="cakrawala_customer_invoice" t-out="o._customer_invoice_print_date(o.invoice_date_due)"/>
            <div t-else="" t-field="o.invoice_date_due"/>
        </xpath>
        <xpath expr="//div[@name='delivery_date']/div" position="replace">
            <div t-if="cakrawala_customer_invoice" t-out="o._customer_invoice_print_date(o.delivery_date)"/>
            <div t-else="" t-field="o.delivery_date"/>
        </xpath>
        <xpath expr="//div[@name='taxable_supply_date']/div" position="replace">
            <div t-if="cakrawala_customer_invoice" t-out="o._customer_invoice_print_date(o.taxable_supply_date)"/>
            <div t-else="" t-field="o.taxable_supply_date"/>
        </xpath>
        <xpath expr="//t[@t-out=&quot;payment_vals['date']&quot;]" position="replace">
            <t t-if="cakrawala_customer_invoice" t-out="o._customer_invoice_print_date(payment_vals['date'])"/>
            <t t-else="" t-out="payment_vals['date']" t-options="{'widget': 'date'}"/>
        </xpath>
        <xpath expr="//t[@t-set='display_taxes']" position="attributes">
            <attribute name="t-value">o.move_type not in ('out_invoice', 'out_refund') and any(l.tax_ids for l in o.invoice_line_ids)</attribute>
        </xpath>
        <xpath expr="//t[@t-set='lines_to_report']" position="before">
            <t t-set="customer_print_groups" t-value="o._customer_invoice_print_groups(o._get_move_lines_to_report()) if cakrawala_customer_invoice else {}"/>
            <t t-set="unit_list_groups" t-value="[group for group in customer_print_groups.values() if group.get('show_unit_list')] if not rental_invoice_details else []"/>
        </xpath>
        <xpath expr="//t[@t-set='lines_to_report']" position="attributes">
            <attribute name="t-value">o._get_move_lines_to_report().filtered(lambda item: not item.x_is_stamp_duty and (item.display_type != 'product' or item.id in customer_print_groups or item.collapse_prices or item.collapse_composition)) if cakrawala_customer_invoice else o._get_move_lines_to_report()</attribute>
        </xpath>
        <xpath expr="//t[@t-set='is_note']" position="before">
            <t t-set="customer_print_group" t-value="customer_print_groups.get(line.id)"/>
        </xpath>
        <xpath expr="//td[@name='account_invoice_line_name']/span" position="replace">
            <span t-if="cakrawala_customer_invoice" style="white-space: pre-line;" dir="auto"><t t-if="customer_print_group and customer_print_group['unit_codes'] and not customer_print_group['show_unit_list'] and not rental_invoice_details"><span class="invoice_product_description" t-out="customer_print_group['description_head']"/><br/><t t-foreach="customer_print_group['unit_codes']" t-as="unit_code"><span class="invoice_analytic_code text-nowrap" t-out="unit_code"/><t t-if="not unit_code_last">, </t></t><t t-if="customer_print_group['description_tail']"><br/><span class="invoice_description_tail" t-out="customer_print_group['description_tail']"/></t></t><t t-else="" t-out="customer_print_group['base_description'] if customer_print_group and rental_invoice_details else customer_print_group['description'] if customer_print_group else line._rental_invoice_print_description()"/></span>
            <span t-else="" t-field="line.name" t-options="{'widget': 'text'}" dir="auto"/>
        </xpath>
        <xpath expr="//td[@name='td_quantity']/span[@t-field='line.quantity']" position="replace">
            <span t-if="customer_print_group" t-out="customer_print_group['quantity']" t-options="{'widget': 'float', 'decimal_precision': 'Product Unit'}" class="text-nowrap"/>
            <span t-else="" t-field="line.quantity" class="text-nowrap"/>
        </xpath>
        <xpath expr="//td[@name='td_price_unit']/span" position="replace">
            <span t-if="customer_print_group and not hide_prices" t-out="customer_print_group['price_unit']" t-options="{'widget': 'float', 'decimal_precision': 'Product Price'}" class="text-nowrap"/>
            <span t-elif="not hide_prices" t-field="line.price_unit" class="text-nowrap"/>
        </xpath>
        <xpath expr="//td[@name='td_discount']/span" position="replace">
            <span t-if="customer_print_group" t-out="customer_print_group['discount']" t-options="{'widget': 'float', 'precision': 2}" class="text-nowrap"/>
            <span t-else="" t-field="line.discount" class="text-nowrap"/>
        </xpath>
        <xpath expr="//td[@name='td_subtotal']" position="inside">
            <span t-if="customer_print_group and not hide_prices" t-out="customer_print_group['price_total' if o.company_price_include == 'tax_included' else 'price_subtotal']" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}" class="text-nowrap"/>
        </xpath>
        <xpath expr="//td[@name='td_subtotal']/span[@t-field='line.price_subtotal']" position="attributes">
            <attribute name="t-if">not customer_print_group and not hide_prices and o.company_price_include == 'tax_excluded'</attribute>
        </xpath>
        <xpath expr="//td[@name='td_subtotal']/span[@t-field='line.price_total']" position="attributes">
            <attribute name="t-if">not customer_print_group and not hide_prices and o.company_price_include == 'tax_included'</attribute>
        </xpath>
        <xpath expr="//td[@name='td_quantity']/span[@t-field='line.product_uom_id']" position="attributes">
            <attribute name="t-if">o.move_type not in ('out_invoice', 'out_refund')</attribute>
        </xpath>
        <xpath expr="//td[@name='td_quantity']/span[hasclass('text-muted')]" position="attributes">
            <attribute name="t-if">line.product_uom_id != line.product_id.uom_id and o.move_type not in ('out_invoice', 'out_refund')</attribute>
        </xpath>
        <xpath expr="//td[@name='td_quantity_grouped']/div[@t-if='hide_details']/span[@groups]" position="attributes">
            <attribute name="t-if">o.move_type not in ('out_invoice', 'out_refund')</attribute>
        </xpath>
        <xpath expr="//td[@name='td_quantity_grouped']//t[@t-if]" position="attributes">
            <attribute name="t-if">grouped_line.get('line_uom') and o.move_type not in ('out_invoice', 'out_refund')</attribute>
        </xpath>
        <xpath expr="//t[@t-call='account.document_tax_totals']" position="attributes">
            <attribute name="t-call">{{ 'x_sale_purchase_custom.customer_invoice_tax_totals' if o.move_type in ('out_invoice', 'out_refund') else 'account.document_tax_totals' }}</attribute>
        </xpath>
        <xpath expr="//div[@id='total']//table[hasclass('o_total_table')]" position="attributes">
            <attribute name="t-attf-class">o_total_table table table-borderless avoid-page-break-inside #{'o_ignore_layout_styling' if cakrawala_customer_invoice else ''}</attribute>
        </xpath>
        <xpath expr="//table[@name='invoice_line_table']" position="attributes">
            <attribute name="t-if">not rental_invoice_details or not rental_invoice_details['single_unit']</attribute>
        </xpath>
        <xpath expr="//table[@name='invoice_line_table']" position="before">
            <t t-if="rental_invoice_details and rental_invoice_details['single_unit']" t-call="x_sale_purchase_custom.rental_invoice_detail_table"/>
        </xpath>
        <xpath expr="//table[@name='invoice_line_table']" position="after">
            <div class="invoice_words" t-if="o.move_type in ('out_invoice', 'out_refund')">
                <strong>Terbilang: </strong><span t-out="o._invoice_amount_words_indonesian()"/>
            </div>
        </xpath>
        <xpath expr="//p[@t-if='o.company_id.display_invoice_amount_total_words']" position="attributes">
            <attribute name="t-if">o.company_id.display_invoice_amount_total_words and o.move_type not in ('out_invoice', 'out_refund')</attribute>
        </xpath>
        <xpath expr="//div[@id='payment_term']" position="attributes">
            <attribute name="t-if">o.move_type not in ('out_invoice', 'out_refund')</attribute>
        </xpath>
        <xpath expr="//div[hasclass('overflow-hidden')]" position="attributes">
            <attribute name="t-att-style">'page-break-inside: avoid;' if o.move_type in ('out_invoice', 'out_refund') else None</attribute>
        </xpath>
        <xpath expr="//div[@id='payment_term']" position="after">
            <div t-if="o.move_type in ('out_invoice', 'out_refund')" class="invoice_payment">
                <p>Pembayaran ke: <strong t-field="o.company_id.name"/><br/>
                    BCA Cabang Pluit Landmark - No. Rekening: <strong>1685656789</strong>
                </p>
                <div name="customer_invoice_terms">
                    <!-- The invoice is the source of truth, including legacy
                         posted documents. Never replace or truncate its terms. -->
                    <div t-if="not is_html_empty(o.narration)" t-field="o.narration"/>
                    <t t-else="">
                        <strong>Terms and Conditions:</strong>
                        <ul>
                            <li>Pembayaran dianggap sah apabila telah diterima di rekening PT. Cakrawala Rentalindo Sejahtera</li>
                            <li>Silahkan melakukan konfirmasi pembayaran melalui email <span>finance@cakrawalarentalindo.com</span></li>
                            <li>Apabila terdapat kesalahan pada invoice yang sudah diterima kami tidak bisa membatalkan invoice tersebut dan hanya bisa merevisi untuk periode berikutnya.</li>
                            <li>PPH 23 dipotong dengan tarif 2% dari nilai invoice (tidak termasuk PPN), bukti pemotongan PPH 23 agar dikirim melalui email finance@cakrawalarentalindo.com.</li>
                        </ul>
                    </t>
                </div>
            </div>
            <div class="invoice_signature" t-if="cakrawala_customer_invoice and not unit_list_groups">
                <div>Hormat Kami,</div>
                <div class="signature_space"/>
                <div><strong>Alvina Jeriwati</strong></div>
                <div>General Manager</div>
            </div>
        </xpath>
        <!-- Keep potentially long unit lists outside the totals/terms block,
             so they can paginate without clipping or splitting the totals. -->
        <xpath expr="//div[hasclass('overflow-hidden')]" position="after">
            <div t-if="unit_list_groups" class="invoice_unit_list" name="invoice_unit_list">
                <h4>List Nopol</h4>
                <t t-foreach="unit_list_groups" t-as="unit_group">
                    <p class="unit_group_description"><strong t-out="unit_group['base_description']"/></p>
                    <ol>
                        <li t-foreach="unit_group['unit_codes']" t-as="unit_code"><span t-out="unit_code"/></li>
                    </ol>
                </t>
            </div>
            <div class="invoice_signature" t-if="unit_list_groups">
                <div>Hormat Kami,</div>
                <div class="signature_space"/>
                <div><strong>Alvina Jeriwati</strong></div>
                <div>General Manager</div>
            </div>
        </xpath>
        <!-- Replace the payment communication text to only show bank account -->
        <xpath expr="//p[@name='payment_communication']" position="replace">
            <p name="payment_communication">
                <t t-if="o.partner_bank_id">
                    <span t-field="o.partner_bank_id" class="fw-bold"/>
                </t>
            </p>
        </xpath>

        <!-- Append signoff block at the end of the page -->
        <xpath expr="//div[hasclass('page')]" position="inside">
            <div class="row mt-5" t-if="o.move_type not in ('out_invoice', 'out_refund') and (o.signoff_name or o.signoff_position)" style="page-break-inside: avoid;">
                <div class="col-4 offset-8 text-center">
                    <p class="mb-5"><strong>Hormat Kami,</strong></p>
                    <br/><br/>
                    <p class="mb-0"><strong t-field="o.signoff_name"/></p>
                    <p class="mb-0" t-field="o.signoff_position"/>
                </div>
            </div>
            <div t-if="rental_invoice_details and not rental_invoice_details['single_unit']"
                 class="rental_invoice_appendix" name="rental_invoice_appendix">
                <h3 class="rental_detail_heading">LAMPIRAN RINCIAN INVOICE</h3>
                <p class="rental_detail_reference"><strong t-out="o.name if o.name and o.name != '/' else 'Draft Invoice'"/>
                    <span t-if="o.invoice_origin"> - <span t-out="o.invoice_origin"/></span>
                </p>
                <t t-call="x_sale_purchase_custom.rental_invoice_detail_table"/>
            </div>
        </xpath>
    </template>

    <!-- Legacy entry point is now private as well; native margins are untouched. -->
    <template id="report_invoice_compact_margins" inherit_id="account.report_invoice" primary="True">
        <xpath expr="//t[@t-call='web.html_container']" position="before">
            <t t-set="customer_invoice_batch" t-value="docs and not docs.filtered(lambda move: move.move_type not in ('out_invoice', 'out_refund'))"/>
            <t t-set="data_report_margin_top" t-value="8 if customer_invoice_batch else None"/>
            <t t-set="data_report_header_spacing" t-value="1 if customer_invoice_batch else None"/>
        </xpath>
    </template>
</odoo>
