<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_sale_order_compact" model="report.paperformat">
        <field name="name">Quotation / Order Compact</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <!-- Keep enough room for the company logo/address without leaving the
             large gap produced by Odoo's default sale-order paper format. -->
        <field name="margin_top">26</field>
        <field name="margin_bottom">15</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">2</field>
        <field name="dpi">90</field>
    </record>

    <record id="sale.action_report_saleorder" model="ir.actions.report">
        <field name="paperformat_id"
               ref="x_sale_purchase_custom.paperformat_sale_order_compact"/>
    </record>

    <!-- sale_pdf_quote_builder exposes a second print action named
         "Quotation / Order".  Bind it to the same paper format so both print
         options render the identical A4 header geometry. -->
    <record id="sale_pdf_quote_builder.action_report_saleorder_raw"
            model="ir.actions.report">
        <field name="paperformat_id"
               ref="x_sale_purchase_custom.paperformat_sale_order_compact"/>
    </record>

    <template id="report_saleorder_document_input_order"
              inherit_id="sale.report_saleorder_document">
        <xpath expr="//div[hasclass('page')]" position="inside">
            <style>
                .o_report_layout_boxed.o_snail_mail .address.row,
                .o_report_layout_standard.o_snail_mail .address.row {
                    margin-top: 0 !important;
                    margin-bottom: 0.25rem !important;
                    padding-top: 0 !important;
                }
                .o_report_layout_boxed h2,
                .o_report_layout_standard h2 {
                    margin-top: 0 !important;
                    margin-bottom: 0.4rem !important;
                }
                .o_cakrawala_input_order_table {
                    margin-top: 0.25rem !important;
                    margin-bottom: 0.5rem !important;
                    font-size: 0.92em;
                }
                .o_cakrawala_input_order_table th,
                .o_cakrawala_input_order_table td {
                    padding-top: 0.28rem !important;
                    padding-bottom: 0.28rem !important;
                }
                .o_cakrawala_input_order_total {
                    width: 100%;
                    border-collapse: collapse;
                    table-layout: fixed;
                    margin-top: -1px;
                    margin-bottom: 0.75rem;
                }
                .o_cakrawala_input_order_total td {
                    border: 1px solid #1f2d3d;
                    padding: 0.32rem 0.45rem;
                }
                .o_cakrawala_input_order_total .o_total {
                    background-color: #c45100;
                    color: #fff;
                    font-weight: 700;
                }
                .o_cakrawala_rental_info {
                    width: 100%;
                    border-collapse: collapse;
                    table-layout: fixed;
                    margin: 0 0 0.45rem 0;
                    border: 0 !important;
                }
                .o_cakrawala_rental_info td {
                    width: 33.333%;
                    vertical-align: top;
                    padding: 0 0.6rem 0.3rem 0;
                    border: 0 !important;
                }
                .o_cakrawala_rental_info strong {
                    color: #0056b3;
                    display: block;
                    white-space: nowrap;
                }
            </style>
        </xpath>

        <xpath expr="//div[@id='informations']" position="attributes">
            <attribute name="class">row mb-2</attribute>
            <attribute name="t-if">not doc.is_rental_order</attribute>
        </xpath>

        <xpath expr="//div[@id='informations']" position="before">
            <div t-if="doc.is_rental_order"
                 id="rental_informations"
                 name="rental_informations">
                <table class="table table-borderless o_ignore_layout_styling o_cakrawala_rental_info">
                    <tbody>
                        <tr>
                            <td>
                                <strong t-if="doc.state in ['draft', 'sent']">Quotation Date</strong>
                                <strong t-else="">Order Date</strong>
                                <div t-field="doc.date_order"
                                     t-options="{'widget': 'date'}"/>
                            </td>
                            <td>
                                <strong>Expiration</strong>
                                <div>
                                    <span t-field="doc.validity_date"
                                          t-if="doc.validity_date and doc.state in ['draft', 'sent']"/>
                                    <span t-else="">-</span>
                                </div>
                            </td>
                            <td>
                                <strong>Salesperson</strong>
                                <div>
                                    <span t-field="doc.user_id" t-if="doc.user_id"/>
                                    <span t-else="">-</span>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <strong>Attention / UP</strong>
                                <div t-out="doc.attention_up or '-'"/>
                            </td>
                            <td>
                                <strong>Location</strong>
                                <div>
                                    <span t-field="doc.location_id" t-if="doc.location_id"/>
                                    <span t-else="">-</span>
                                </div>
                            </td>
                            <td>
                                <strong>Estimate Rental Period</strong>
                                <div>
                                    <span t-field="doc.rental_start_date"
                                          t-options="{'widget': 'date'}"
                                          t-if="doc.rental_start_date"/>
                                    <span t-else="">-</span>
                                    <t t-if="doc.rental_return_date">
                                        <span> - </span>
                                        <span t-field="doc.rental_return_date"
                                              t-options="{'widget': 'date'}"/>
                                    </t>
                                </div>
                            </td>
                        </tr>
                        <tr t-if="doc.client_order_ref or doc.customer_po_date">
                            <td>
                                <strong>Cust. Reference (No. PO)</strong>
                                <div t-out="doc.client_order_ref or '-'"/>
                            </td>
                            <td>
                                <strong>Tanggal PO Cust.</strong>
                                <div>
                                    <span t-field="doc.customer_po_date"
                                          t-if="doc.customer_po_date"/>
                                    <span t-else="">-</span>
                                </div>
                            </td>
                            <td/>
                        </tr>
                    </tbody>
                </table>
            </div>
        </xpath>

        <xpath expr="//table[@class='o_has_total_table table o_main_table table-borderless']"
               position="before">
            <t t-if="doc.is_rental_order and doc.input_line_ids">
                <t t-set="input_display_taxes"
                   t-value="any(line.tax_ids for line in doc.input_line_ids)"/>
                <table class="o_has_total_table table o_main_table table-borderless o_cakrawala_input_order_table">
                    <thead style="display: table-row-group">
                        <tr>
                            <th class="text-start">Description</th>
                            <th class="text-end text-nowrap">Quantity</th>
                            <th class="text-end text-nowrap">Unit Price</th>
                            <th t-if="input_display_taxes" class="text-end">Taxes</th>
                            <th class="text-end">Amount</th>
                        </tr>
                    </thead>
                    <tbody class="sale_tbody">
                        <tr t-foreach="doc.input_line_ids.sorted(lambda line: (line.sequence, line.id))"
                            t-as="line">
                            <td class="text-start">
                                <span t-field="line.name"/>
                            </td>
                            <td class="text-end text-nowrap">
                                <span t-field="line.quantity"
                                      t-options="{'widget': 'float', 'decimal_precision': 'Product Unit'}"/>
                                <span t-field="line.product_id.uom_id"/>
                            </td>
                            <td class="text-end text-nowrap">
                                <span t-field="line.price_unit"
                                      t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                            </td>
                            <t t-set="taxes"
                               t-value="', '.join(tax.tax_label for tax in line.tax_ids if tax.tax_label)"/>
                            <td t-if="input_display_taxes"
                                t-attf-class="text-end {{ 'text-nowrap' if len(taxes) &lt; 10 else '' }}">
                                <span t-out="taxes"/>
                            </td>
                            <td class="text-end text-nowrap">
                                <span t-field="line.price_subtotal"
                                      t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </t>
        </xpath>

        <xpath expr="//table[@class='o_has_total_table table o_main_table table-borderless']"
               position="attributes">
            <attribute name="t-if">not (doc.is_rental_order and doc.input_line_ids)</attribute>
        </xpath>

        <xpath expr="//div[@name='so_total_summary']" position="before">
            <div t-if="doc.is_rental_order and doc.input_line_ids"
                 class="clearfix"
                 name="input_order_total_summary">
                <t t-set="input_totals" t-value="doc.input_order_tax_totals"/>
                <div class="row">
                    <div style="width: 50%; margin-left: auto;">
                        <table class="o_cakrawala_input_order_total">
                            <colgroup>
                                <col style="width: 67%;"/>
                                <col style="width: 33%;"/>
                            </colgroup>
                            <t t-foreach="input_totals['subtotals']" t-as="subtotal">
                                <tr t-if="subtotal['tax_groups']">
                                    <td>
                                        <span t-out="subtotal['name']"/>
                                    </td>
                                    <td class="text-end text-nowrap">
                                        <span t-out="subtotal['base_amount_currency']"
                                              t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                    </td>
                                </tr>
                                <tr t-foreach="subtotal['tax_groups']" t-as="tax_group">
                                    <td>
                                        <span t-out="tax_group['group_name']"/>
                                    </td>
                                    <td class="text-end text-nowrap">
                                        <span t-out="tax_group['tax_amount_currency']"
                                              t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                    </td>
                                </tr>
                            </t>
                            <tr t-if="'cash_rounding_base_amount_currency' in input_totals">
                                <td>Rounding</td>
                                <td class="text-end text-nowrap">
                                    <span t-out="input_totals['cash_rounding_base_amount_currency']"
                                          t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                </td>
                            </tr>
                            <tr class="o_total">
                                <td>Total</td>
                                <td class="text-end text-nowrap">
                                    <span t-out="input_totals['total_amount_currency']"
                                          t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>
        </xpath>

        <xpath expr="//div[@name='so_total_summary']" position="attributes">
            <attribute name="t-if">not (doc.is_rental_order and doc.input_line_ids)</attribute>
        </xpath>
    </template>
</odoo>
